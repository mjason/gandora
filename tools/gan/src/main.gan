defmodule Main do
  @moduledoc """
  gan — the Gandora task runner (GEP-0013), written in Gandora.
  Native commands drive gandora-core in-process; unknown subcommands
  delegate to gan-<name> plugins, then to the stage-0 compiler ganc.
  """

  pyimport gandora_core, as: core
  pyimport subprocess
  pyimport shutil
  pyimport pathlib
  pyimport sys
  pyimport os

  @usage """
  gan - the Gandora task runner

  Usage:
    gan build [--strict]    the verdict + compile: diagnostics, advice,
                            artifact verification; errors stop artifacts
                            (--strict adds type-flow warnings via ty)
    gan run <file> [args...] | exec <code> | repl
    gan fmt [--check] [path...] | version
    gan init [--package] <path>   scaffold a project (or fill an existing one)
    gan test                doctests + tests/*.gan (GEP-0024)
    gan agent [--json]      the AI-session briefing: working loop +
                            context pack in one output (GEP-0026)
    gan <plugin> ...        delegates to gan-<plugin>, then to ganc
  """

  @doc "The task-runner entry: one command per invocation (GEP-0013)."
  @spec main() :: nil
  def main() do
    args = $builtins.list(sys.argv) |> Enum.drop(1)
    case args do
      [] ->
        IO.puts(@usage)
        sys.exit(2)
      ["version" | _] -> version()
      ["build" | rest] -> build(Enum.member?(rest, "--strict"))
      ["check" | rest] ->
        IO.puts("note: `gan check` merged into `gan build` (GEP-0025 rev 3)")
        build(Enum.member?(rest, "--strict"))
      ["run", file | rest] -> run(file, rest)
      ["run"] -> die_usage("run requires a file")
      ["exec", code | _] -> exec_code(code)
      ["exec"] -> die_usage("exec requires code")
      ["repl" | _] -> repl()
      ["agent" | rest] -> Agent.run(rest)
      ["fmt" | rest] -> Fmt.run(rest)
      ["init" | rest] -> init_cmd(rest)
      [cmd | rest] -> delegate(cmd, rest)
    end
  end

  defp die_usage(msg) do
    IO.puts("gan: " <> msg)
    IO.puts(@usage)
    sys.exit(2)
  end

  defp root(), do: os.getcwd()

  # "execute with the project Python" (GEP-0013-R002): the venv
  # interpreter when the project has one, else the runner's own
  defp project_python() do
    venv = root() <> "/.venv/bin/python"
    if os.path.exists(venv) do
      venv
    else
      sys.executable
    end
  end

  @doc "Runner and compiler-library versions."
  @spec version() :: nil
  def version() do
    IO.puts("gan #{runner_version()} (runner) / gandora-core #{core.version()}")
    if runner_version() != core.version() do
      IO.puts("warning: runner and gandora-core versions differ (GEP-0012-R007)")
    end
  end

  defp runner_version(), do: $importlib.metadata.version("gandora-tool")

  @doc """
  The verdict and the artifacts in one command (GEP-0025 rev 3):
  diagnostics, Advisor suggestions, and artifact verification; any
  error stops before artifacts are written.
  """
  @param strict, "Also surface full type-flow findings as warnings."
  @spec build(boolean()) :: nil
  def build(strict \\ false) do
    if not run_check(true, strict) do
      IO.puts(paint("build aborted: errors in the verdict", "1;31"))
      sys.exit(1)
    end
    try do
      modules = core.build(root())
      IO.puts(paint("✓", "1;32") <> " compiled #{Enum.count(modules)} module(s)")
    rescue
      e in core.CompileError -> compile_error(e)
    end
  end

  # the whole-project verdict (GEP-0025): compiler diagnostics plus
  # Advisor suggestions per file; true when no errors
  defp run_check(with_suggestions \\ true, strict \\ false) do
    diags = core.check(root())
    # artifact verification (R008): compile to the cache and let ty
    # prove every name and import resolves — only when nothing is
    # already broken
    errors0 = Enum.filter(diags, fn d -> Map.get(d, "severity") == "error" end)
    diags = if Enum.empty?(errors0) do
      cache = root() <> "/.gandora/cache"
      verification = try do
        modules = core.build(root(), cache)
        Verifier.verify(root(), cache, modules, strict)
      rescue
        _e -> []
      end
      diags ++ verification
    else
      diags
    end
    Enum.each(diags, fn d ->
      print_finding(Map.get(d, "severity"), Map.get(d, "path"),
        Map.get(d, "line", 0), Map.get(d, "message"))
    end)
    sources = if with_suggestions do
      collect_files(["src", "tests"])
    else
      []
    end
    hints = Enum.flat_map(sources, fn path ->
      text = try do
        pathlib.Path(path).read_text()
      rescue
        _e -> ""
      end
      per_file = Enum.filter(diags, fn d -> Map.get(d, "path") == path end)
      (Advisor.analyze(text, root()) ++ Advisor.lint_hints(text, per_file))
      |> Enum.map(fn h -> Map.put(h, "path", path) end)
    end)
    consolidated = Advisor.consolidate(hints)
    Enum.each(consolidated, fn h ->
      print_finding(Map.get(h, "kind"), Map.get(h, "path"),
        Map.get(h, "line", 0), Map.get(h, "message"))
    end)
    errors = Enum.filter(diags, fn d -> Map.get(d, "severity") == "error" end)
    print_summary(Enum.count(errors), Enum.count(diags) - Enum.count(errors),
      Enum.count(consolidated), with_suggestions)
    Enum.empty?(errors)
  end

  # ---- verdict presentation ------------------------------------------------

  @doc false
  defp color?(), do: sys.stdout.isatty() and is_nil(os.environ.get("NO_COLOR"))

  defp paint(text, code) do
    if color?() do
      esc = $builtins.chr(27)
      esc <> "[" <> code <> "m" <> text <> esc <> "[0m"
    else
      text
    end
  end

  @labels %{
    "error" => {"error", "1;31"},
    "warning" => {"warning", "1;33"},
    "practice" => {"practice", "1;36"},
    "migration" => {"migration", "1;35"},
    "did_you_mean" => {"did you mean", "1;34"},
    "type" => {"type", "2;37"}
  }

  # one finding: colored label + dim location, message indented under it
  defp print_finding(kind, path, line, message) do
    {label, code} = Map.get(@labels, kind, {kind, "1"})
    at = if line > 0, do: ":#{line}", else: ""
    rel = String.replace(to_string(path), root() <> "/", "")
    IO.puts("")
    IO.puts("#{paint(label, code)} #{paint(rel <> at, "2")}")
    Enum.each(message.split("\n"), fn l -> IO.puts("  " <> l) end)
  end

  defp print_summary(errors, warnings, suggestions, with_suggestions) do
    cond do
      errors > 0 ->
        IO.puts("")
        IO.puts(paint("✗ #{errors} error(s)", "1;31") <> plural(warnings, "warning") <> plural(suggestions, "suggestion"))
      warnings + suggestions > 0 and with_suggestions ->
        IO.puts("")
        IO.puts(paint("◦ almost", "1;33") <> plural(warnings, "warning") <> plural(suggestions, "suggestion") <> " — apply them for a clean verdict")
      true -> nil
    end
  end

  defp plural(n, word) do
    if n > 0, do: ", #{n} #{word}(s)", else: ""
  end

  # .gan files under the given roots (shared with fmt's discovery idea)
  defp collect_files(roots) do
    Enum.flat_map(roots, fn r ->
      p = pathlib.Path(r)
      cond do
        not p.is_dir() -> []
        # tests: top level only, mirroring `gan test`; deeper dirs are fixtures
        r == "tests" ->
          Enum.sort(Enum.map($builtins.list(p.glob("*.gan")), &to_string/1))
        true ->
          Enum.sort(Enum.map($builtins.list(p.rglob("*.gan")), &to_string/1))
      end
    end)
  end

  @doc "Compiles and executes `file` with the project Python (GEP-0013-R002)."
  @param file, "The .gan entry file."
  @param args, "Arguments passed through to the program."
  @spec run(string(), list(string())) :: nil
  def run(file, args) do
    # errors gate the run; the teaching pass belongs to check/build
    if not run_check(false) do
      IO.puts("run aborted: check failed")
      sys.exit(1)
    end
    cache = root() <> "/.gandora/cache"
    try do
      modules = core.build(root(), cache)
      abs = to_string(pathlib.Path(file).resolve())
      target = Enum.find(modules, fn m -> Map.get(m, "source") == abs end)
      cond do
        is_nil(target) ->
          IO.puts("gan: #{file} is not a module of this project")
          sys.exit(1)
        is_nil(Map.get(target, "python")) ->
          IO.puts("gan: #{Map.get(target, "module")} defines only macros; nothing to run")
          sys.exit(1)
        true ->
          code = subprocess.call(
            [project_python(), "-P", Map.get(target, "python")] ++ args,
            env: Map.put($builtins.dict(os.environ), "PYTHONPATH", cache)
          )
          sys.exit(code)
      end
    rescue
      e in core.CompileError -> compile_error(e)
    end
  end

  @doc "Compiles and runs one expression given on the command line."
  @param code, "The Gandora source text."
  @spec exec_code(string()) :: nil
  def exec_code(code) do
    eval_line(code, $builtins.dict())
  end

  @doc "An interactive loop over compile_snippet — state carries across lines."
  @spec repl() :: nil
  def repl() do
    IO.puts("gan repl (gandora-core #{core.version()}) — Ctrl-D to exit")
    ns = $builtins.dict()
    repl_walk(ns)
    IO.puts("")
  end

  defp repl_walk(ns) do
    line = try do
      $builtins.input("gan> ")
    rescue
      _e in $builtins.EOFError -> :eof
      _e in $builtins.KeyboardInterrupt -> :eof
    end
    cond do
      line == :eof -> :ok
      String.trim(line) == "" -> recur(ns)
      true ->
        eval_line(line, ns)
        recur(ns)
    end
  end

  defp eval_line(code, ns) do
    try do
      compiled = core.compile_snippet(code, root())
      $builtins.exec(compiled, ns)
      result = Map.get(ns, "_")
      if not is_nil(result) do
        IO.puts(inspect(result))
      end
    rescue
      e in core.CompileError ->
        IO.puts("error: #{Enum.at($builtins.list(e.args), 0)}")
      e ->
        IO.puts("#{$builtins.type(e).__name__}: #{to_string(e)}")
    end
  end

  @gandora_jsonc ~jsonc"""
  {
    "source": ["src"],
    "outDir": "dist",
    "targetPython": "3.11"
  }
  """

  @gitignore """
  __pycache__/
  *.py[oc]
  dist/
  .gandora/
  .venv/
  """

  @hello_gan ~gan"""
  defmodule Main do
    @moduledoc "Your project's entry point — `gan run src/main.gan`."

    @doc "Prints a greeting."
    @spec main() :: nil
    def main() do
      IO.puts("Hello from Gandora!")
    end
  end
  """

  # The MCP surface, wired for the agents that read a project-level file
  # (GEP-0028-R012). One command everywhere, and it carries no paths:
  # `uv run` resolves this project's environment from wherever the client
  # launches it, `gan` finds gan-mcp in that .venv/bin (GEP-0013-R003),
  # and the server walks up to the nearest gandora.jsonc. Check them in.
  # (~jsonc as in @gandora_jsonc: these are a config file's literal text,
  # not data being built — the content is strict JSON, comment-free.)
  @mcp_claude ~jsonc"""
  {
    "mcpServers": {
      "gandora": {
        "type": "stdio",
        "command": "uv",
        "args": ["run", "gan", "mcp"]
      }
    }
  }
  """

  @mcp_codex ~toml"""
  # Codex reads this for a trusted project; `codex mcp list` shows it.
  [mcp_servers.gandora]
  command = "uv"
  args = ["run", "gan", "mcp"]
  """

  @mcp_opencode ~jsonc"""
  {
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
      "gandora": {
        "type": "local",
        "command": ["uv", "run", "gan", "mcp"],
        "enabled": true
      }
    }
  }
  """

  defp pyproject_toml(name) do
    ~toml"""
    [project]
    name = "<%= name %>"
    version = "0.1.0"
    requires-python = ">=3.11"
    dependencies = ["gandora-std>=<%= core.version() %>"]

    [dependency-groups]
    dev = ["gandora-tool[dev]>=<%= core.version() %>", "gandora-mcp>=<%= core.version() %>"]
    """
  end

  @doc """
  Writes the project-level MCP configuration each agent reads on its own
  (GEP-0028-R012): `.mcp.json` for Claude Code, `.codex/config.toml` for
  Codex, `opencode.json` for opencode. Never overwrites what is there.
  """
  @param p, "The project directory."
  @spec write_mcp_configs(term()) :: nil
  def write_mcp_configs(p) do
    write_if_absent(p / ".mcp.json", @mcp_claude)
    write_if_absent(p / "opencode.json", @mcp_opencode)
    (p / ".codex").mkdir(parents: true, exist_ok: true)
    write_if_absent(p / ".codex" / "config.toml", @mcp_codex)
  end

  # `init [--package] <path>`: the flag selects which scaffold
  defp init_cmd(args) do
    paths = Enum.filter(args, fn a -> not String.starts_with?(a, "--") end)
    path = if Enum.empty?(paths), do: ".", else: Enum.at(paths, 0)
    if Enum.member?(args, "--package") do
      if Enum.empty?(paths) do
        die_usage("init --package requires a package name")
      else
        init_package(path)
      end
    else
      init(path)
    end
  end

  @doc """
  Creates a project, or fills in what an existing one is missing.

  Since the scaffold also writes the agent wiring (GEP-0028-R012),
  re-running it on a project that already exists is how that wiring
  arrives — so this never refuses and never overwrites: every file it
  would write, it writes only when absent.
  """
  @param path, "Where to create the project."
  @spec init(string()) :: nil
  def init(path) do
    p = pathlib.Path(path)
    if p.exists() and not p.is_dir() do
      IO.puts("gan: #{path} is a file")
      sys.exit(1)
    end
    (p / "src").mkdir(parents: true, exist_ok: true)
    name = to_string(p.resolve().name)
    write_if_absent(p / "gandora.jsonc", @gandora_jsonc)
    pyproject = p / "pyproject.toml"
    if pyproject.exists() do
      # the MCP configs below are written either way, but their command
      # only resolves once the project depends on the toolchain — say
      # exactly what to add rather than leave dead wiring behind. A
      # pyproject that already names them needs no advice: re-running
      # init on a wired project is the normal way to pick up new files.
      if not String.contains?(pyproject.read_text(), "gandora-mcp") do
        IO.puts("kept existing pyproject.toml — add these so the toolchain and the MCP wiring resolve:")
        IO.puts("  dependencies: \"gandora-std\"        (generated code imports it)")
        IO.puts("  dev group:    \"gandora-tool[dev]\", \"gandora-mcp\"  (`uv run gan mcp`)")
      end
    else
      pyproject.write_text(pyproject_toml(name))
    end
    write_if_absent(p / ".gitignore", @gitignore)
    write_if_absent(p / ".python-version", "3.11\n")
    write_if_absent(p / "src" / "main.gan", @hello_gan)
    write_mcp_configs(p)
    IO.puts("Initialized Gandora project in #{path}")
    IO.puts("MCP wired for Claude Code (.mcp.json), Codex (.codex/config.toml), opencode (opencode.json)")
  end

  defp write_if_absent(file, content) do
    if not file.exists() do
      file.write_text(content)
    end
  end

  # outDir must not be `dist`: hatchling excludes its own artifact
  # directory from wheel inputs
  @package_jsonc ~jsonc"""
  {
    // Gandora package project (GEP-0006): `gan build` also emits the
    // gandora.toml marker and ships .gan sources for macro consumers.
    "source": ["src"],
    "outDir": "pkg",
    "targetPython": "3.11",
    "package": true
  }
  """

  defp package_pyproject(dist_name, py_pkg) do
    ~toml"""
    [project]
    name = "<%= dist_name %>"
    version = "0.1.0"
    description = "A Gandora package"
    requires-python = ">=3.11"
    dependencies = ["gandora-std>=<%= core.version() %>"]

    [build-system]
    requires = ["hatchling"]
    build-backend = "hatchling.build"

    # pkg/ is gitignored build output but must enter the distribution
    [tool.hatch.build]
    ignore-vcs = true

    # the sdist carries sources and the compiled output of `gan build`
    [tool.hatch.build.targets.sdist]
    include = ["pkg", "src", "gandora.jsonc"]

    # the wheel packages the compiled output (marker and .gan sources included)
    [tool.hatch.build.targets.wheel]
    packages = ["pkg/<%= py_pkg %>"]

    # the toolchain and the MCP surface are development-time, never runtime
    [dependency-groups]
    dev = ["gandora-tool[dev]>=<%= core.version() %>", "gandora-mcp>=<%= core.version() %>"]
    """
  end

  # the starter faces the same verdict every other module does. `~gan` is
  # raw text (GEP-0009-R006): a backslash means a backslash, so the two
  # spellings the template must EMIT rather than obey — the heredoc fence
  # and an interpolation hole — arrive through `<%= %>` splices.
  defp package_starter(module, dist_name) do
    fence = "\"\"\""
    hole = "#" <> "{name}"
    ~gan"""
    defmodule <%= module %>.Core do
      @moduledoc "Public surface of <%= dist_name %>: functions run anywhere, macros expand in consumers."

      @doc "Greets `name` in this package's voice."
      @param name, "Who to greet."
      @spec hello(string()) :: string()
      @example <%= fence %>
          gan> <%= module %>.Core.hello("world")
          'Hello from <%= dist_name %>, world!'
      <%= fence %>
      def hello(name), do: "Hello from <%= dist_name %>, <%= hole %>!"

      @doc "Evaluates `expr` twice and pairs the results — a macro consumers expand."
      @param expr, "The expression to duplicate."
      @spec twice(term()) :: tuple()
      defmacro twice(expr) do
        quote do
          {unquote(expr), unquote(expr)}
        end
      end

      @doc "Proof the macro expands where it is used — a macro's own example is displayed, never run."
      @spec twice_demo() :: tuple()
      @example <%= fence %>
          gan> <%= module %>.Core.twice_demo()
          (2, 2)
      <%= fence %>
      def twice_demo(), do: twice(1 + 1)
    end
    """
  end

  @doc """
  Creates a publishable Gandora package (GEP-0006-R001): sources under
  `src/<py_pkg>/`, compiled output in `pkg/` shipped in the wheel.
  """
  @param path, "The package directory to create; its name is the distribution name."
  @spec init_package(string()) :: nil
  def init_package(path) do
    p = pathlib.Path(path)
    if p.exists() do
      IO.puts("gan: #{path} already exists")
      sys.exit(1)
    end
    dist_name = to_string(p.resolve().name)
    py_pkg = String.replace(dist_name, "-", "_")
    module = camelize(py_pkg)
    (p / "src" / py_pkg).mkdir(parents: true, exist_ok: true)
    (p / "gandora.jsonc").write_text(@package_jsonc)
    (p / "pyproject.toml").write_text(package_pyproject(dist_name, py_pkg))
    (p / ".gitignore").write_text(@gitignore <> "pkg/\n")
    (p / ".python-version").write_text("3.11\n")
    (p / "src" / py_pkg / "core.gan").write_text(package_starter(module, dist_name))
    write_mcp_configs(p)
    IO.puts("Initialized Gandora package #{dist_name} in #{path}")
    IO.puts("Publish with:")
    IO.puts("  cd #{path}")
    IO.puts("  gan build && uv build && uv publish")
  end

  @doc "A snake_case package name as its Gandora module name."
  @param name, "The snake_case name."
  @spec camelize(string()) :: string()
  @example """
      gan> Main.camelize("gan_coin")
      'GanCoin'
  """
  def camelize(name) do
    parts = for part <- String.split_on(name, "_"), part != "", do: String.capitalize(part)
    Enum.join(parts, "")
  end

  @doc "The executable name a plugin subcommand delegates to (GEP-0013-R003)."
  @example """
      gan> Main.plugin_name("fmt")
      'gan-fmt'
  """
  @param cmd, "The subcommand."
  @spec plugin_name(string()) :: string()
  def plugin_name(cmd), do: "gan-" <> cmd

  defp find_plugin(cmd) do
    # project venv first (GEP-0013-R003: installing a plugin is `uv add`),
    # then the surrounding PATH
    venv_bin = root() <> "/.venv/bin"
    local = shutil.which(plugin_name(cmd), path: venv_bin)
    if is_nil(local) do
      shutil.which(plugin_name(cmd))
    else
      local
    end
  end

  defp delegate(cmd, rest) do
    plugin = find_plugin(cmd)
    ganc = ganc_bin()
    cond do
      not is_nil(plugin) -> sys.exit(subprocess.call([plugin] ++ rest))
      not is_nil(ganc) -> sys.exit(subprocess.call([ganc, cmd] ++ rest))
      true -> die_usage("unknown command '#{cmd}' (no gan-#{cmd} plugin, no ganc)")
    end
  end

  # ganc ships as a dependency into gan's own venv (uv tool exposes
  # only the primary package's scripts) — look beside the interpreter
  # first, then PATH
  defp ganc_bin() do
    local = os.path.join(os.path.dirname(sys.executable), "ganc")
    if os.path.exists(local) do
      local
    else
      shutil.which("ganc")
    end
  end

  defp compile_error(e) do
    args = $builtins.list(e.args)
    IO.puts("#{Enum.at(args, 1)}:#{Enum.at(args, 2)}:#{Enum.at(args, 3)}: error: #{Enum.at(args, 0)}")
    sys.exit(1)
  end
end
