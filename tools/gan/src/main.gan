defmodule Main do
  @moduledoc """
  gan — the Gandora task runner (GEP-0013), written in Gandora.
  Native commands drive gandora-core in-process; unknown subcommands
  delegate to gan-<name> plugins, then to the stage-0 compiler ganc.
  """

  pyimport gandora_core, as: core
  pyimport subprocess
  pyimport shutil
  pyimport pathlib

  @usage """
  gan - the Gandora task runner

  Usage:
    gan build | check | run <file> [args...] | exec <code> | repl
    gan init <path> | version
    gan <plugin> ...        delegates to gan-<plugin>, then to ganc
  """

  def main() do
    args = :builtins.list(:sys.argv) |> Enum.drop(1)
    case args do
      [] ->
        IO.puts(@usage)
        :sys.exit(2)
      ["version" | _] -> version()
      ["build" | _] -> build()
      ["check" | _] -> check()
      ["run", file | rest] -> run(file, rest)
      ["run"] -> die_usage("run requires a file")
      ["exec", code | _] -> exec_code(code)
      ["exec"] -> die_usage("exec requires code")
      ["repl" | _] -> repl()
      ["init", path | _] -> init(path)
      ["init"] -> die_usage("init requires a path")
      [cmd | rest] -> delegate(cmd, rest)
    end
  end

  defp die_usage(msg) do
    IO.puts("gan: " <> msg)
    IO.puts(@usage)
    :sys.exit(2)
  end

  defp root(), do: :os.getcwd()

  # "execute with the project Python" (GEP-0013-R002): the venv
  # interpreter when the project has one, else the runner's own
  defp project_python() do
    venv = root() <> "/.venv/bin/python"
    if :"os.path".exists(venv) do
      venv
    else
      :sys.executable
    end
  end

  def version() do
    IO.puts("gan #{runner_version()} (runner) / gandora-core #{core.version()}")
    if runner_version() != core.version() do
      IO.puts("warning: runner and gandora-core versions differ (GEP-0012-R007)")
    end
  end

  defp runner_version(), do: :"importlib.metadata".version("gandora-tool")

  def build() do
    try do
      modules = core.build(root())
      IO.puts("compiled #{Enum.count(modules)} module(s)")
    rescue
      e in core.CompileError -> compile_error(e)
    end
  end

  def check() do
    diags = core.check(root())
    Enum.each(diags, fn d ->
      IO.puts("#{Map.get(d, "severity")}: #{Map.get(d, "path")}:#{Map.get(d, "line")}: #{Map.get(d, "message")}")
    end)
    errors = Enum.filter(diags, fn d -> Map.get(d, "severity") == "error" end)
    if Enum.empty?(errors) do
      IO.puts("check passed")
    else
      :sys.exit(1)
    end
  end

  def run(file, args) do
    cache = root() <> "/.gandora/cache"
    try do
      modules = core.build(root(), cache)
      abs = to_string(:pathlib.Path(file).resolve())
      target = Enum.find(modules, fn m -> Map.get(m, "source") == abs end)
      cond do
        is_nil(target) ->
          IO.puts("gan: #{file} is not a module of this project")
          :sys.exit(1)
        is_nil(Map.get(target, "python")) ->
          IO.puts("gan: #{Map.get(target, "module")} defines only macros; nothing to run")
          :sys.exit(1)
        true ->
          code = subprocess.call(
            [project_python(), "-P", Map.get(target, "python")] ++ args,
            env: Map.put(:builtins.dict(:os.environ), "PYTHONPATH", cache)
          )
          :sys.exit(code)
      end
    rescue
      e in core.CompileError -> compile_error(e)
    end
  end

  def exec_code(code) do
    eval_line(code, :builtins.dict())
  end

  def repl() do
    IO.puts("gan repl (gandora-core #{core.version()}) — Ctrl-D to exit")
    ns = :builtins.dict()
    loop n = 0 do
      line = try do
        :builtins.input("gan> ")
      rescue
        _e in :builtins.EOFError -> :eof
        _e in :builtins.KeyboardInterrupt -> :eof
      end
      cond do
        line == :eof -> break(n)
        String.trim(line) == "" -> recur(n)
        true ->
          eval_line(line, ns)
          recur(n + 1)
      end
    end
    IO.puts("")
  end

  defp eval_line(code, ns) do
    try do
      compiled = core.compile_snippet(code, root())
      :builtins.exec(compiled, ns)
      result = Map.get(ns, "_")
      if not is_nil(result) do
        IO.puts(inspect(result))
      end
    rescue
      e in core.CompileError ->
        IO.puts("error: #{Enum.at(:builtins.list(e.args), 0)}")
      e ->
        IO.puts("#{:builtins.type(e).__name__}: #{to_string(e)}")
    end
  end

  @gandora_jsonc ~jsonc"""
  {
    "source": ["src"],
    "outDir": "dist",
    "targetPython": "3.11",
  }
  """

  @gitignore """
  __pycache__/
  *.py[oc]
  dist/
  .gandora/
  .venv/
  """

  @hello_gan ~gan"""
  defmodule Main do
    def main(), do: IO.puts("Hello from Gandora!")
  end
  """

  defp pyproject_toml(name) do
    ~toml"""
    [project]
    name = "<%= name %>"
    version = "0.1.0"
    requires-python = ">=3.11"
    dependencies = ["gandora-std>=<%= core.version() %>"]
    """
  end

  def init(path) do
    p = :pathlib.Path(path)
    if p.exists() do
      IO.puts("gan: #{path} already exists")
      :sys.exit(1)
    end
    (p / "src").mkdir(parents: true)
    name = to_string(p.resolve().name)
    (p / "gandora.jsonc").write_text(@gandora_jsonc)
    (p / "pyproject.toml").write_text(pyproject_toml(name))
    (p / ".gitignore").write_text(@gitignore)
    (p / ".python-version").write_text("3.11\n")
    (p / "src" / "main.gan").write_text(@hello_gan)
    IO.puts("Initialized Gandora project in #{path}")
  end

  defp find_plugin(cmd) do
    # project venv first (GEP-0013-R003: installing a plugin is `uv add`),
    # then the surrounding PATH
    venv_bin = root() <> "/.venv/bin"
    local = shutil.which("gan-" <> cmd, path: venv_bin)
    if is_nil(local) do
      shutil.which("gan-" <> cmd)
    else
      local
    end
  end

  defp delegate(cmd, rest) do
    plugin = find_plugin(cmd)
    ganc = shutil.which("ganc")
    cond do
      not is_nil(plugin) -> :sys.exit(subprocess.call([plugin] ++ rest))
      not is_nil(ganc) -> :sys.exit(subprocess.call([ganc, cmd] ++ rest))
      true -> die_usage("unknown command '#{cmd}' (no gan-#{cmd} plugin, no ganc)")
    end
  end

  defp compile_error(e) do
    args = :builtins.list(e.args)
    IO.puts("#{Enum.at(args, 1)}:#{Enum.at(args, 2)}:#{Enum.at(args, 3)}: error: #{Enum.at(args, 0)}")
    :sys.exit(1)
  end
end
