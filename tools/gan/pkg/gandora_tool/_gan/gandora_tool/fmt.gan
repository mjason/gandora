defmodule Fmt do
  @moduledoc """
  gan fmt (GEP-0016): conservative source formatting over the
  gandora_core token stream. Rewrites indentation and horizontal
  whitespace, and reflows multi-line map literals to one pair per
  line (R011) — never joins lines — and refuses to write anything
  whose comments or parsed terms differ from the original (R006).
  """
  @moduledoc_trans zh_CN: "gan fmt(GEP-0016):基于 gandora_core token 流的保守格式化。重写缩进与水平空白,并把多行 map 字面量重排为一行一对(R011)——从不合并行——凡注释或解析结果有变的重写一律拒绝落盘(R006)。"

  pyimport gandora_core, as: core
  pyimport sys

  # ---- entry ---------------------------------------------------------------

  @doc "The `gan fmt` entry: formats the given paths, or stdin with `-`."
  @doc_trans zh_CN: "`gan fmt` 入口：格式化给定路径，`-` 表示读取 stdin。"
  @param args, "CLI arguments after `fmt`: paths, `-` for stdin, --check, --diff."
  @spec run(sequence(string())) :: nil
  def run(args) do
    check = Enum.member?(args, "--check")
    diff = Enum.member?(args, "--diff")
    paths = Enum.reject(args, fn a -> String.starts_with?(a, "--") end)
    if paths == ["-"] do
      run_stdin()
    else
      files = collect_files(paths)
      if Enum.empty?(files) do
        IO.puts("gan fmt: no .gan files found")
        System.halt(1)
      end
      results = Enum.map(files, fn f -> format_file(f, check or diff) end)
      changed = Enum.filter(results, fn {_, status} -> status == :changed end)
      errors = Enum.filter(results, fn {_, status} -> status == :error end)
      cond do
        not Enum.empty?(errors) ->
          System.halt(2)
        diff ->
          Enum.each(changed, fn {f, _} -> print_diff(f) end)
          if not Enum.empty?(changed), do: System.halt(1)
        check and not Enum.empty?(changed) ->
          Enum.each(changed, fn {f, _} -> IO.puts("would reformat #{f}") end)
          System.halt(1)
        true ->
          IO.puts("#{Enum.count(changed)} file(s) reformatted, #{Enum.count(files)} checked")
      end
    end
  end

  # `gan fmt -`: read stdin, write the canonical form to stdout —
  # pipe- and editor-friendly (GEP-0016-R009)
  defp run_stdin() do
    text = sys.stdin.read()
    case format_text(text) do
      {:ok, new} ->
        if new != text and verify(text, new) != :ok do
          sys.stderr.write("gan fmt: verification failed; input left as-is\n")
          sys.stdout.write(text)
          System.halt(2)
        else
          sys.stdout.write(new)
          nil
        end
      _ ->
        sys.stderr.write("gan fmt: cannot parse input\n")
        sys.stdout.write(text)
        System.halt(2)
    end
  end

  # unified diff of what --diff would change, nothing rewritten
  # (GEP-0016-R010)
  defp print_diff(file) do
    text = File.read!(file)
    case format_text(text) do
      {:ok, new} ->
        lines = $difflib.unified_diff(
          text.splitlines(keepends: true),
          new.splitlines(keepends: true),
          fromfile: file,
          tofile: file <> " (formatted)"
        )
        Enum.each($builtins.list(lines), fn l -> sys.stdout.write(l) end)
      _ -> nil
    end
  end

  defp collect_files(paths) do
    roots = if Enum.empty?(paths) do
      ["src"]
    else
      paths
    end
    Enum.flat_map(roots, fn p ->
      cond do
        File.dir?(p) -> Path.wildcard(p |> Path.join("**") |> Path.join("*.gan"))
        String.ends_with?(p, ".gan") -> [p]
        true -> []
      end
    end)
  end

  defp format_file(file, check) do
    text = File.read!(file)
    case format_text(text) do
      {:ok, new} ->
        cond do
          new == text -> {file, :unchanged}
          check -> {file, :changed}
          true ->
            case verify(text, new) do
              :ok ->
                File.write!(file, new)
                IO.puts("reformatted #{file}")
                {file, :changed}
              {:error, why} ->
                IO.puts("gan fmt: internal error on #{file}: #{why} (GEP-0016-R006); file left unchanged")
                {file, :error}
            end
        end
      {:skip, why} ->
        IO.puts("gan fmt: skipped #{file}: #{why}")
        {file, :unchanged}
    end
  end

  # ---- verification (R006) -------------------------------------------------

  @doc "Confirms a rewrite preserves comments and parsed terms (R006)."
  @doc_trans zh_CN: "校验重写保持注释与解析结果不变（R006）。"
  @example """
      gan> Fmt.verify("x = 1", "x = 1")
      'ok'
      gan> Fmt.verify("x = 1", "x = 2")
      ('error', 'parsed terms changed')
  """
  @param old_text, "The original source."
  @param new_text, "The candidate rewrite that must preserve comments and parse."
  @spec verify(string(), string()) :: atom() | tuple(atom(), string())
  def verify(old_text, new_text) do
    cond do
      comments_of(old_text) != comments_of(new_text) ->
        {:error, "comment sequence changed"}
      strip_meta(core.parse(old_text)) != strip_meta(core.parse(new_text)) ->
        {:error, "parsed terms changed"}
      true -> :ok
    end
  end

  defp comments_of(text) do
    for t <- core.tokens(text), Map.get(t, "kind") == "comment",
      do: Map.get(t, "value").rstrip()
  end

  @allow :stack_recursion
  defp strip_meta(t) do
    cond do
      $builtins.isinstance(t, $builtins.tuple) and $builtins.len(t) == 3 ->
        {strip_meta(elem(t, 0)), strip_meta(elem(t, 2))}
      $builtins.isinstance(t, $builtins.tuple) ->
        t |> $builtins.list() |> Enum.map(&strip_meta/1) |> $builtins.tuple()
      $builtins.isinstance(t, $builtins.list) ->
        Enum.map(t, &strip_meta/1)
      true -> t
    end
  end

  # ---- formatting ----------------------------------------------------------

  @doc "Formats one source text: `{:ok, new}` or `{:skip, why}`."
  @doc_trans zh_CN: "格式化单个源文本：返回 `{:ok, new}` 或 `{:skip, why}`。"
  @param text, "The source to normalize."
  @spec format_text(string()) :: tuple(atom(), string())
  def format_text(text) do
    parsed = try do
      core.parse(text)
      :ok
    rescue
      _e in core.CompileError -> :parse_error
    end
    if parsed == :parse_error do
      {:skip, "does not parse"}
    else
      {:ok, text |> explode_maps() |> reflow()}
    end
  end

  # ---- multi-line map reflow (R011) ----------------------------------------

  # a `%{` whose span already crosses lines takes the canonical shape:
  # every top-level pair on its own line, the closer on its own line.
  # This pass only inserts newlines; `reflow` then owns the indent.
  defp explode_maps(text) do
    toks = Enum.reject(core.tokens(text), fn t ->
      Enum.member?(["eof", "newline"], Map.get(t, "kind"))
    end)
    points = toks |> map_spans() |> Enum.flat_map(fn span -> split_points(toks, span) end)
    if Enum.empty?(points) do
      text
    else
      apply_splits(text, Enum.uniq(points))
    end
  end

  # matched (open, close) token indexes of every reflowable %{ literal
  defp map_spans(toks) do
    walk = Enum.reduce(Enum.with_index(toks), {[], []}, fn {t, i}, {stack, spans} ->
      cond do
        opener_tok?(t) -> {[{t, i}] ++ stack, spans}
        closer?(t) and not Enum.empty?(stack) ->
          {opened, j} = Enum.at(stack, 0)
          {Enum.drop(stack, 1),
            if tok_is(opened, "op", "%{") do
              [{j, i}] ++ spans
            else
              spans
            end}
        true -> {stack, spans}
      end
    end)
    {_stack, spans} = walk
    Enum.filter(spans, fn {i, j} -> reflowable?(toks, i, j) end)
  end

  # multi-line, and free of the things a formatter must not relocate:
  # comments and multi-line string bodies (R011)
  defp reflowable?(toks, i, j) do
    open = Enum.at(toks, i)
    close = Enum.at(toks, j)
    inside = Enum.slice(toks, i + 1, j - i - 1)
    Map.get(close, "line") > Map.get(open, "line") and
      Enum.empty?(Enum.filter(inside, fn t ->
        Map.get(t, "kind") == "comment" or multiline?(t)
      end))
  end

  # where the newlines go: after the opener, after every top-level
  # comma, and before the closer — each only when not already at a
  # line start, so the pass is idempotent
  defp split_points(toks, {i, j}) do
    open = Enum.at(toks, i)
    close = Enum.at(toks, j)
    first = Enum.at(toks, i + 1)
    head = if Map.get(first, "line") == Map.get(open, "line") and i + 1 < j do
      [point(first)]
    else
      []
    end
    tail = if Map.get(Enum.at(toks, j - 1), "line") == Map.get(close, "line") do
      [point(close)]
    else
      []
    end
    head ++ comma_points(toks, i, j) ++ tail
  end

  defp comma_points(toks, i, j) do
    walk = Enum.reduce(Enum.slice(toks, i + 1, j - i - 1), {1, i + 1, []}, fn t, {depth, k, pts} ->
      cond do
        opener_tok?(t) -> {depth + 1, k + 1, pts}
        closer?(t) -> {depth - 1, k + 1, pts}
        tok_is(t, "op", ",") and depth == 1 and k + 1 < j and
          Map.get(Enum.at(toks, k + 1), "line") == Map.get(t, "line") ->
            {depth, k + 1, [point(Enum.at(toks, k + 1))] ++ pts}
        true -> {depth, k + 1, pts}
      end
    end)
    elem(walk, 2)
  end

  defp point(t), do: {Map.get(t, "line"), Map.get(t, "col")}

  # insert a newline before every (line, col), rightmost first
  defp apply_splits(text, points) do
    lines = text.split("\n")
    by_line = Enum.reduce(points, %{}, fn {l, c}, acc ->
      Map.put(acc, l, Enum.sort(Map.get(acc, l, []) ++ [c]))
    end)
    pieces = Enum.map(Enum.with_index(lines), fn {line, idx} ->
      split_line(line, Enum.reverse(Map.get(by_line, idx + 1, [])))
    end)
    Enum.join(pieces, "\n")
  end

  # cols arrive rightmost-first so earlier columns stay valid
  defp split_line(line, cols) do
    Enum.reduce(cols, line, fn c, acc ->
      String.slice(acc, 0, c - 1).rstrip() <> "\n" <> String.slice(acc, c - 1, $builtins.len(acc))
    end)
  end

  defp reflow(text) do
    toks = Enum.reject(core.tokens(text), fn t ->
      Map.get(t, "kind") == "eof" or Map.get(t, "kind") == "newline"
    end)
    lines = text.split("\n")
    interior = interior_lines(toks)
    buckets = bucket_by_line(toks)
    n = Enum.count(lines)
    out = reflow_walk({1, [], :blank_start, nil, false, %{}, []}, lines, interior, buckets, n)
    (out |> trim_trailing_blanks() |> Enum.join("\n")) <> "\n"
  end

  defp reflow_walk({i, stack, prev_kind, prev_last, prev_hang, deltas, acc},
    lines, interior, buckets, n) do
      if i > n do
        Enum.reverse(acc)
      else
        line = Enum.at(lines, i - 1)
        lt = Map.get(buckets, i, [])
        cond do
          Map.has_key?(interior, i) ->
            # inside a multi-line string: shift by the opener's delta
            # (R005); the closing line may still carry trailing tokens
            # (`"""},`) whose closers must pop the indent stack
            d = Map.get(deltas, Map.get(interior, i), 0)
            stack2 = if Enum.empty?(lt) do
              stack
            else
              advance(lt, stack, Enum.count(stack))
            end
            last2 = if Enum.empty?(lt), do: prev_last, else: last_significant(lt)
            recur({i + 1, stack2, :code, last2, prev_hang, deltas, [shift(line, d)] ++ acc},
              lines, interior, buckets, n)
          Enum.empty?(lt) ->
            # blank line: collapse runs, drop leading blanks
            if prev_kind == :blank or prev_kind == :blank_start do
              recur({i + 1, stack, prev_kind, prev_last, prev_hang, deltas, acc},
                lines, interior, buckets, n)
            else
              recur({i + 1, stack, :blank, prev_last, prev_hang, deltas, [""] ++ acc},
                lines, interior, buckets, n)
            end
          true ->
            {level, stack2, hung} = line_level(lt, stack, prev_last, prev_hang)
            indent = String.duplicate("  ", level)
            multi = Enum.find(lt, &multiline?/1)
            rendered = if is_nil(multi) do
              indent <> render_tokens(capture_parens(lt), lines)
            else
              indent <> line.strip()
            end
            deltas2 = if is_nil(multi) do
              deltas
            else
              old_lead = $builtins.len(line) - $builtins.len(line.lstrip())
              Map.put(deltas, i, $builtins.len(indent) - old_lead)
            end
            stack3 = advance(lt, stack2, level)
            recur({i + 1, stack3, :code, last_significant(lt), hung, deltas2, [rendered] ++ acc},
              lines, interior, buckets, n)
        end
      end
    end

  defp trim_trailing_blanks(ls) do
    ls |> Enum.reverse() |> Enum.drop_while(fn l -> l == "" end) |> Enum.reverse()
  end

  defp shift(line, d) do
    s = line.lstrip()
    if s == "" do
      ""
    else
      lead = $builtins.len(line) - $builtins.len(s)
      String.duplicate(" ", Enum.max([lead + d, 0])) <> s.rstrip()
    end
  end

  defp multiline?(t) do
    (Map.get(t, "kind") == "str" or Map.get(t, "kind") == "sigil") and
      Map.get(t, "end_line") > Map.get(t, "line")
  end

  defp interior_lines(toks) do
    Enum.reduce(toks, %{}, fn t, acc ->
      if multiline?(t) do
        interior = $builtins.range(Map.get(t, "line") + 1, Map.get(t, "end_line") + 1)
        Enum.reduce(interior, acc, fn l, a -> Map.put(a, l, Map.get(t, "line")) end)
      else
        acc
      end
    end)
  end

  defp bucket_by_line(toks) do
    Enum.reduce(toks, %{}, fn t, acc ->
      l = Map.get(t, "line")
      Map.put(acc, l, Map.get(acc, l, []) ++ [t])
    end)
  end

  defp last_significant(lt) do
    sig = Enum.reject(lt, fn t -> Map.get(t, "kind") == "comment" end)
    Enum.at(sig, -1)
  end

  # ---- structural indent (R004) --------------------------------------------

  defp tok_is(t, kind, value) do
    Map.get(t, "kind") == kind and Map.get(t, "value") == value
  end

  defp closer?(t) do
    (Map.get(t, "kind") == "kw" and Map.get(t, "value") == "end") or
      (Map.get(t, "kind") == "op" and Enum.member?([")", "]", "}"], Map.get(t, "value")))
  end

  defp mid?(t) do
    Map.get(t, "kind") == "kw" and Enum.member?(["else", "rescue", "after"], Map.get(t, "value"))
  end

  defp opener_tok?(t) do
    (Map.get(t, "kind") == "op" and Enum.member?(["(", "[", "{", "%{"], Map.get(t, "value"))) or
      (Map.get(t, "kind") == "kw" and Enum.member?(["do", "fn"], Map.get(t, "value")))
  end

  # an `->` at line-relative depth 0 marks a clause head
  defp clause_head?(lt) do
    r = Enum.reduce(lt, {0, false}, fn t, {depth, found} ->
      cond do
        opener_tok?(t) -> {depth + 1, found}
        closer?(t) -> {Enum.max([depth - 1, 0]), found}
        tok_is(t, "op", "->") and depth == 0 -> {depth, true}
        true -> {depth, found}
      end
    end)
    elem(r, 1)
  end

  defp ends_with_arrow?(lt) do
    last = last_significant(lt)
    not is_nil(last) and tok_is(last, "op", "->")
  end

  @hang_enders ["=", "<-", "\\\\", "++", "<>", "and", "or", "when", "in"]
  @hang_starters ["++", "<>", "and", "or", "when", "in", "==", "!=", "<=", ">=", "<", ">"]

  defp hang?(first, prev_last, prev_hang, in_paren) do
    starts = Enum.member?(["op", "kw"], Map.get(first, "kind")) and
      Enum.member?(@hang_starters, Map.get(first, "value"))
    ends = not is_nil(prev_last) and
      Enum.member?(["op", "kw"], Map.get(prev_last, "kind")) and
      Enum.member?(@hang_enders, Map.get(prev_last, "value"))
    # a trailing comma continues the statement — but only outside brackets,
    # where the bracket body already carries the indent
    comma = not in_paren and not is_nil(prev_last) and tok_is(prev_last, "op", ",")
    continues = tok_is(first, "op", "|>") and prev_hang
    starts or ends or comma or continues
  end

  defp line_level(lt, stack, prev_last, prev_hang) do
    first = Enum.at(lt, 0)
    # sibling clause heads and block closers end an open clause body
    popped = pop_clauses(stack, first, lt)
    top = Enum.at(popped, 0)
    level = cond do
      Enum.empty?(popped) -> 0
      closer?(first) -> Map.get(top, :open)
      mid?(first) -> Map.get(top, :open)
      true -> Map.get(top, :body)
    end
    top_paren = not Enum.empty?(popped) and Map.get(Enum.at(popped, 0), :kind) == :paren
    hung = not closer?(first) and not mid?(first) and
      hang?(first, prev_last, prev_hang, top_paren)
    level = if hung do
      level + 1
    else
      level
    end
    {Enum.max([level, 0]), popped, hung}
  end

  defp pop_clauses(s, first, lt) do
    if Enum.empty?(s) do
      s
    else
      top = Enum.at(s, 0)
      if Map.get(top, :kind) == :clause and
        (closer?(first) or mid?(first) or clause_head?(lt)) do
          recur(Enum.drop(s, 1), first, lt)
        else
          s
        end
    end
  end

  # push/pop the structures this line opens and closes
  defp advance(lt, stack, level) do
    stack2 = Enum.reduce(lt, stack, fn t, s ->
      cond do
        opener_tok?(t) -> [%{kind: struct_kind(t), body: level + 1, open: level}] ++ s
        closer?(t) -> pop_to_opener(s)
        true -> s
      end
    end)
    if ends_with_arrow?(lt) do
      [%{kind: :clause, body: level + 1, open: level}] ++ stack2
    else
      stack2
    end
  end

  defp struct_kind(t) do
    if Map.get(t, "kind") == "kw" do
      :block
    else
      :paren
    end
  end

  defp pop_to_opener(s) do
    case s do
      [] -> []
      [%{kind: :clause} | rest] -> pop_to_opener(rest)
      [_ | rest] -> rest
    end
  end

  # ---- line rendering (R003) -----------------------------------------------

  defp render_tokens(lt, lines) do
    render_walk({lt, "", nil}, lines)
  end

  defp render_walk({toks, out, prev}, lines) do
    case toks do
      [] -> out
      [t | rest] ->
        txt = tok_text(t, lines)
        piece = cond do
          is_nil(prev) -> txt
          gap(prev, t) == 0 -> txt
          true -> " " <> txt
        end
        recur({rest, out <> piece, t}, lines)
    end
  end

  @space_around ["=", "|>", "->", "<-", "=>", "\\\\"]

  defp space_around?(t) do
    Map.get(t, "kind") == "op" and Enum.member?(@space_around, Map.get(t, "value"))
  end

  defp gap(prev, t) do
    orig = Map.get(t, "col") - Map.get(prev, "end_col")
    cond do
      tok_is(t, "op", ",") -> 0
      Map.get(t, "kind") == "op" and Enum.member?([")", "]", "}"], Map.get(t, "value")) -> 0
      tok_is(prev, "op", ",") -> 1
      Map.get(t, "kind") == "comment" -> 1
      Map.get(prev, "kind") == "kwkey" -> 1
      space_around?(prev) or space_around?(t) -> 1
      Map.get(t, "kind") == "kw" and
        Enum.member?(["do", "when", "in", "and", "or"], Map.get(t, "value")) -> 1
      Map.get(prev, "kind") == "kw" and
        Enum.member?(["do", "when", "in", "and", "or", "not", "fn", "end", "else", "rescue", "after"],
          Map.get(prev, "value")) -> 1
      orig <= 0 -> 0
      true -> 1
    end
  end

  defp tok_text(t, lines) do
    cond do
      Map.get(t, "kind") == "comment" -> Map.get(t, "value").rstrip()
      Map.get(t, "synthetic", false) -> Map.get(t, "value")
      true ->
        line = Enum.at(lines, Map.get(t, "line") - 1)
        String.slice(line, Map.get(t, "col") - 1,
          Map.get(t, "end_col") - Map.get(t, "col"))
    end
  end

  # ---- &$mod.fun/arity -> &($mod.fun/arity) (R008) -------------------------

  defp capture_parens(lt) do
    capture_walk({lt, []})
  end

  defp capture_walk({toks, out}) do
    case toks do
      [] -> Enum.reverse(out)
      [t | rest] ->
        if tok_is(t, "op", "&") and not Enum.empty?(rest) and
          Map.get(Enum.at(rest, 0), "kind") == "pyref" do
            case split_capture(rest) do
              {body, tail} ->
                open = synth("(", t)
                close = synth(")", Enum.at(body, -1))
                recur({tail, [close] ++ Enum.reverse(body) ++ [open, t] ++ out})
              nil ->
                recur({rest, [t] ++ out})
            end
          else
            recur({rest, [t] ++ out})
          end
    end
  end

  # $mod (. name)* / int — returns {body_tokens, rest} or nil
  defp split_capture(toks) do
    split_walk({toks, [], :ref})
  end

  defp split_walk({left, taken, state}) do
    case {state, left} do
      {:ref, [t | rest]} ->
        if Map.get(t, "kind") == "pyref" do
          recur({rest, [t] ++ taken, :dot})
        else
          nil
        end
      {:dot, [t | rest]} ->
        cond do
          tok_is(t, "op", ".") -> recur({rest, [t] ++ taken, :name})
          tok_is(t, "op", "/") -> recur({rest, [t] ++ taken, :arity})
          true -> nil
        end
      {:name, [t | rest]} ->
        if Map.get(t, "kind") == "ident" or Map.get(t, "kind") == "upident" do
          recur({rest, [t] ++ taken, :dot})
        else
          nil
        end
      {:arity, [t | rest]} ->
        if Map.get(t, "kind") == "int" do
          {Enum.reverse([t] ++ taken), rest}
        else
          nil
        end
      {_, []} -> nil
    end
  end

  defp synth(op, near) do
    %{
      "kind" => "op",
      "value" => op,
      "synthetic" => true,
      "line" => Map.get(near, "line"),
      "col" => Map.get(near, "end_col"),
      "end_line" => Map.get(near, "line"),
      "end_col" => Map.get(near, "end_col")
    }
  end
end
