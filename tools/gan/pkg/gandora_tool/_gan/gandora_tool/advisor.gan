defmodule Advisor do
  @moduledoc """
  The compiler's teaching voice (GEP-0025): practice, migration, and
  did-you-mean suggestions over source text. `gan check` and
  `gan lsc check` share this engine — core diagnostics say what is
  broken, the Advisor says what to write instead.
  """
  @moduledoc_trans zh_CN: "编译器的教学面(GEP-0025):对源码给出 practice/migration/did-you-mean 建议;gan check 与 gan lsc check 共用——内核诊断说错在哪,Advisor 说该怎么写。"

  pyimport gandora_core, as: core
  pyimport difflib
  pyimport re

  @mistakes [
    {~r/^\s*return\b/, "Gandora has no `return` — a function's value is its last expression."},
    {~r/^\s*while\b/, "There is no `while` — use tail recursion (constant stack) or `for`/Enum (GEP-0019/0020)."},
    {~r/\belif\b/, "`elif` is spelled as another `cond do` branch, or a `case` clause."},
    {~r/^\s*def .*\):\s*$/, "Python `def ...():` — a Gandora head has no colon: `def f(x) do ... end` or `def f(x), do: expr`."},
    {~r/\blambda\b/, "`lambda` is spelled `fn x -> ... end`, called with `f.(x)`."},
    {~r/\bNone\b/, "`None` is spelled `nil`."},
    {~r/\bTrue\b|\bFalse\b/, "Booleans are lowercase: `true` / `false` (only `false` and `nil` are falsy)."},
    {~r/^\s*import\s+[a-z]/, "Python `import x` is `pyimport x` at module top, or an inline `$x` reference (GEP-0003)."},
    {~r/^\s*from\s+\w+\s+import\b/, "`from x import y` has no direct spelling — `pyimport x` then `x.y`, or `$x.y` inline."},
    {~r/\bprint\(/, "Prefer `IO.puts(...)` (falls through to Python print, but IO.puts is the idiom)."},
    {~r/\bself\./, "There is no `self` — Gandora functions are module functions over plain data."},
    {~r/&&|\|\|(?!>)/, "Boolean operators are the words `and` / `or` / `not`."},
    {~r/\+=|-=|\*=/, "No augmented assignment — rebind: `x = x + 1`."},
    {~r/\bf"/, "f-strings are plain strings — interpolation is built in: \"total " <> "#" <> "{n}\"."},
    {~r/\bswitch\b/, "`switch` is `case ... do pattern -> ... end`."},
    {~r/\bnil\s*==|==\s*nil\b/, "Prefer `is_nil(x)` over comparing with nil."},
    {~r/\$"/, "Quoted module refs were retired: write $(a.b) (GEP-0003-R010)."},
    {~r/\bPython\b/,
      "There is no `Python` object — interop is `$math.sqrt(x)` inline, or `pyimport math` at module top, then `math.sqrt(x)` (GEP-0003)."}
  ]

  @keywords ["defmodule", "def", "defp", "defmacro", "defstruct", "case", "cond",
    "with", "for", "fn", "try", "rescue", "after", "else", "end", "do", "quote",
    "unquote", "pyimport", "import", "require", "alias", "use", "recur", "when",
    "true", "false", "nil", "and", "or", "not", "raise", "if", "unless"]

  @doc """
  Every suggestion for one source: cross-language migration hints,
  practice gaps, and member/name did-you-means.
  """
  @param source, "The Gandora source text."
  @param root, "Project root for symbol resolution."
  @spec analyze(string(), string()) :: list(map())
  def analyze(source, root) do
    dedupe(common_mistakes(source) ++ practice_hints(source) ++
        member_suggestions(source, root))
  end

  @doc "Fuzzy candidates for a compile error at `line` of `source`."
  @param source, "The source that failed to compile."
  @param msg, "The compiler error message."
  @param line, "The error line (0 when unknown)."
  @spec error_hints(string(), string(), integer()) :: list(map())
  def error_hints(source, msg, line) do
    dedupe(error_suggestions(source, msg, line))
  end

  # blank out string/heredoc/sigil/comment content (newlines kept) so
  # prose can never trip a code pattern (GEP-0023-R003)
  @spec mask_literals(string()) :: string()
  defp mask_literals(source) do
    spaces = fn text -> re.sub("\\S", " ", text) end
    masked = re.sub("\"\"\"([\\s\\S]*?)\"\"\"",
      fn m -> "\"\"\"" <> spaces.(m.group(1)) <> "\"\"\"" end, source)
    masked = re.sub("(~[a-zA-Z]+\\()([^)]*)\\)",
      fn m -> m.group(1) <> spaces.(m.group(2)) <> ")" end, masked)
    masked = re.sub("(~[a-zA-Z]+/)([^/\\n]*)/",
      fn m -> m.group(1) <> spaces.(m.group(2)) <> "/" end, masked)
    masked = re.sub("\"((?:[^\"\\\\\\n]|\\\\.)*)\"",
      fn m -> "\"" <> spaces.(m.group(1)) <> "\"" end, masked)
    re.sub("#(?!\\{)([^\\n]*)", fn m -> "#" <> spaces.(m.group(1)) end, masked)
  end

  defp common_mistakes(source) do
    lines = mask_literals(source).split("\n")
    Enum.flat_map(@mistakes, fn {pattern, advice} ->
      hit = Enum.find_index(lines, fn l -> not is_nil(pattern.search(l)) end)
      if is_nil(hit) do
        []
      else
        [%{"kind" => "migration", "line" => hit + 1, "message" => advice}]
      end
    end)
  end

  # The standards in docs/syntax.md, advisory here rather than
  # compiler warnings. AI rarely misspells — it gets lazy: annotation
  # coverage, container choice, and idiom shortcuts are where verdicts
  # earn their keep (GEP-0023-R004).
  defp practice_hints(raw) do
    source = mask_literals(raw)
    in_module = String.match?(source, ~r/defmodule/)
    coverage_hints(raw, source, in_module) ++
      spec_container_hints(source) ++
      idiom_hints(source) ++
      pyimport_hints(source)
  end

  # one consolidated annotation-coverage report, not one nag per def
  defp coverage_hints(raw, source, in_module) do
    if not in_module do
      []
    else
      heads = Enum.uniq(~r/(?m)^\s*def ([a-z_][A-Za-z0-9_]*[?!]?)/.findall(source))
      specs = ~r/(?m)^\s*@spec ([a-z_][A-Za-z0-9_]*[?!]?)/.findall(source)
      docs = count_attr_blocks(source, "@doc")
      no_spec = Enum.filter(heads, fn h -> not Enum.member?(specs, h) end)
      missing = []
      missing = if Enum.empty?(no_spec) do
        missing
      else
        missing ++ ["@spec on: #{no_spec |> Enum.join(", ")}"]
      end
      missing = if docs >= Enum.count(heads) do
        missing
      else
        missing ++ ["@doc on #{Enum.count(heads) - docs} public def(s)"]
      end
      missing = if String.contains?(source, "@moduledoc") do
        missing
      else
        missing ++ ["@moduledoc"]
      end
      example_hint = if Enum.count(heads) > 0 and not String.contains?(raw, "@example") do
        [%{"kind" => "practice", "line" => 0,
          "message" => "No @example doctests — add one right above a def, e.g.:\n@example \"\"\"\n    gan> double(21)\n    42\n\"\"\"\n(`gan test` runs them; expected output is the Python repr) (GEP-0007)."}]
      else
        []
      end
      head_hint = if Enum.empty?(missing) do
        []
      else
        [%{"kind" => "practice", "line" => 0,
          "message" => "Annotation coverage: missing #{missing |> Enum.join("; ")} — e.g. @doc \"What it does.\" then @spec name(integer()) :: integer() above the def; a printing entry is @spec main() :: nil; unsure of a type? read the cheat sheet: gan lsc doc spec (docs/syntax.md)."}]
      end
      head_hint ++ example_hint
    end
  end

  defp count_attr_blocks(source, attr) do
    Enum.count(~r/(?m)^\s*#{attr} /.findall(source))
  end

  # parameter positions want abstract containers (GEP-0017 guidance)
  defp spec_container_hints(source) do
    offenders = ~r/(?m)^\s*@spec\s+([a-z_][A-Za-z0-9_]*[?!]?)\(([^)]*(?:list|map)\()/.findall(source)
    |> Enum.map(fn {name, _} -> name end)
    |> Enum.uniq()
    if Enum.empty?(offenders) do
      []
    else
      [%{"kind" => "practice", "line" => 0,
        "message" => "Concrete `list()`/`map()` in parameter position of @spec #{offenders |> Enum.join(", ")} — accept `sequence(t)`/`iterable(t)`/`mapping(k, v)`, return concrete (\"abstract in, concrete out\", docs/syntax.md)."}]
    end
  end

  # idiom shortcuts an agent skips when hurrying
  defp idiom_hints(source) do
    checks = [
      {~r/fn (\w+) -> ([a-z_][A-Za-z0-9_.]*[?!]?)\(\1\) end/,
        "`fn x -> f(x) end` wraps a single call — the capture `&f/1` says the same thing."},
      {~r/Enum\.count\([^)]*\)\s*==\s*0|length\([^)]*\)\s*==\s*0/,
        "`... == 0` on a count — `Enum.empty?(xs)` reads better."},
      {~r/\|>\s*Enum\.map\([\s\S]{0,120}?\|>\s*Enum\.filter\(|\|>\s*Enum\.filter\([\s\S]{0,120}?\|>\s*Enum\.map\(/,
        "A map+filter pipeline — a single `for x <- xs, cond, do: expr` comprehension often reads better and compiles to one pass (GEP-0020)."},
      {~r/, do: true, else: false/,
        "`if cond, do: true, else: false` is just the condition (wrap with a boolean-shaped guard if needed)."}
    ]
    hits = Enum.flat_map(checks, fn {pattern, advice} ->
      if is_nil(pattern.search(source)) do
        []
      else
        [%{"kind" => "practice", "line" => 0, "message" => advice}]
      end
    end)
    rescue_only_bare = String.match?(source, ~r/rescue\s*\n\s*[a-z_][A-Za-z0-9_]* ->/) and
      not String.match?(source, ~r/rescue[\s\S]{0,200}? in /)
    bare_hint = if rescue_only_bare do
      [%{"kind" => "practice", "line" => 0,
        "message" => "A bare `rescue e ->` catches every Exception — rescue specific types first: `e in $builtins.ValueError -> ...` (GEP-0014)."}]
    else
      []
    end
    hits ++ bare_hint
  end

  defp pyimport_hints(source) do
    refs = ~r/\$([a-z_][a-z0-9_]*)/.findall(source)
    counts = Enum.reduce(refs, %{}, fn m, acc -> Map.put(acc, m, Map.get(acc, m, 0) + 1) end)
    counts.items()
    |> Enum.filter(fn {_, n} -> n >= 3 end)
    |> Enum.map(fn {m, n} ->
      %{"kind" => "practice", "line" => 0,
        "message" => "`$#{m}` appears #{n} times — declare `pyimport #{m}` once and use the bare name (GEP-0003 rev 6)."}
    end)
  end

  # fuzzy candidates for a compile error: the token at the error line
  # against keywords and known module functions (GEP-0023-R002)
  defp error_suggestions(source, msg, line) do
    from_msg = ~r/'([A-Za-z_][A-Za-z0-9_.!?]*)'/.findall(to_string(msg))
    at_line = if is_nil(line) or line == 0 do
      # no span on the error: sweep every word in the snippet
      ~r/[A-Za-z_][A-Za-z0-9_]*/.findall(source)
    else
      l = Enum.at(source.split("\n"), line - 1)
      if is_nil(l) do
        []
      else
        ~r/[A-Za-z_][A-Za-z0-9_]*/.findall(l)
      end
    end
    (from_msg ++ at_line)
    |> Enum.uniq()
    |> Enum.reject(fn word -> String.contains?(source, "@" <> word) end)
    |> Enum.flat_map(fn word ->
      near = difflib.get_close_matches(word, @keywords, n: 1, cutoff: 0.8)
      if Enum.empty?(near) or Enum.member?(@keywords, word) do
        []
      else
        [%{"kind" => "did_you_mean", "line" => line,
          "message" => "`#{word}` — did you mean `#{Enum.at(near, 0)}`?"}]
      end
    end)
  end

  # `Mod.fun` calls whose function does not exist on the module: the
  # classic AI typo (Enum.mpa). Checked against real module symbols.
  defp member_suggestions(raw, root) do
    source = mask_literals(raw)
    calls = ~r/\b([A-Z][A-Za-z0-9_.]*)\.([a-z_][A-Za-z0-9_]*[?!]?)\(/.findall(source)
    Enum.uniq(calls)
    |> Enum.flat_map(fn {mod, fun} ->
      names = module_functions(mod, root)
      cond do
        Enum.empty?(names) -> []
        Enum.member?(names, fun) -> []
        true ->
          near = difflib.get_close_matches(fun, names, n: 3, cutoff: 0.6)
          hint = if Enum.empty?(near) do
            "no close match; see `gan lsc symbols #{mod}`"
          else
            "did you mean #{near |> Enum.map(fn n -> "`#{mod}.#{n}`" end) |> Enum.join(" / ")}?"
          end
          [%{"kind" => "did_you_mean", "line" => 0,
            "message" => "`#{mod}.#{fun}` is not a function of #{mod} — #{hint}"}]
      end
    end)
  end

  defp module_functions(mod, root) do
    syms = try do
      core.symbols(mod, root)
    rescue
      _e -> []
    end
    names = Enum.map(syms, fn s -> Map.get(s, "name") end)
    if Enum.empty?(names) do
      std_functions(mod)
    else
      names
    end
  end

  # std members via introspection of the library this tool ships with —
  # works even when the checked project has no venv
  defp std_functions(mod) do
    known = %{"Enum" => "enum", "Map" => "map", "List" => "list",
      "Keyword" => "keyword", "String" => "string", "Test" => "test"}
    pymod = Map.get(known, mod)
    if is_nil(pymod) do
      []
    else
      m = $importlib.import_module("gandora_std." <> pymod)
      $builtins.dir(m)
      |> Enum.filter(fn n -> not String.starts_with?(n, "_") end)
      |> Enum.map(fn n ->
        n |> String.replace("_bang", "!") |> String.replace("_p", "?")
      end)
    end
  end

  # undefined-variable lints get fuzzy candidates from the snippet's
  # own identifiers
  defp lint_suggestions(source, d) do
    m = ~r/variable ([A-Za-z0-9_?!]+) is never bound/.search(Map.get(d, "message", ""))
    if is_nil(m) do
      []
    else
      word = m.group(1)
      idents = ~r/[a-z_][A-Za-z0-9_]*/.findall(source) |> Enum.uniq()
      near = difflib.get_close_matches(word, idents, n: 3, cutoff: 0.7)
      |> Enum.filter(fn n -> n != word end)
      if Enum.empty?(near) do
        []
      else
        [%{"kind" => "did_you_mean", "line" => Map.get(d, "line"),
          "message" => "`#{word}` — did you mean #{near |> Enum.map(fn n -> "`#{n}`" end) |> Enum.join(" / ")}?"}]
      end
    end
  end

  @doc "Did-you-mean hints for undefined-variable lints."
  @param source, "The source the lints came from."
  @param diags, "The diagnostics list from core.check/diagnostics."
  @spec lint_hints(string(), list(map())) :: list(map())
  def lint_hints(source, diags) do
    dedupe(Enum.flat_map(diags, fn d -> lint_suggestions(source, d) end))
  end

  @spec dedupe(list(map())) :: list(map())
  defp dedupe(suggestions) do
    {out, _} = Enum.reduce(suggestions, {[], []}, fn s, {acc, seen} ->
      msg = Map.get(s, "message")
      if Enum.member?(seen, msg) do
        {acc, seen}
      else
        {acc ++ [s], seen ++ [msg]}
      end
    end)
    out
  end
end
