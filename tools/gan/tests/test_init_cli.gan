defmodule TestInitCli do
  @moduledoc """
  The `gan init` scaffold contract (GEP-0028-R012): the project-level
  MCP configuration each agent reads on its own, in the shape that
  agent documents, plus the standing promise that a fresh project is
  born passing its own verdict.
  """
  @moduledoc_trans zh_CN: "`gan init` 脚手架契约(GEP-0028-R012):每个 agent 各自读取的项目级 MCP 配置,形状依各自文档而定;外加一条长期承诺——新项目一出生就通过自己的裁决。"

  use Test

  pyimport tempfile
  pyimport json
  pyimport sys

  defp gan_bin() do
    sys.executable |> Path.dirname() |> Path.join("gan")
  end

  defp scaffold() do
    tmp = tempfile.mkdtemp(prefix: "gan-init-")
    target = Path.join(tmp, "proj")
    _r = System.cmd(gan_bin(), ["init", target], [stderr_to_stdout: true])
    target
  end

  defp read(dir, name), do: File.read!(Path.join(dir, name))

  # nil, not :ok — a test function must return None for pytest
  defp cleanup(dir) do
    _ok = File.rm_rf!(Path.dirname(dir))
    nil
  end

  # Claude Code reads `.mcp.json` at the project root (project scope)
  test "the claude code config names the pathless server command" do
    dir = scaffold()
    conf = json.loads(read(dir, ".mcp.json"))
    server = conf |> Map.get("mcpServers") |> Map.get("gandora")
    assert_eq(Map.get(server, "command"), "uv")
    assert_eq(Map.get(server, "args"), ["run", "gan", "mcp"])
    assert_eq(Map.get(server, "type"), "stdio")
    cleanup(dir)
  end

  # opencode reads `opencode.json` at the project root
  test "the opencode config declares a local server, enabled" do
    dir = scaffold()
    conf = json.loads(read(dir, "opencode.json"))
    server = conf |> Map.get("mcp") |> Map.get("gandora")
    assert_eq(Map.get(server, "type"), "local")
    assert_eq(Map.get(server, "command"), ["uv", "run", "gan", "mcp"])
    assert_true(Map.get(server, "enabled"))
    cleanup(dir)
  end

  # Codex reads `.codex/config.toml` for a trusted project
  test "the codex config declares the server under mcp_servers" do
    dir = scaffold()
    text = read(dir, ".codex/config.toml")
    assert_true(String.contains?(text, "[mcp_servers.gandora]"))
    assert_true(String.contains?(text, "command = \"uv\""))
    assert_true(String.contains?(text, "args = [\"run\", \"gan\", \"mcp\"]"))
    cleanup(dir)
  end

  # the command carries no paths on purpose: a checked-in config has to
  # work for everyone who clones, on any machine (GEP-0028-R012)
  test "no config carries an absolute path or a cwd" do
    dir = scaffold()
    Enum.each([".mcp.json", "opencode.json", ".codex/config.toml"], fn name ->
      text = read(dir, name)
      assert_false(String.contains?(text, dir))
      assert_false(String.contains?(text, "cwd"))
    end)
    cleanup(dir)
  end

  # gan-mcp must resolve from the project's own .venv, so it is a dev
  # dependency of every project the scaffold creates (GEP-0013-R003)
  test "gan-mcp is a dev dependency of the new project" do
    dir = scaffold()
    assert_true(String.contains?(read(dir, "pyproject.toml"), "gandora-mcp>="))
    cleanup(dir)
  end

  # joining a project that already has a pyproject: init keeps it, so the
  # MCP configs it writes would reference a dependency nobody added —
  # naming what to add is what keeps the wiring from being dead
  test "joining a foreign project names the dependencies to add" do
    tmp = tempfile.mkdtemp(prefix: "gan-join-")
    File.write!(Path.join(tmp, "pyproject.toml"),
      "[project]\nname = \"foreign\"\nversion = \"0.1.0\"\ndependencies = []\n")
    {said, _status} = System.cmd(gan_bin(), ["init", tmp], [stderr_to_stdout: true])
    assert_true(String.contains?(said, "kept existing pyproject.toml"))
    assert_true(String.contains?(said, "gandora-std"))
    assert_true(String.contains?(said, "gandora-mcp"))
    # and the pyproject really was left alone
    kept = read(tmp, "pyproject.toml")
    assert_true(String.contains?(kept, "name = \"foreign\""))
    _ok = File.rm_rf!(tmp)
    nil
  end

  # init now owns both shapes (GEP-0013-R002): ganc carries no scaffold
  test "the package scaffold lays out a publishable project" do
    tmp = tempfile.mkdtemp(prefix: "gan-pkg-")
    target = Path.join(tmp, "acme-demo")
    _r = System.cmd(gan_bin(), ["init", "--package", target], [stderr_to_stdout: true])
    # jsonc carries comments, so this one is read as text
    conf = read(target, "gandora.jsonc")
    assert_true(String.contains?(conf, "\"outDir\": \"pkg\""))
    assert_true(String.contains?(conf, "\"package\": true"))
    # the distribution name becomes the python package and the module
    core = read(target, "src/acme_demo/core.gan")
    assert_true(String.contains?(core, "defmodule AcmeDemo.Core do"))
    # the fence and the interpolation hole survived the template
    assert_true(String.contains?(core, "@example \"\"\""))
    assert_true(String.contains?(core, "\#{name}"))
    # a package wires the agents too
    assert_true(File.exists?(Path.join(target, ".mcp.json")))
    _ok = File.rm_rf!(tmp)
    nil
  end

  # re-running is how an existing project acquires new scaffold files —
  # it must never refuse and never overwrite (GEP-0013-R002)
  test "re-running init fills gaps without touching what is there" do
    dir = scaffold()
    File.write!(dir |> Path.join("src") |> Path.join("main.gan"),
      "defmodule Main do\n  def main(), do: nil\nend\n")
    File.rm_rf!(Path.join(dir, ".mcp.json"))
    {_out, status} = System.cmd(gan_bin(), ["init", dir], [stderr_to_stdout: true])
    assert_eq(status, 0)
    # the gap is filled...
    assert_true(File.exists?(Path.join(dir, ".mcp.json")))
    # ...and the file the user edited is untouched
    assert_true(String.contains?(read(dir, "src/main.gan"), "def main(), do: nil"))
    cleanup(dir)
  end

  # agent-instruction wiring (GEP-0028-R012A): create when absent,
  # append the marked section when present, point CLAUDE.md at it —
  # idempotent, user prose untouched
  test "a fresh project is born with AGENTS.md" do
    dir = scaffold()
    text = read(dir, "AGENTS.md")
    assert_true(String.contains?(text, "<!-- gandora:begin -->"))
    assert_true(String.contains?(text, "gan_verify"))
    cleanup(dir)
  end

  test "existing AGENTS.md and CLAUDE.md gain the wiring without losses" do
    dir = scaffold()
    File.write!(Path.join(dir, "AGENTS.md"), "# House rules\n\nBe kind.\n")
    File.write!(Path.join(dir, "CLAUDE.md"), "# Project notes\n")
    _r = System.cmd(gan_bin(), ["init", dir], [stderr_to_stdout: true])
    agents = read(dir, "AGENTS.md")
    assert_true(String.contains?(agents, "Be kind."))
    assert_true(String.contains?(agents, "<!-- gandora:begin -->"))
    claude = read(dir, "CLAUDE.md")
    assert_true(String.contains?(claude, "@AGENTS.md"))
    # a third run changes nothing: the markers gate both appends
    _r2 = System.cmd(gan_bin(), ["init", dir], [stderr_to_stdout: true])
    assert_eq(read(dir, "AGENTS.md"), agents)
    assert_eq(read(dir, "CLAUDE.md"), claude)
    cleanup(dir)
  end

  # the scaffold faces the verdict it will be judged by, from birth
  test "the generated entry module carries its annotations" do
    dir = scaffold()
    main = read(dir, "src/main.gan")
    Enum.each(["@moduledoc", "@doc", "@spec main() :: nil"], fn ann ->
      assert_true(String.contains?(main, ann))
    end)
    cleanup(dir)
  end
end
