defmodule TestFmtCli do
  @moduledoc """
  The gan fmt CLI contract (GEP-0016 conformance): fixture
  canonicalization, idempotency, --check/--diff/stdin exit codes —
  run by `gan test`.
  """
  @moduledoc_trans zh_CN: "gan fmt 的 CLI 契约(GEP-0016 conformance):fixture 规范化、幂等、--check/--diff/stdin 退出码——gan test 运行。"

  use Test

  pyimport tempfile
  pyimport sys

  defp gan_bin() do
    sys.executable |> Path.dirname() |> Path.join("gan")
  end

  defp fixtures() do
    File.cwd!() |> Path.join("tests") |> Path.join("fmt")
  end

  defp fresh_tree() do
    tmp = tempfile.mkdtemp(prefix: "gan-fmtcli-")
    src = Path.join(tmp, "src")
    File.mkdir_p!(src)
    messy = fixtures() |> Path.join("messy.gan.in") |> File.read!()
    File.write!(Path.join(src, "m.gan"), messy)
    tmp
  end

  defp run_fmt(args, cwd) do
    System.cmd(gan_bin(), ["fmt"] ++ args, [cd: cwd, stderr_to_stdout: true])
  end

  describe "gan fmt" do
    test "check exits 1 on a messy tree and writes nothing" do
      tmp = fresh_tree()
      m = tmp |> Path.join("src") |> Path.join("m.gan")
      before = File.read!(m)
      {_out, status} = run_fmt(["--check", "src"], tmp)
      assert status == 1
      assert File.read!(m) == before
    end

    test "formats to the canonical fixture, idempotently" do
      tmp = fresh_tree()
      m = tmp |> Path.join("src") |> Path.join("m.gan")
      {_out, status} = run_fmt(["src"], tmp)
      assert status == 0
      got = File.read!(m)
      want = fixtures() |> Path.join("canonical.gan") |> File.read!()
      assert got == want
      assert String.contains?(got, "&($math.sqrt/1)")
      assert String.contains?(got, "  docs stay put\n")
      {out2, _status2} = run_fmt(["src"], tmp)
      assert String.contains?(out2, "0 file(s) reformatted")
      {_out3, status3} = run_fmt(["--check", "src"], tmp)
      assert status3 == 0
    end

    test "stdin formats to stdout with exit 0" do
      tmp = fresh_tree()
      File.write!(Path.join(tmp, "messy.txt"),
        "defmodule S do\n    def a(x),   do: x\nend\n")
      {out, status} = System.cmd("sh",
        ["-c", gan_bin() <> " fmt - < messy.txt"], [cd: tmp])
      assert status == 0
      assert String.contains?(out, "def a(x), do: x")
    end

    test "diff shows changes without touching the file" do
      tmp = fresh_tree()
      messy = "defmodule S do\n    def a(x),   do: x\nend\n"
      m = tmp |> Path.join("src") |> Path.join("messy.gan")
      File.write!(m, messy)
      {out, status} = run_fmt(["--diff", "src/messy.gan"], tmp)
      assert status == 1
      assert String.contains?(out, "-    def a(x)")
      assert File.read!(m) == messy
    end
  end

  describe "verification safety net" do
    test "verify accepts identity and refuses corruption" do
      assert Fmt.verify("x = 1  # keep\n", "x = 1  # keep\n") == :ok
      {:error, why} = Fmt.verify("x = 1  # keep\n", "x = 1  # changed\n")
      assert String.contains?(why, "comment")
      {:error, _} = Fmt.verify("x = 1\n", "x = 2\n")
      nil
    end
  end
end
