defmodule PyIntel do
  @moduledoc """
  Python-side intelligence for gan-lsp (GEP-0015): jedi answers hover,
  completion, definition, and signatures for `$module` references and
  `pyimport` aliases, resolved in the project's own environment.
  """

  pyimport jedi

  import Safe

  @pyimport_re ~r/pyimport\s+([A-Za-z0-9_.]+)(?:\s*,\s*as:\s*([a-z_][A-Za-z0-9_]*))?/

  @doc "The alias -> module map from the file's pyimport declarations."
  @doc_trans zh_CN: "从文件的 pyimport 声明得到 别名 -> 模块 映射。"
  @example """
      gan> PyIntel.aliases("pyimport numpy, as: np")
      {'np': 'numpy'}
  """
  @param source, "The Gandora source holding pyimport declarations."
  @spec aliases(string()) :: map(string(), string())
  def aliases(source) do
    # `as:` binds the alias; a bare pyimport binds the first segment
    @pyimport_re.findall(source)
    |> Enum.reduce(%{}, fn {mod, name}, acc ->
      key = if name == "" do
        Enum.at(mod.split("."), 0)
      else
        name
      end
      Map.put(acc, key, mod)
    end)
  end

  @doc "The {import_line, expr} pair for a `$mod.chain` or aliased `np.chain` token."
  @doc_trans zh_CN: "为 `$mod.chain` 或别名 `np.chain` 引用给出 {import_line, expr}。"
  @param source, "The Gandora source, for alias resolution."
  @param token, "The dotted reference under the cursor."
  @param pyref, "Whether the token was written with a leading $."
  @spec target(string(), string(), boolean()) :: tuple(string(), string()) | nil
  def target(source, token, pyref) do
    first = Enum.at(token.split("."), 0)
    cond do
      pyref ->
        {"import " <> first, token}
      Map.has_key?(aliases(source), first) ->
        mod = Map.get(aliases(source), first)
        {"import " <> mod <> " as " <> first, token}
      true -> nil
    end
  end

  defp script(root, import_line, expr) do
    jedi.Script("#{import_line}\n#{expr}", project: jedi.Project(root))
  end

  @doc "Markdown hover for a Python reference, from its jedi docstring."
  @doc_trans zh_CN: "Python 引用的 Markdown 悬停文档，取自 jedi docstring。"
  @param root, "The project root jedi resolves in."
  @param import_line, "The synthesized import statement."
  @param expr, "The dotted expression to document."
  @spec hover_markdown(string(), string(), string()) :: string() | nil
  def hover_markdown(root, import_line, expr) do
    try do
      names = $builtins.list(script(root, import_line, expr).help(2, String.length(expr)))
      case names do
        [] -> nil
        [n | _] ->
          doc = n.docstring()
          if doc.strip() == "" do
            "`#{expr}` — Python `#{n.type}`"
          else
            shown = doc.split("\n") |> Enum.take(40) |> Enum.join("\n")
            "**`#{expr}`** — Python #{n.type}\n\n```text\n#{shown.strip()}\n```"
          end
      end
    rescue
      _e -> nil
    end
  end

  @doc "Member completions for a dotted Python prefix (at most 120)."
  @doc_trans zh_CN: "点号 Python 前缀的成员补全（最多 120 项）。"
  @param root, "The project root jedi resolves in."
  @param import_line, "The synthesized import statement."
  @param expr, "The dotted prefix to complete."
  @spec complete(string(), string(), string()) :: list(map())
  def complete(root, import_line, expr) do
    safe(
      $builtins.list(script(root, import_line, expr).complete(2, String.length(expr)))
      |> Enum.take(120)
      |> Enum.map(fn c -> %{name: c.name, kind: c.type} end),
      [])
  end

  @doc "The defining source location of a Python reference, zero-based for LSP."
  @doc_trans zh_CN: "Python 引用的定义位置，从零计数以适配 LSP。"
  @param root, "The project root jedi resolves in."
  @param import_line, "The synthesized import statement."
  @param expr, "The dotted reference to locate."
  @spec goto(string(), string(), string()) :: map() | nil
  def goto(root, import_line, expr) do
    try do
      names = $builtins.list(
        script(root, import_line, expr).goto(2, String.length(expr), follow_imports: true)
      )
      case names do
        [] -> nil
        [n | _] ->
          if is_nil(n.module_path) or is_nil(n.line) do
            nil
          else
            %{path: to_string(n.module_path), line0: n.line - 1, col0: or_zero(n.column)}
          end
      end
    rescue
      _e -> nil
    end
  end

  @doc "Call signatures for a Python callable, with first-line docs."
  @doc_trans zh_CN: "Python 可调用对象的调用签名，附文档首行。"
  @param root, "The project root jedi resolves in."
  @param import_line, "The synthesized import statement."
  @param callee, "The callable whose signatures to fetch."
  @spec signatures(string(), string(), string()) :: list(map())
  def signatures(root, import_line, callee) do
    safe(
      $builtins.list(
        script(root, import_line, callee <> "()").get_signatures(2, String.length(callee) + 1)
      )
      |> Enum.map(fn s ->
        params = $builtins.list(s.params) |> Enum.map(fn p -> p.to_string() end)
        %{label: s.to_string(), params: params, doc: to_first_line(s.docstring(raw: true))}
      end),
      [])
  end

  @doc """
  The inferred type of `var` inside compiled function `fn_names` (first
  match wins) of the generated Python source (GEP-0015-R011).
  """
  @doc_trans zh_CN: "在生成的 Python 源中推断 `var` 于 `fn_names` 首个匹配函数内的类型（GEP-0015-R011）。"
  @param source_py, "The generated Python source."
  @param fn_names, "Candidate compiled function names; the first match wins."
  @param var, "The variable to infer."
  @spec infer_type(string(), sequence(string()), string()) :: string() | nil
  def infer_type(source_py, fn_names, var) do
    try do
      lines = source_py.split("\n")
      start = Enum.find_index(lines, fn l ->
        Enum.any?(fn_names, fn n -> l.startswith("def " <> n <> "(") end)
      end)
      if is_nil(start) do
        nil
      else
        find_and_infer(source_py, lines, start, var)
      end
    rescue
      _e -> nil
    end
  end

  defp find_and_infer(source_py, lines, start, var) do
    pattern = $re.compile("\\b" <> $re.escape(var) <> "\\b")
    total = Enum.count(lines)
    hit = scan_lines(start, start, lines, pattern, total)
    if is_nil(hit) do
      nil
    else
      {line1, col} = hit
      names = $builtins.list(jedi.Script(source_py).infer(line1, col))
      case names do
        [] -> nil
        [n | _] -> n.name
      end
    end
  end

  defp scan_lines(i, start, lines, pattern, total) do
    cond do
      i >= total -> nil
      i > start and Enum.at(lines, i).startswith("def ") -> nil
      true ->
        m = pattern.search(Enum.at(lines, i))
        if is_nil(m) do
          recur(i + 1, start, lines, pattern, total)
        else
          {s, _e} = m.span()
          {i + 1, s}
        end
    end
  end

  defp to_first_line(text) do
    line = text.strip().split("\n") |> Enum.at(0)
    if is_nil(line) do
      ""
    else
      line
    end
  end

  defp or_zero(v) do
    if is_nil(v) do
      0
    else
      v
    end
  end
end
