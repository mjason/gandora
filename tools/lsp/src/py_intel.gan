defmodule PyIntel do
  @moduledoc """
  Python-side intelligence for gan-lsp (GEP-0015): jedi answers hover,
  completion, definition, and signatures for `$module` references and
  `pyimport` aliases, resolved in the project's own environment.
  """

  pyimport jedi

  @pyimport_re ~r/pyimport\s+([A-Za-z0-9_.]+)\s*,\s*as:\s*([a-z_][A-Za-z0-9_]*)/

  # alias -> module map from the file's pyimport declarations
  def aliases(source) do
    @pyimport_re.findall(source)
    |> Enum.reduce(%{}, fn {mod, name}, acc -> Map.put(acc, name, mod) end)
  end

  # {import_line, expr} for a `$mod.chain` or aliased `np.chain` token
  def target(source, token, pyref) do
    first = Enum.at(token.split("."), 0)
    cond do
      pyref ->
        {"import " <> first, token}
      Map.has_key?(aliases(source), first) ->
        mod = Map.get(aliases(source), first)
        {"import " <> mod <> " as " <> first, token}
      true -> nil
    end
  end

  defp script(root, import_line, expr) do
    jedi.Script("#{import_line}\n#{expr}", project: jedi.Project(root))
  end

  def hover_markdown(root, import_line, expr) do
    try do
      names = $builtins.list(script(root, import_line, expr).help(2, String.length(expr)))
      case names do
        [] -> nil
        [n | _] ->
          doc = n.docstring()
          if doc.strip() == "" do
            "`#{expr}` — Python `#{n.type}`"
          else
            shown = doc.split("\n") |> Enum.take(40) |> Enum.join("\n")
            "**`#{expr}`** — Python #{n.type}\n\n```text\n#{shown.strip()}\n```"
          end
      end
    rescue
      _e -> nil
    end
  end

  def complete(root, import_line, expr) do
    try do
      $builtins.list(script(root, import_line, expr).complete(2, String.length(expr)))
      |> Enum.take(120)
      |> Enum.map(fn c -> %{name: c.name, kind: c.type} end)
    rescue
      _e -> []
    end
  end

  # zero-based line/character, ready for LSP positions
  def goto(root, import_line, expr) do
    try do
      names = $builtins.list(
        script(root, import_line, expr).goto(2, String.length(expr), follow_imports: true)
      )
      case names do
        [] -> nil
        [n | _] ->
          if is_nil(n.module_path) or is_nil(n.line) do
            nil
          else
            %{path: to_string(n.module_path), line0: n.line - 1, col0: or_zero(n.column)}
          end
      end
    rescue
      _e -> nil
    end
  end

  def signatures(root, import_line, callee) do
    try do
      $builtins.list(
        script(root, import_line, callee <> "()").get_signatures(2, String.length(callee) + 1)
      )
      |> Enum.map(fn s ->
        params = $builtins.list(s.params) |> Enum.map(fn p -> p.to_string() end)
        %{label: s.to_string(), params: params, doc: to_first_line(s.docstring(raw: true))}
      end)
    rescue
      _e -> []
    end
  end

  defp to_first_line(text) do
    line = text.strip().split("\n") |> Enum.at(0)
    if is_nil(line) do
      ""
    else
      line
    end
  end

  defp or_zero(v) do
    if is_nil(v) do
      0
    else
      v
    end
  end
end
