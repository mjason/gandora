defmodule Lsc do
  @moduledoc """
  gan-lsc: the Language Server Console (GEP-0015-R001A) — language
  intelligence as one JSON value per query, for AI agents and shells.
  """

  pyimport gandora_core, as: core
  pyimport json
  pyimport pathlib
  pyimport sys
  pyimport os

  @usage """
  gan lsc <query> — one JSON value on stdout

  Queries (each accepts --root <dir>, default: cwd):
    version                     compiler/library version
    diagnostics <file>          full-pipeline diagnostics
    ast <file>                  quoted term of the source
    expand <file>               quoted term after macro expansion
    compile <file>              generated Python source (plain text)
    resolve <module>            how a module reference resolves
    pack [<Mod> ...]            one-call agent context: std lists, project
                                signatures, construct index, verdict summary;
                                named modules ride along with full docs
    doc <target> [...] [--brief]  docs for one or many targets; --brief = one line each
    definition <Mod>[.<fun>]    defining source path/line/col
    symbols <Mod>               every definition with rendered heads
    references <Mod>.<fun>      every project call site (+ definitions)
    wsymbols [<query>]          project-wide symbol search
    check                       the project verdict: {diagnostics, suggestions}
    pydoc <mod.chain>           Python docstring for a $-style reference
    pycomplete <mod.prefix>     Python member completions
    pygoto <mod.chain>          Python source location
    pysig <mod.fun>             Python call signatures
  """

  @doc "Entry: parses --root, dispatches one query, emits one JSON value."
  @spec main() :: nil
  def main() do
    args = $builtins.list(sys.argv) |> Enum.drop(1)
    {root, args} = take_root(args)
    try do
      dispatch(args, root)
    rescue
      e in core.CompileError ->
        parts = $builtins.list(e.args)
        emit(%{
          "error" => Enum.at(parts, 0),
          "path" => Enum.at(parts, 1),
          "line" => Enum.at(parts, 2),
          "col" => Enum.at(parts, 3)
        })
        sys.exit(1)
      e ->
        # never a bare traceback: every failure is one JSON value
        emit(%{"error" => "#{$builtins.type(e).__name__}: #{to_string(e)}"})
        sys.exit(2)
    end
  end

  defp dispatch(args, root) do
    case args do
      ["version" | _] ->
        emit(%{"version" => core.version()})
      ["diagnostics", file | _] ->
        emit(core.diagnostics(read(file), file, root))
      ["ast", file | _] ->
        emit(core.parse(read(file), file))
      ["expand", file | _] ->
        emit(core.expand(read(file), file, root))
      ["compile", file | _] ->
        IO.puts(core.compile_string(read(file), file, root))
      ["resolve", module | _] ->
        emit(core.resolve(root, module))
      ["doc", target | rest] ->
        # many targets in one call; --brief trims each to one line
        # (GEP-0026-R001/R002)
        brief = Enum.member?(rest, "--brief")
        targets = [target] ++ Enum.filter(rest, fn a ->
          not String.starts_with?(a, "--")
        end)
        results = Enum.map(targets, fn t -> doc_one(t, root, brief) end)
        if Enum.count(targets) == 1 do
          emit(Enum.at(results, 0))
        else
          emit(results)
        end
      ["definition", target | _] ->
        emit(core.definition(target, root))
      ["symbols", module | rest] ->
        mods = [module] ++ Enum.filter(rest, fn a ->
          not String.starts_with?(a, "--")
        end)
        if Enum.count(mods) == 1 do
          emit(core.symbols(module, root))
        else
          pairs = for m <- mods, do: {m, core.symbols(m, root)}
          emit(Map.new(pairs))
        end
      ["pack" | rest] ->
        # the one-call agent context (GEP-0026-R003)
        deep = Enum.filter(rest, fn a -> not String.starts_with?(a, "--") end)
        emit(ContextPack.build(root, deep))
      ["references", target | _] ->
        emit(core.references(target, root))
      ["wsymbols", query | _] ->
        emit(core.wsymbols(query, root))
      ["wsymbols"] ->
        emit(core.wsymbols("", root))
      ["check" | rest] ->
        diags = core.check(root)
        # artifact verification (GEP-0025-R008) joins the verdict when
        # the project already compiles; --strict adds type-flow warnings
        errors0 = Enum.filter(diags, fn d -> Map.get(d, "severity") == "error" end)
        diags = if Enum.empty?(errors0) do
          cache = os.path.join(root, ".gandora", "cache")
          verification = try do
            modules = core.build(root, cache)
            Verifier.verify(root, cache, modules, Enum.member?(rest, "--strict"))
          rescue
            _e -> []
          end
          diags ++ verification
        else
          diags
        end
        files = try do
          core.wsymbols("", root)
          |> Enum.map(fn sym -> Map.get(sym, "path") end)
          |> Enum.uniq()
        rescue
          _e ->
            # a parse-broken file must not silence the whole verdict
            $builtins.list(pathlib.Path(root).glob("src/**/*.gan"))
            |> Enum.map(&to_string/1)
        end
        # tests are part of the project surface too (Advisor pass only —
        # their compile diagnostics belong to `gan test`)
        # top-level only, mirroring what `gan test` runs — deeper
        # directories hold fixtures, not tests
        test_files = $builtins.list(pathlib.Path(root).glob("tests/*.gan"))
        |> Enum.map(&to_string/1)
        suggestions = Enum.flat_map(Enum.uniq(files ++ test_files), fn path ->
          text = try do
            read(path)
          rescue
            _e -> ""
          end
          per_file = Enum.filter(diags, fn d -> Map.get(d, "path") == path end)
          (Advisor.analyze(text, root) ++ Advisor.lint_hints(text, per_file))
          |> Enum.map(fn h -> Map.put(h, "path", path) end)
        end)
        |> Advisor.consolidate()
        errors = Enum.filter(diags, fn d -> Map.get(d, "severity") == "error" end)
        emit(%{
          "ok" => Enum.empty?(errors),
          "clean" => Enum.empty?(errors) and Enum.empty?(diags) and Enum.empty?(suggestions),
          "diagnostics" => diags,
          "suggestions" => suggestions
        })
        if not Enum.empty?(errors) do
          sys.exit(1)
        end
      ["pydoc", chain | _] ->
        emit(PyIntel.hover_markdown(root, import_line(chain), chain))
      ["pycomplete", chain | _] ->
        emit(PyIntel.complete(root, import_line(chain), chain))
      ["pygoto", chain | _] ->
        emit(PyIntel.goto(root, import_line(chain), chain))
      ["pysig", chain | _] ->
        emit(PyIntel.signatures(root, import_line(chain), chain))
      _ ->
        IO.puts(@usage)
        sys.exit(2)
    end
  end

  # one doc lookup: project/std docs, construct cards, then pydoc
  defp doc_one(target, root, brief) do
    info = core.doc(target, root)
    card = ConstructDocs.card(target)
    cond do
      not is_nil(info) and brief -> brief_doc(target, info)
      not is_nil(info) -> info
      not is_nil(card) ->
        %{"label" => target, "construct" => card}
      String.match?(target, ~r/^[a-z_][a-z0-9_.]*$/) ->
        # a bare project/std name (macros included) before Python docs
        project = project_doc(target, root)
        if not is_nil(project) do
          project
        else
          md = PyIntel.hover_markdown(root, import_line(target), target)
          if is_nil(md) do
            nil
          else
            %{"label" => target, "pydoc" => md}
          end
        end
      true -> nil
    end
  end

  # exact-name search across the project's symbols; resolves the
  # owning module and returns its full doc (GEP-0026)
  defp project_doc(name, root) do
    syms = try do
      core.wsymbols(name, root)
    rescue
      _e -> []
    end
    hit = Enum.find(syms, fn s -> Map.get(s, "name") == name end)
    if is_nil(hit) do
      nil
    else
      core.doc("#{Map.get(hit, "module")}.#{name}", root)
    end
  end

  # one line per item: the spec (or label) plus the first doc sentence
  defp brief_doc(target, info) do
    specs = Map.get(info, "specs", [])
    head = if Enum.empty?(specs), do: target, else: Enum.at(specs, 0)
    prose = Map.get(Map.get(info, "entries", %{}), "default", "")
    summary = Enum.at(prose.split("\n"), 0)
    %{"label" => target, "head" => head, "summary" => summary}
  end

  @doc "The import statement that brings a dotted Python chain into scope."
  @example """
      gan> Lsc.import_line("os.path.join")
      'import os'
  """
  @param chain, "The dotted `$module`-style reference."
  @spec import_line(string()) :: string()
  def import_line(chain) do
    "import " <> Enum.at(chain.split("."), 0)
  end

  defp take_root(args) do
    case Enum.find_index(args, fn a -> a == "--root" end) do
      nil -> {$os.getcwd(), args}
      i ->
        root = Enum.at(args, i + 1)
        {root, Enum.take(args, i) ++ Enum.drop(args, i + 2)}
    end
  end

  defp read(file), do: pathlib.Path(file).read_text()

  defp emit(value), do: IO.puts(json.dumps(value))
end
