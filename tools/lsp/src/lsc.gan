defmodule Lsc do
  @moduledoc """
  gan-lsc: the Language Server Console (GEP-0015-R001A) — language
  intelligence as one JSON value per query, for AI agents and shells.
  Each query is declared as a `@command` annotation on its handler
  (GEP-0008, via the gandora-tool `Cli` hook): the usage text and the
  dispatch read one accumulated table and cannot drift.
  """

  pyimport gandora_core, as: core
  pyimport json

  import Safe
  require Cli

  defattr :command
  defattr :command_table, accumulate: true

  @on_definition Cli.on_command

  @doc "Entry: parses --root, dispatches one query, emits one JSON value."
  @spec main() :: nil
  def main() do
    {root, args} = take_root(System.argv())
    try do
      run(args, root)
    rescue
      e in core.CompileError ->
        parts = $builtins.list(e.args)
        emit(%{
          "error" => Enum.at(parts, 0),
          "path" => Enum.at(parts, 1),
          "line" => Enum.at(parts, 2),
          "col" => Enum.at(parts, 3)
        })
        System.halt(1)
      e ->
        # never a bare traceback: every failure is one JSON value
        emit(%{"error" => "#{$builtins.type(e).__name__}: #{to_string(e)}"})
        System.halt(2)
    end
  end

  defp run([cmd | rest], root) do
    hit = Enum.find(queries(), fn {{token, _argspec, _help}, _f} -> token == cmd end)
    case hit do
      nil -> usage_halt()
      {_entry, f} -> f.(rest, root)
    end
  end

  defp run([], _root), do: usage_halt()

  # the query table the hook accumulated — dispatch and usage share it
  defp queries(), do: @command_table

  defp usage_halt() do
    IO.puts("gan lsc <query> — one JSON value on stdout")
    IO.puts("")
    IO.puts("Queries (each accepts --root <dir>, default: cwd):")
    IO.puts(Cli.usage("", queries()))
    System.halt(2)
  end

  # the arguments that are not flags: targets, modules, queries
  defp positional(args) do
    Enum.filter(args, fn a -> not String.starts_with?(a, "--") end)
  end

  @command {"version", "", "compiler/library version"}
  defp version_q(_rest, _root), do: emit(%{"version" => core.version()})

  @command {"diagnostics", "<file>", "full-pipeline diagnostics"}
  defp diagnostics_q([file | _], root), do: file |> read() |> core.diagnostics(file, root) |> emit()
  defp diagnostics_q([], _root), do: usage_halt()

  @command {"ast", "<file>", "quoted term of the source"}
  defp ast_q([file | _], _root), do: file |> read() |> core.parse(file) |> emit()
  defp ast_q([], _root), do: usage_halt()

  @command {"expand", "<file>", "quoted term after macro expansion"}
  defp expand_q([file | _], root), do: file |> read() |> core.expand(file, root) |> emit()
  defp expand_q([], _root), do: usage_halt()

  @command {"compile", "<file>", "generated Python source (plain text)"}
  defp compile_q([file | _], root), do: file |> read() |> core.compile_string(file, root) |> IO.puts()
  defp compile_q([], _root), do: usage_halt()

  @command {"resolve", "<module>", "how a module reference resolves"}
  defp resolve_q([module | _], root), do: emit(core.resolve(root, module))
  defp resolve_q([], _root), do: usage_halt()

  @command {"pack", "[<Mod> ...]", "one-call agent context: std lists, project\nsignatures, construct index, verdict summary;\nnamed modules ride along with full docs (GEP-0026-R003)"}
  defp pack_q(rest, root), do: emit(ContextPack.build(root, positional(rest)))

  @command {"map", "[<Mod>] [--query <words>]", "the code atlas: project modules + doc-signed heads,\ninstalled packages with shipped .gan sources, docs;\n--query ranks the definitions themselves by BM25 (GEP-0031)"}
  defp map_q(rest, root) do
    args = positional(rest)
    if Enum.member?(rest, "--query") do
      emit(Retrieval.symbols_ranked(root, Enum.join(args, " ")))
    else
      needle = Enum.at(args, 0)
      emit(Atlas.build(root, if(is_nil(needle), do: "", else: needle)))
    end
  end

  @command {"find", "<pattern> [--deps]", "corpus files whose name matches (glob with */?,\nsubstring otherwise); --deps adds installed sources (GEP-0031)"}
  defp find_q([pattern | rest], root), do: emit(Retrieval.find(root, pattern, Enum.member?(rest, "--deps")))
  defp find_q([], _root), do: usage_halt()

  @command {"grep", "<pattern> [--ranked] [--deps]", "content search: regex (rg-accelerated), or BM25\nranking with --ranked; --deps adds installed sources (GEP-0031)"}
  defp grep_q([pattern | rest], root) do
    deps = Enum.member?(rest, "--deps")
    if Enum.member?(rest, "--ranked") do
      emit(Retrieval.ranked(root, pattern, deps))
    else
      emit(Retrieval.grep(root, pattern, deps))
    end
  end

  defp grep_q([], _root), do: usage_halt()

  @command {"read", "<path|Mod|Mod.fun> [from to]", "one precise read: a line range, a whole module,\nor one definition's block with its annotations (GEP-0031)"}
  defp read_q([target | rest], root) do
    span = positional(rest)
    from = span |> Enum.at(0) |> line_or_zero()
    to = span |> Enum.at(1) |> line_or_zero()
    emit(Retrieval.read(root, target, from, to))
  end

  defp read_q([], _root), do: usage_halt()

  defp line_or_zero(arg) do
    if is_nil(arg), do: 0, else: safe($builtins.int(arg), 0)
  end

  @command {"doc", "<target> [...] [--brief]", "docs for one or many targets; --brief = one line each"}
  defp doc_q([target | rest], root) do
    # many targets in one call; --brief trims each to one line
    # (GEP-0026-R001/R002)
    brief = Enum.member?(rest, "--brief")
    targets = [target] ++ positional(rest)
    results = Enum.map(targets, fn t -> doc_one(t, root, brief) end)
    if Enum.count(targets) == 1 do
      emit(Enum.at(results, 0))
    else
      emit(results)
    end
  end

  defp doc_q([], _root), do: usage_halt()

  @command {"definition", "<Mod>[.<fun>]", "defining source path/line/col"}
  defp definition_q([target | _], root), do: emit(core.definition(target, root))
  defp definition_q([], _root), do: usage_halt()

  @command {"symbols", "<Mod> [...]", "every definition with rendered heads"}
  defp symbols_q([module | rest], root) do
    mods = [module] ++ positional(rest)
    if Enum.count(mods) == 1 do
      emit(core.symbols(module, root))
    else
      mods
      |> Enum.map(fn m -> {m, core.symbols(m, root)} end)
      |> Map.new()
      |> emit()
    end
  end

  defp symbols_q([], _root), do: usage_halt()

  @command {"references", "<Mod>.<fun>", "every project call site (+ definitions)"}
  defp references_q([target | _], root), do: emit(core.references(target, root))
  defp references_q([], _root), do: usage_halt()

  @command {"wsymbols", "[<query>]", "project-wide symbol search"}
  defp wsymbols_q([query | _], root), do: emit(core.wsymbols(query, root))
  defp wsymbols_q([], root), do: emit(core.wsymbols("", root))

  @command {"check", "[--strict]", "the project verdict: {diagnostics, suggestions}"}
  defp check_q(rest, root) do
    diags = core.check(root)
    # artifact verification (GEP-0025-R008) joins the verdict when
    # the project already compiles; --strict adds type-flow warnings
    errors0 = Enum.filter(diags, fn d -> Map.get(d, "severity") == "error" end)
    diags = if Enum.empty?(errors0) do
      cache = Path.join(root, ".gandora/cache")
      verification = safe(
        Verifier.verify(root, cache, core.build(root, cache),
          Enum.member?(rest, "--strict")),
        [])
      diags ++ verification
    else
      diags
    end
    # a parse-broken file must not silence the whole verdict: fall
    # back to globbing when the symbol walk dies
    files = safe(
      core.wsymbols("", root)
      |> Enum.map(fn sym -> Map.get(sym, "path") end)
      |> Enum.uniq(),
      Path.wildcard(Path.join(root, "src/**/*.gan")))
    # tests are part of the project surface too (Advisor pass only —
    # their compile diagnostics belong to `gan test`); top-level
    # only, mirroring what `gan test` runs — deeper directories
    # hold fixtures, not tests
    test_files = Path.wildcard(Path.join(root, "tests/*.gan"))
    suggestions = Enum.flat_map(Enum.uniq(files ++ test_files), fn path ->
      text = safe(read(path), "")
      per_file = Enum.filter(diags, fn d -> Map.get(d, "path") == path end)
      (Advisor.analyze(text, root) ++ Advisor.lint_hints(text, per_file))
      |> Enum.map(fn h -> Map.put(h, "path", path) end)
    end)
    |> Advisor.consolidate()
    errors = Enum.filter(diags, fn d -> Map.get(d, "severity") == "error" end)
    emit(%{
      "ok" => Enum.empty?(errors),
      "clean" => Enum.empty?(errors) and Enum.empty?(diags) and Enum.empty?(suggestions),
      "diagnostics" => diags,
      "suggestions" => suggestions
    })
    if not Enum.empty?(errors) do
      System.halt(1)
    end
  end

  @command {"pydoc", "<mod.chain>", "Python docstring for a $-style reference"}
  defp pydoc_q([chain | _], root), do: emit(PyIntel.hover_markdown(root, import_line(chain), chain))
  defp pydoc_q([], _root), do: usage_halt()

  @command {"pycomplete", "<mod.prefix>", "Python member completions"}
  defp pycomplete_q([chain | _], root), do: emit(PyIntel.complete(root, import_line(chain), chain))
  defp pycomplete_q([], _root), do: usage_halt()

  @command {"pygoto", "<mod.chain>", "Python source location"}
  defp pygoto_q([chain | _], root), do: emit(PyIntel.goto(root, import_line(chain), chain))
  defp pygoto_q([], _root), do: usage_halt()

  @command {"pysig", "<mod.fun>", "Python call signatures"}
  defp pysig_q([chain | _], root), do: emit(PyIntel.signatures(root, import_line(chain), chain))
  defp pysig_q([], _root), do: usage_halt()

  # one doc lookup: project/std docs, construct cards, then pydoc
  defp doc_one(target, root, brief) do
    info = core.doc(target, root)
    info = if is_nil(info), do: symbol_stub(target, root), else: info
    card = ConstructDocs.card(target)
    cond do
      not is_nil(info) and brief -> brief_doc(target, info)
      not is_nil(info) -> info
      not is_nil(card) ->
        %{"label" => target, "construct" => card}
      String.match?(target, ~r/^[a-z_][a-z0-9_.]*$/) ->
        # a bare project/std name (macros included) before Python docs
        project = project_doc(target, root)
        if not is_nil(project) do
          project
        else
          md = PyIntel.hover_markdown(root, import_line(target), target)
          if is_nil(md) do
            nil
          else
            %{"label" => target, "pydoc" => md}
          end
        end
      true -> nil
    end
  end

  # an undocumented def/defmacro still deserves an answer: its head,
  # plus the recipe for documenting it
  defp symbol_stub(target, root) do
    parts = target.rsplit(".", 1)
    if Enum.count(parts) != 2 do
      nil
    else
      mod = Enum.at(parts, 0)
      name = Enum.at(parts, 1)
      syms = safe(core.symbols(mod, root), [])
      hit = Enum.find(syms, fn s -> Map.get(s, "name") == name end)
      if is_nil(hit) do
        nil
      else
        %{
          "label" => target,
          "kind" => Map.get(hit, "kind"),
          "head" => Map.get(hit, "head"),
          "entries" => %{"default" => "(undocumented — add @doc above the #{Map.get(hit, "kind")})"}
        }
      end
    end
  end

  # exact-name search across the project's symbols; resolves the
  # owning module and returns its full doc (GEP-0026)
  defp project_doc(name, root) do
    syms = safe(core.wsymbols(name, root), [])
    hit = Enum.find(syms, fn s -> Map.get(s, "name") == name end)
    if is_nil(hit) do
      nil
    else
      core.doc("#{Map.get(hit, "module")}.#{name}", root)
    end
  end

  # one line per item: the spec (or label) plus the first doc sentence
  defp brief_doc(target, info) do
    specs = Map.get(info, "specs", [])
    head = if Enum.empty?(specs), do: target, else: Enum.at(specs, 0)
    prose = Map.get(Map.get(info, "entries", %{}), "default", "")
    summary = Enum.at(prose.split("\n"), 0)
    %{"label" => target, "head" => head, "summary" => summary}
  end

  @doc "The import statement that brings a dotted Python chain into scope."
  @example """
      gan> Lsc.import_line("os.path.join")
      'import os'
  """
  @param chain, "The dotted `$module`-style reference."
  @spec import_line(string()) :: string()
  def import_line(chain) do
    "import " <> Enum.at(chain.split("."), 0)
  end

  defp take_root(args) do
    case Enum.find_index(args, fn a -> a == "--root" end) do
      nil -> {File.cwd!(), args}
      i ->
        root = Enum.at(args, i + 1)
        {root, Enum.take(args, i) ++ Enum.drop(args, i + 2)}
    end
  end

  defp read(file), do: File.read!(file)

  defp emit(value), do: IO.puts(json.dumps(value))
end
