defmodule Main do
  @moduledoc """
  gan-lsp: the Gandora language server on pygls (GEP-0015).
  pygls owns protocol machinery; this module owns language logic:
  push diagnostics on every edit, documentation hover (signatures,
  translations, examples, `$module` references, language constructs),
  go-to-definition, document symbols, `Module.` completion, and
  whole-document formatting through the GEP-0016 engine.
  """

  pyimport gandora_core, as: core
  pyimport lsprotocol.types, as: types
  pyimport os

  @server $pygls.lsp.server.LanguageServer("gan-lsp", "0.13.0",
    text_document_sync_kind: $lsprotocol.types.TextDocumentSyncKind.Full)

  @word_re ~r/[A-Za-z_][A-Za-z0-9_.!?]*/

  # ---- lifecycle + diagnostics (GEP-0015-R002/R003) ------------------------

  @decorate @server.feature($lsprotocol.types.TEXT_DOCUMENT_DID_OPEN)
  def did_open(params) do
    publish(params.text_document.uri, params.text_document.text)
  end

  @decorate @server.feature($lsprotocol.types.TEXT_DOCUMENT_DID_CHANGE)
  def did_change(params) do
    text = Enum.at($builtins.list(params.content_changes), -1).text
    publish(params.text_document.uri, text)
  end

  @decorate @server.feature($lsprotocol.types.TEXT_DOCUMENT_DID_CLOSE)
  def did_close(params) do
    send_diagnostics(params.text_document.uri, [])
  end

  defp send_diagnostics(uri, items) do
    @server.text_document_publish_diagnostics(
      $lsprotocol.types.PublishDiagnosticsParams(uri: uri, diagnostics: items)
    )
  end

  defp publish(uri, text) do
    path = String.replace(uri, "file://", "")
    root = @server.workspace.root_path
    diags = try do
      core.diagnostics(text, path, root)
    rescue
      _e -> []
    end
    lsp = Enum.map(diags, fn d ->
      line = Enum.max([Map.get(d, "line") - 1, 0])
      col = Enum.max([Map.get(d, "col") - 1, 0])
      pos = types.Position(line: line, character: col)
      types.Diagnostic(
        range: types.Range(pos, pos),
        message: Map.get(d, "message"),
        severity: severity(Map.get(d, "severity")),
        source: "gan"
      )
    end)
    send_diagnostics(uri, lsp)
  end

  defp severity("error"), do: $lsprotocol.types.DiagnosticSeverity.Error
  defp severity(_), do: $lsprotocol.types.DiagnosticSeverity.Warning

  # ---- shared cursor resolution --------------------------------------------

  defp doc_and_line(params) do
    doc = @server.workspace.get_text_document(params.text_document.uri)
    line = Enum.at(doc.source.split("\n"), params.position.line)
    {doc, line}
  end

  @spec word_at(string(), integer()) :: tuple(string(), integer()) | nil
  # the reference whose span covers the column, with its start column
  defp word_at(line, character) do
    hit = Enum.find(@word_re.finditer(line), fn m ->
      {s, e} = m.span()
      s <= character and character < e
    end)
    if is_nil(hit) do
      nil
    else
      {s, _e} = hit.span()
      {hit.group(0).rstrip("."), s}
    end
  end

  @spec module_of(string()) :: string() | nil
  defp module_of(source) do
    m = ~r/defmodule\s+([A-Za-z0-9_.]+)/.search(source)
    if is_nil(m) do
      nil
    else
      m.group(1)
    end
  end

  @spec target_of(string(), string()) :: string() | nil
  # "Stats.mean" as written; bare lowercase names resolve in-module
  defp target_of(source, token) do
    cond do
      String.match?(token, ~r/^[A-Z]/) -> token
      true ->
        mod = module_of(source)
        if is_nil(mod) do
          nil
        else
          "#{mod}.#{token}"
        end
    end
  end

  # ---- hover (GEP-0015-R005) -----------------------------------------------

  # construct cards live in ConstructDocs (shared with lsc)

  @decorate @server.feature($lsprotocol.types.TEXT_DOCUMENT_HOVER)
  def hover(params) do
    {doc, line} = doc_and_line(params)
    hit = word_at(line, params.position.character)
    if is_nil(hit) do
      nil
    else
      {token, start} = hit
      pyref = start > 0 and String.slice(line, start - 1, 1) == "$"
      bounded = start > 1 and String.slice(line, start - 2, 2) == "$("
      # `|> .method()` / `"lit".method()`: a Python method on the value
      # to the left — a construct card, not a variable to infer
      postfix = start > 0 and String.slice(line, start - 1, 1) == "." and not pyref
      py = if bounded do
        {"import " <> token, token}
      else
        PyIntel.target(doc.source, token, pyref)
      end
      cond do
        postfix and is_nil(py) ->
          markdown_hover(
            "`.#{token}()` — calls the Python method `#{token}` on the value " <>
              "to its left; `|> .#{token}()` pipes into it (GEP-0001 postfix chain)."
          )
        not is_nil(py) ->
          {import_line, expr} = py
          md = PyIntel.hover_markdown(root_path(), import_line, expr)
          cond do
            not is_nil(md) -> markdown_hover(md)
            pyref -> pyref_hover(token)
            true -> nil
          end
        not is_nil(ConstructDocs.card(token)) ->
          markdown_hover("`#{token}`\n\n#{ConstructDocs.card(token)}")
        true ->
          target = target_of(doc.source, token)
          info = lookup_doc(target)
          h = render_hover(target, info)
          if is_nil(h) and String.match?(token, ~r/^[a-z_]/) do
            var_hover(doc, token, params.position.line)
          else
            h
          end
      end
    end
  end

  # local-variable hover: infer from the compiled Python (GEP-0015-R011)
  defp var_hover(doc, token, cursor_line) do
    mod = module_of(doc.source)
    compiled = try do
      core.compile_string(doc.source, String.replace(doc.uri, "file://", ""), root_path())
    rescue
      _e -> nil
    end
    if is_nil(compiled) or is_nil(mod) do
      nil
    else
      syms = try do
        core.symbols(mod, root_path())
      rescue
        _e -> []
      end
      holder = syms
      |> Enum.filter(fn s -> Map.get(s, "line") <= cursor_line + 1 end)
      |> Enum.at(-1)
      if is_nil(holder) do
        nil
      else
        base = py_name(Map.get(holder, "name"))
        py_var = py_name(token)
        t = PyIntel.infer_type(compiled, [base, "_" <> base], py_var)
        # jedi echoing the name back means it found nothing to infer
        if is_nil(t) or t == py_var or t == token do
          nil
        else
          markdown_hover("`#{token}`: `#{t}` *(inferred)*")
        end
      end
    end
  end

  defp py_name(name) do
    name.replace("?", "_p").replace("!", "_bang")
  end

  @spec root_path() :: string()
  defp root_path() do
    @server.workspace.root_path
  end

  defp lookup_doc(target) do
    if is_nil(target) do
      nil
    else
      try do
        core.doc(target, @server.workspace.root_path)
      rescue
        _e -> nil
      end
    end
  end

  defp pyref_hover(token) do
    mod = Enum.at(token.split("."), 0)
    spec = try do
      $importlib.util.find_spec(mod)
    rescue
      _e -> nil
    end
    if is_nil(spec) do
      markdown_hover("`$#{mod}` — Python module (not found in this environment)")
    else
      markdown_hover("`$#{mod}` — Python module\n\n`#{spec.origin}`")
    end
  end

  defp markdown_hover(md) do
    types.Hover(
      contents: types.MarkupContent(
        kind: $lsprotocol.types.MarkupKind.Markdown,
        value: md
      )
    )
  end

  # hover locale preference (GEP-0015-R015): the developer-local
  # project file first, then the environment (which the VS Code
  # setting feeds). Unset means the default language only; a set
  # locale renders that language with per-item fallback to the
  # default; "all" opts into every language in sections.
  @spec doc_locale() :: string()
  defp doc_locale() do
    local = try do
      core.local_pref(root_path(), "docLocale")
    rescue
      _e -> nil
    end
    if is_nil(local) do
      os.environ.get("GAN_DOC_LOCALE", "default")
    else
      local
    end
  end

  # the prose + localized parameter list for one locale
  @spec locale_section(map(), string(), string()) :: string()
  defp locale_section(info, locale, heading) do
    prose = Map.get(Map.get(info, "entries", %{}), locale)
    prose = if is_nil(prose) and locale != "default" do
      nil
    else
      prose
    end
    parts = [heading, prose] ++ param_lines(info, locale)
    parts
    |> Enum.reject(fn p -> is_nil(p) or p == "" end)
    |> Enum.join("\n\n")
  end

  defp render_hover(target, info) do
    if is_nil(info) or info.get("hidden") do
      nil
    else
      tco = case Map.get(info, "tco") do
        "loop" -> ["♻ *tail recursion → compiles to a `while` loop (constant stack)*"]
        "stack" -> ["⚠ *self-recursive → native call stack (not tail position)*"]
        _ -> []
      end
      sigs = Map.get(info, "signatures", [])
      |> Enum.uniq()
      |> Enum.join("\n")
      header = if sigs == "" do
        "### #{target}"
      else
        "```elixir\n#{sigs}\n```"
      end
      entries = Map.get(info, "entries", %{})
      pref = doc_locale()
      locales = entries.keys()
      |> Enum.filter(fn loc -> loc != "default" end)
      |> Enum.sort()
      sections = cond do
        pref == "all" or pref == "" ->
          [locale_section(info, "default", "")] ++
            Enum.map(locales, fn loc ->
              "---\n\n**#{loc}**\n\n" <> locale_section(info, loc, "")
            end)
        true ->
          # one language only; default fills any gap
          main = locale_section(info, pref, "")
          if String.trim(main) == "" do
            [locale_section(info, "default", "")]
          else
            [main]
          end
      end
      meta = Map.get(info, "meta", [])
      |> Enum.map(fn {k, v} -> "`#{k}`: #{v}" end)
      examples = Map.get(info, "examples", [])
      |> Enum.map(fn ex -> "```elixir\n#{ex.strip()}\n```" end)
      body = tco ++ sections ++ meta ++ examples
      |> Enum.reject(fn part -> is_nil(part) or String.trim(part) == "" end)
      |> Enum.join("\n\n")
      if String.trim(body) == "" and sigs == "" do
        nil
      else
        markdown_hover("#{header}\n\n#{body}")
      end
    end
  end

  # localized parameter bullets with per-name fallback to the default
  @spec param_lines(map(), string()) :: list(string())
  defp param_lines(info, locale) do
    entries = Map.get(info, "params", [])
    if Enum.empty?(entries) do
      []
    else
      heading = if String.starts_with?(locale, "zh") do
        "**参数**"
      else
        "**Parameters**"
      end
      lines = entries
      |> Enum.map(fn p ->
        texts = Map.get(p, "entries", %{})
        text = Map.get(texts, locale, Map.get(texts, "default", ""))
        "- `#{Map.get(p, "name")}` — #{text}"
      end)
      |> Enum.join("\n")
      [heading <> "\n\n" <> lines]
    end
  end

  defp param_doc(info, label) do
    name = Enum.at(label.split(" "), 0) |> $builtins.str() |> (fn s -> s.rstrip(",") end).()
    entry = Map.get(info, "params", [])
    |> Enum.find(fn p -> Map.get(p, "name") == name end)
    if is_nil(entry) do
      nil
    else
      texts = Map.get(entry, "entries", %{})
      pref = doc_locale()
      Map.get(texts, pref, Map.get(texts, "default"))
    end
  end

  # ---- go to definition (GEP-0015-R006) ------------------------------------

  @decorate @server.feature($lsprotocol.types.TEXT_DOCUMENT_DEFINITION)
  def definition(params) do
    {doc, line} = doc_and_line(params)
    hit = word_at(line, params.position.character)
    if is_nil(hit) do
      nil
    else
      {token, start} = hit
      pyref = start > 0 and String.slice(line, start - 1, 1) == "$"
      bounded = start > 1 and String.slice(line, start - 2, 2) == "$("
      py = if bounded do
        {"import " <> token, token}
      else
        PyIntel.target(doc.source, token, pyref)
      end
      if not is_nil(py) do
        {import_line, expr} = py
        loc = PyIntel.goto(root_path(), import_line, expr)
        if is_nil(loc) do
          nil
        else
          pos = types.Position(
            line: Map.get(loc, :line0),
            character: Map.get(loc, :col0)
          )
          types.Location(
            uri: "file://" <> Map.get(loc, :path),
            range: types.Range(pos, pos)
          )
        end
      else
        target = target_of(doc.source, token)
        loc = if is_nil(target) do
          nil
        else
          try do
            core.definition(target, root_path())
          rescue
            _e -> nil
          end
        end
        if is_nil(loc) do
          nil
        else
          pos = types.Position(
            line: Enum.max([Map.get(loc, "line") - 1, 0]),
            character: Enum.max([Map.get(loc, "col") - 1, 0])
          )
          types.Location(
            uri: "file://" <> Map.get(loc, "path"),
            range: types.Range(pos, pos)
          )
        end
      end
    end
  end

  # ---- document symbols (GEP-0015-R008) ------------------------------------

  @decorate @server.feature($lsprotocol.types.TEXT_DOCUMENT_DOCUMENT_SYMBOL)
  def document_symbol(params) do
    doc = @server.workspace.get_text_document(params.text_document.uri)
    mod = module_of(doc.source)
    syms = if is_nil(mod) do
      []
    else
      try do
        core.symbols(mod, @server.workspace.root_path)
      rescue
        _e -> []
      end
    end
    children = Enum.map(syms, fn s ->
      line = Enum.max([Map.get(s, "line") - 1, 0])
      pos = types.Position(line: line, character: 0)
      rng = types.Range(pos, pos)
      types.DocumentSymbol(
        name: Map.get(s, "name"),
        detail: Map.get(s, "head"),
        kind: symbol_kind(Map.get(s, "kind")),
        range: rng,
        selection_range: rng
      )
    end)
    if is_nil(mod) do
      []
    else
      zero = types.Position(line: 0, character: 0)
      [types.DocumentSymbol(
        name: mod,
        kind: $lsprotocol.types.SymbolKind.Module,
        range: types.Range(zero, zero),
        selection_range: types.Range(zero, zero),
        children: children
      )]
    end
  end

  defp symbol_kind("defmacro"), do: $lsprotocol.types.SymbolKind.Constructor
  defp symbol_kind("defp"), do: $lsprotocol.types.SymbolKind.Method
  defp symbol_kind(_), do: $lsprotocol.types.SymbolKind.Function

  # ---- references + rename (GEP-0015-R012) ---------------------------------

  @spec fun_target_at(term(), string(), integer()) :: string() | nil
  # the Module.fun target under the cursor, or nil for non-functions
  defp fun_target_at(doc, line, character) do
    hit = word_at(line, character)
    if is_nil(hit) do
      nil
    else
      {token, _start} = hit
      last = Enum.at(token.split("."), -1)
      if String.match?(last, ~r/^[a-z_]/) do
        target_of(doc.source, token)
      else
        nil
      end
    end
  end

  # precise (path, line0, start_col, end_col) for each project reference —
  # the name token located on its source line
  @spec ref_ranges(string()) :: list(map())
  defp ref_ranges(target) do
    fun = Enum.at(target.split("."), -1)
    refs = try do
      core.references(target, root_path())
    rescue
      _e -> []
    end
    Enum.map(refs, fn r ->
      path = Map.get(r, "path")
      line0 = Enum.max([Map.get(r, "line") - 1, 0])
      col0 = Enum.max([Map.get(r, "col") - 1, 0])
      text = try do
        $pathlib.Path(path).read_text(encoding: "utf-8")
      rescue
        _e -> ""
      end
      l = Enum.at(text.split("\n"), line0)
      l = if is_nil(l) do "" else l end
      idx = l.find(fun, col0)
      idx = if idx < 0 do l.find(fun) else idx end
      start = if idx < 0 do col0 else idx end
      %{path: path, line: line0, start: start,
        stop: start + String.length(fun), is_def: Map.get(r, "is_def")}
    end)
  end

  @decorate @server.feature($lsprotocol.types.TEXT_DOCUMENT_REFERENCES)
  def references(params) do
    {doc, line} = doc_and_line(params)
    target = fun_target_at(doc, line, params.position.character)
    if is_nil(target) do
      nil
    else
      include_defs = params.context.include_declaration
      ref_ranges(target)
      |> Enum.filter(fn r -> include_defs or not Map.get(r, "is_def") end)
      |> Enum.map(fn r ->
        types.Location(
          uri: "file://" <> Map.get(r, "path"),
          range: types.Range(
            types.Position(line: Map.get(r, "line"), character: Map.get(r, "start")),
            types.Position(line: Map.get(r, "line"), character: Map.get(r, "stop"))
          )
        )
      end)
    end
  end

  @decorate @server.feature($lsprotocol.types.TEXT_DOCUMENT_RENAME)
  def rename(params) do
    {doc, line} = doc_and_line(params)
    target = fun_target_at(doc, line, params.position.character)
    new_name = params.new_name
    cond do
      is_nil(target) -> nil
      not String.match?(new_name, ~r/^[a-z_][A-Za-z0-9_]*[?!]?$/) -> nil
      true ->
        ranges = ref_ranges(target)
        # only rename what this project defines — a target without a
        # definition here lives in a dependency
        if Enum.any?(ranges, fn r -> Map.get(r, "is_def") end) do
          edits = Enum.reduce(ranges, %{}, fn r, acc ->
            uri = "file://" <> Map.get(r, "path")
            edit = types.TextEdit(
              range: types.Range(
                types.Position(line: Map.get(r, "line"), character: Map.get(r, "start")),
                types.Position(line: Map.get(r, "line"), character: Map.get(r, "stop"))
              ),
              new_text: new_name
            )
            Map.put(acc, uri, Map.get(acc, uri, []) ++ [edit])
          end)
          types.WorkspaceEdit(changes: edits)
        else
          nil
        end
    end
  end

  # ---- workspace symbols (GEP-0015-R013) -----------------------------------

  @decorate @server.feature($lsprotocol.types.WORKSPACE_SYMBOL)
  def workspace_symbol(params) do
    syms = try do
      core.wsymbols(params.query, root_path())
    rescue
      _e -> []
    end
    Enum.map(syms, fn s ->
      line = Enum.max([Map.get(s, "line") - 1, 0])
      pos = types.Position(line: line, character: 0)
      types.SymbolInformation(
        name: Map.get(s, "module") <> "." <> Map.get(s, "name"),
        kind: symbol_kind(Map.get(s, "kind")),
        location: types.Location(
          uri: "file://" <> Map.get(s, "path"),
          range: types.Range(pos, pos)
        )
      )
    end)
  end

  # ---- quick fixes for compiler lints (GEP-0015-R014) ----------------------

  @decorate @server.feature(
    $lsprotocol.types.TEXT_DOCUMENT_CODE_ACTION,
    $lsprotocol.types.CodeActionOptions(
      code_action_kinds: [$lsprotocol.types.CodeActionKind.QuickFix]
    )
  )
  def code_action(params) do
    uri = params.text_document.uri
    doc = @server.workspace.get_text_document(uri)
    $builtins.list(params.context.diagnostics)
    |> Enum.flat_map(fn d ->
      msg = d.message
      cond do
        String.contains?(msg, "GEP-0019-R007") ->
          [allow_action(uri, doc, d, "stack_recursion")]
        String.contains?(msg, "GEP-0022-R005") ->
          [allow_action(uri, doc, d, "unused_function")]
        String.contains?(msg, "GEP-0022-R002") ->
          underscore_actions(uri, doc, d, msg)
        true -> []
      end
    end)
  end

  defp allow_action(uri, doc, d, target) do
    line0 = d.range.start.line
    l = Enum.at(doc.source.split("\n"), line0)
    l = if is_nil(l) do "" else l end
    indent = String.slice(l, 0, String.length(l) - String.length(l.lstrip()))
    pos = types.Position(line: line0, character: 0)
    types.CodeAction(
      title: "Acknowledge with @allow :" <> target,
      kind: $lsprotocol.types.CodeActionKind.QuickFix,
      diagnostics: [d],
      edit: types.WorkspaceEdit(changes: %{
        uri => [types.TextEdit(
          range: types.Range(pos, pos),
          new_text: indent <> "@allow :" <> target <> "\n"
        )]
      })
    )
  end

  defp underscore_actions(uri, doc, d, msg) do
    m = ~r/variable ([A-Za-z0-9_?!]+) is bound/.search(msg)
    if is_nil(m) do
      []
    else
      var = m.group(1)
      line0 = d.range.start.line
      l = Enum.at(doc.source.split("\n"), line0)
      l = if is_nil(l) do "" else l end
      hit = ~r/\b#{$re.escape(var)}\b/.search(l)
      if is_nil(hit) do
        []
      else
        {s, e} = hit.span()
        [types.CodeAction(
          title: "Rename to _" <> var,
          kind: $lsprotocol.types.CodeActionKind.QuickFix,
          diagnostics: [d],
          edit: types.WorkspaceEdit(changes: %{
            uri => [types.TextEdit(
              range: types.Range(
                types.Position(line: line0, character: s),
                types.Position(line: line0, character: e)
              ),
              new_text: "_" <> var
            )]
          })
        )]
      end
    end
  end

  # ---- completion: `Module.` members (GEP-0015-R008) -----------------------

  @decorate @server.feature(
    $lsprotocol.types.TEXT_DOCUMENT_COMPLETION,
    $lsprotocol.types.CompletionOptions(trigger_characters: ["."])
  )
  def completion(params) do
    {doc, line} = doc_and_line(params)
    prefix = String.slice(line, 0, params.position.character)
    pym = ~r/(\$?)([A-Za-z_][A-Za-z0-9_.]*)\.([A-Za-z0-9_]*)$/.search(prefix)
    py = if is_nil(pym) do
      nil
    else
      PyIntel.target(doc.source, pym.group(2) <> "." <> pym.group(3), pym.group(1) == "$")
    end
    if not is_nil(py) do
      {import_line, expr} = py
      PyIntel.complete(root_path(), import_line, expr)
      |> Enum.map(fn c ->
        types.CompletionItem(
          label: Map.get(c, :name),
          kind: py_completion_kind(Map.get(c, :kind))
        )
      end)
    else
      gandora_completion(prefix)
    end
  end

  defp py_completion_kind("function"), do: $lsprotocol.types.CompletionItemKind.Function
  defp py_completion_kind("class"), do: $lsprotocol.types.CompletionItemKind.Class
  defp py_completion_kind("module"), do: $lsprotocol.types.CompletionItemKind.Module
  defp py_completion_kind("instance"), do: $lsprotocol.types.CompletionItemKind.Value
  defp py_completion_kind(_), do: $lsprotocol.types.CompletionItemKind.Field

  defp gandora_completion(prefix) do
    m = ~r/([A-Z][A-Za-z0-9_]*(?:\.[A-Z][A-Za-z0-9_]*)*)\.([a-z_][A-Za-z0-9_]*)?$/.search(prefix)
    if is_nil(m) do
      []
    else
      mod = m.group(1)
      partial = if is_nil(m.group(2)) do
        ""
      else
        m.group(2)
      end
      syms = try do
        core.symbols(mod, @server.workspace.root_path)
      rescue
        _e -> []
      end
      syms
      |> Enum.filter(fn s -> Map.get(s, "kind") != "defp" end)
      |> Enum.filter(fn s -> Map.get(s, "name").startswith(partial) end)
      |> Enum.reduce([], fn s, acc ->
        if Enum.any?(acc, fn a -> Map.get(a, "name") == Map.get(s, "name") end) do
          acc
        else
          acc ++ [s]
        end
      end)
      |> Enum.map(fn s ->
        types.CompletionItem(
          label: Map.get(s, "name"),
          kind: $lsprotocol.types.CompletionItemKind.Function,
          detail: Map.get(s, "head"),
          documentation: Map.get(s, "doc")
        )
      end)
    end
  end

  defp split_walk({i, depth, cur, acc}, inner) do
    if i >= String.length(inner) do
      acc ++ [cur]
    else
      ch = String.slice(inner, i, 1)
      cond do
        ch == "(" or ch == "[" or ch == "{" -> recur({i + 1, depth + 1, cur <> ch, acc}, inner)
        ch == ")" or ch == "]" or ch == "}" -> recur({i + 1, depth - 1, cur <> ch, acc}, inner)
        ch == "," and depth == 0 -> recur({i + 1, depth, "", acc ++ [cur]}, inner)
        true -> recur({i + 1, depth, cur <> ch, acc}, inner)
      end
    end
  end

  # ---- formatting through the GEP-0016 engine (GEP-0015-R007) --------------

  @decorate @server.feature($lsprotocol.types.TEXT_DOCUMENT_FORMATTING)
  def formatting(params) do
    doc = @server.workspace.get_text_document(params.text_document.uri)
    result = Fmt.format_text(doc.source)
    case result do
      {:ok, new} ->
        if new == doc.source or Fmt.verify(doc.source, new) != :ok do
          []
        else
          line_count = Enum.count(doc.source.split("\n"))
          [types.TextEdit(
            range: types.Range(
              types.Position(line: 0, character: 0),
              types.Position(line: line_count, character: 0)
            ),
            new_text: new
          )]
        end
      _ -> []
    end
  end

  # ---- signature help (GEP-0015-R008) --------------------------------------

  @decorate @server.feature(
    $lsprotocol.types.TEXT_DOCUMENT_SIGNATURE_HELP,
    $lsprotocol.types.SignatureHelpOptions(trigger_characters: ["(", ","])
  )
  def signature_help(params) do
    {doc, line} = doc_and_line(params)
    prefix = String.slice(line, 0, params.position.character)
    call = open_call(prefix)
    if is_nil(call) do
      nil
    else
      {callee, active} = call
      pyref = String.starts_with?(callee, "$")
      token = callee.lstrip("$")
      py = PyIntel.target(doc.source, token, pyref)
      sigs = cond do
        not is_nil(py) ->
          {import_line, expr} = py
          PyIntel.signatures(root_path(), import_line, expr)
          |> Enum.map(fn s ->
            build_signature(Map.get(s, :label), Map.get(s, :params), Map.get(s, :doc))
          end)
        true ->
          target = target_of(doc.source, token)
          info = lookup_doc(target)
          gandora_signatures(info)
      end
      if Enum.empty?(sigs) do
        nil
      else
        types.SignatureHelp(
          signatures: sigs,
          active_signature: 0,
          active_parameter: active
        )
      end
    end
  end

  # the innermost unclosed call before the cursor: {callee, arg_index}
  defp open_call(prefix) do
    found = scan_call({String.length(prefix) - 1, 0, 0}, prefix)
    if is_nil(found) do
      nil
    else
      {open_at, commas} = found
      head = String.slice(prefix, 0, open_at)
      m = ~r/(\$?[A-Za-z_][A-Za-z0-9_.!?]*)\s*$/.search(head)
      if is_nil(m) do
        nil
      else
        {m.group(1), commas}
      end
    end
  end

  defp scan_call({i, depth, commas}, prefix) do
    if i < 0 do
      nil
    else
      ch = String.slice(prefix, i, 1)
      cond do
        ch == ")" or ch == "]" or ch == "}" -> recur({i - 1, depth + 1, commas}, prefix)
        ch == "[" or ch == "{" -> recur({i - 1, Enum.max([depth - 1, 0]), commas}, prefix)
        ch == "," and depth == 0 -> recur({i - 1, depth, commas + 1}, prefix)
        ch == "(" and depth == 0 -> {i, commas}
        ch == "(" -> recur({i - 1, depth - 1, commas}, prefix)
        true -> recur({i - 1, depth, commas}, prefix)
      end
    end
  end

  defp build_signature(label, params, docline) do
    types.SignatureInformation(
      label: label,
      documentation: docline,
      parameters: Enum.map(params, fn p ->
        types.ParameterInformation(label: p)
      end)
    )
  end

  defp gandora_signatures(info) do
    if is_nil(info) do
      []
    else
      prose = Map.get(info, "entries", %{}) |> Map.get("default")
      docline = if is_nil(prose) do
        nil
      else
        prose.strip().split("\n") |> Enum.at(0)
      end
      specs = Map.get(info, "specs", [])
      heads = Map.get(info, "signatures", []) |> Enum.uniq()
      label_doc = if Enum.empty?(specs) do
        docline
      else
        specs |> Enum.join("\n")
      end
      Enum.map(heads, fn head ->
        params = head_params(head)
        types.SignatureInformation(
          label: head,
          documentation: label_doc,
          parameters: Enum.map(params, fn p ->
            types.ParameterInformation(label: p, documentation: param_doc(info, p))
          end)
        )
      end)
    end
  end

  # parameter labels from a rendered head like "def mean(xs, precision \\ 2)"
  defp head_params(head) do
    m = ~r/\((.*)\)/.search(head)
    if is_nil(m) do
      []
    else
      inner = m.group(1)
      split_top(inner)
    end
  end

  defp split_top(inner) do
    parts = split_walk({0, 0, "", []}, inner)
    parts |> Enum.map(fn p -> p.strip() end) |> Enum.reject(fn p -> p == "" end)
  end

  def main() do
    @server.start_io()
  end
end
