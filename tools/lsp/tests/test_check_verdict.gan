defmodule TestCheckVerdict do
  @moduledoc """
  BDD over the check verdict (GEP-0025): Given a source / When
  `gan lsc check` runs / Then assert the verdict — written in Gandora,
  organized with the ExUnit surface, run by `gan test`.
  """
  @moduledoc_trans zh_CN: "check 裁决 BDD(GEP-0025):Given 源码 / When gan lsc check / Then 断言 verdict——Gandora 写、ExUnit 表面组织、gan test 运行。"

  use Test

  pyimport json
  pyimport subprocess
  pyimport tempfile
  pyimport os
  pyimport pathlib
  pyimport sys

  @config "{\"source\": [\"src\"], \"outDir\": \"dist\", \"targetPython\": \"3.11\"}"

  @clean_module """
  defmodule Prog do
    @moduledoc "An idiomatic module — the check must stay silent."

    @doc "Doubles every element."
    @param xs, "The numbers."
    @spec double_all(sequence(number())) :: list(number())
    @example \"\"\"
        gan> Prog.double_all([1, 2])
        [2, 4]
    \"\"\"
    def double_all(xs), do: for x <- xs, do: x * 2
  end
  """

  defp lsc_bin() do
    $os.path.join($os.path.dirname(sys.executable), "gan-lsc")
  end

  # Given a source, When checked in a throwaway project,
  # Then {verdict-map, exit-code}
  defp check(source) do
    dir = tempfile.mkdtemp(prefix: "gan-bdd-")
    os.makedirs(os.path.join(dir, "src"), exist_ok: true)
    pathlib.Path(os.path.join(dir, "gandora.jsonc")).write_text(@config)
    pathlib.Path(os.path.join(dir, "src", "prog.gan")).write_text(source)
    link_venv(dir)
    r = subprocess.run([lsc_bin(), "check", "--root", dir],
      capture_output: true, text: true, timeout: 120, cwd: dir)
    {json.loads(r.stdout), r.returncode}
  end

  # a real project has a venv with gandora-std — mirror that so std
  # resolution and artifact verification (R008) behave as in the field
  defp link_venv(dir) do
    venv = os.path.dirname(os.path.dirname(sys.executable))
    if os.path.basename(venv) == ".venv" do
      os.symlink(venv, os.path.join(dir, ".venv"))
    end
  end

  defp kind_messages(verdict, kind) do
    for s <- Map.get(verdict, "suggestions", []), Map.get(s, "kind") == kind,
      do: Map.get(s, "message")
  end

  defp suggests?(verdict, kind, needle) do
    Enum.any?(kind_messages(verdict, kind), fn m -> String.contains?(m, needle) end)
  end

  defp diag?(verdict, needle) do
    Map.get(verdict, "diagnostics", [])
    |> Enum.any?(fn d -> String.contains?(Map.get(d, "message"), needle) end)
  end

  describe "verdict" do
    test "a clean idiomatic module is clean" do
      {v, rc} = check(@clean_module)
      assert rc == 0
      assert Map.get(v, "clean") == true
      assert Map.get(v, "suggestions") == []
    end

    test "an error flips ok and the exit code" do
      {v, rc} = check("defmodule Prog do\n  def f( do\nend")
      assert rc == 1
      assert Map.get(v, "ok") == false
    end

    test "warnings do not fail the check but break clean" do
      src = "defmodule Prog do\n  @moduledoc \"m\"\n  @doc \"d\"\n  @spec f(term(), term()) :: term()\n  @example \"\"\"\n      gan> 1\n      1\n  \"\"\"\n  def f(x, y), do: x\nend"
      {v, rc} = check(src)
      assert rc == 0
      assert Map.get(v, "ok") == true
      assert Map.get(v, "clean") == false
      assert diag?(v, "GEP-0022-R002")
    end
  end

  describe "did-you-mean" do
    test "misspelled std member suggests the real one" do
      {v, _rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def f(xs), do: Enum.mpa(xs, fn x -> x end)\nend")
      assert suggests?(v, "did_you_mean", "Enum.map")
    end

    test "undefined variable suggests its nearest binding" do
      {v, _rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def f(value), do: valeu\nend")
      assert suggests?(v, "did_you_mean", "`value`")
    end
  end

  describe "migration" do
    test "python habits get the gandora spelling" do
      {v, _rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def f(x) do\nreturn x\n  end\nend")
      assert suggests?(v, "migration", "no `return`")
    end

    test "None wants nil" do
      {v, _rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def f(), do: None\nend")
      assert suggests?(v, "migration", "`nil`")
    end

    test "Python-object guesses get the interop spelling" do
      {v, _rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def f(), do: Python.math.sqrt(4)\nend")
      assert suggests?(v, "migration", "$math")
    end

    test "comparing with nil wants is_nil" do
      {v, _rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def f(x), do: x == nil\nend")
      assert suggests?(v, "migration", "is_nil")
    end
  end

  describe "artifact verification (GEP-0025-R008)" do
    test "an undefined function is an error with a did-you-mean" do
      {v, rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def total(xs), do: Enum.sum(xs)\n  def main(), do: IO.puts(totl([1, 2]))\nend")
      assert rc == 1
      refute Map.get(v, "ok")
      assert diag?(v, "`totl`")
      assert diag?(v, "did you mean `total`")
    end

    test "a misspelled std member is an error, not just advice" do
      {v, rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def f(xs), do: Enum.mpa(xs, fn x -> x end)\nend")
      assert rc == 1
      refute Map.get(v, "ok")
      assert diag?(v, "no member")
    end

    test "verification findings map back to the gan source" do
      {v, _rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def main(), do: IO.puts(missing_helper(1))\nend")
      hit = Map.get(v, "diagnostics", [])
      |> Enum.find(fn d -> String.contains?(Map.get(d, "message"), "R008") end)
      assert not is_nil(hit)
      assert String.ends_with?(to_string(Map.get(hit, "path")), "prog.gan")
      assert Map.get(hit, "line") > 0
    end

    test "a wrong-arity call is an error at build time" do
      {v, rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def f(xs), do: Enum.chunk_every(xs, 3, 1, :discard)\nend")
      assert rc == 1
      refute Map.get(v, "ok")
      assert diag?(v, "R008")
    end

    test "a clean std-using program verifies clean" do
      src = "defmodule Prog do\n  @moduledoc \"m\"\n  @doc \"d\"\n  @spec f(sequence(integer())) :: integer()\n  @example \"\"\"\n      gan> Prog.f([1, 2])\n      3\n  \"\"\"\n  def f(xs), do: Enum.sum(xs)\nend"
      {v, rc} = check(src)
      assert rc == 0
      assert Map.get(v, "clean") == true
    end
  end

  describe "elixir reflexes" do
    test "Integer module habits get the built-in spelling" do
      {v, _rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def f(x), do: Integer.to_string(x)\nend")
      assert suggests?(v, "migration", "no `Integer` module")
    end

    test "Stream habits point at comprehensions" do
      {v, _rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def f(xs), do: Stream.map(xs, fn x -> x end)\nend")
      assert suggests?(v, "migration", "no `Stream` module")
    end

    test "bare Python exception names get the interop spelling" do
      {v, _rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def f() do\n    try do\n      1\n    rescue\n      e in ZeroDivisionError -> nil\n    end\n  end\nend")
      assert suggests?(v, "migration", "$builtins.ZeroDivisionError")
    end

    test "map-update on a struct teaches the struct spelling" do
      {v, _rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  defstruct [:age]\n  def f(p), do: %{p | age: 30}\nend")
      assert suggests?(v, "migration", "%Mod{x | field: v}")
    end

    test "dotted exception spellings stay silent" do
      src = "defmodule Prog do\n  @moduledoc \"m\"\n  @doc \"d\"\n  @spec f() :: term()\n  @example \"\"\"\n      gan> Prog.f()\n      1\n  \"\"\"\n  def f() do\n    try do\n      1\n    rescue\n      _e in $builtins.ValueError -> nil\n    end\n  end\nend"
      {v, _rc} = check(src)
      refute suggests?(v, "migration", "exceptions are spelled")
    end
  end

  describe "practice" do
    test "missing annotations become one consolidated report" do
      {v, _rc} = check("defmodule Prog do\n  def f(x), do: x\nend")
      assert suggests?(v, "practice", "@spec on: f")
      assert suggests?(v, "practice", "@moduledoc")
    end

    test "concrete containers in spec params want abstract ones" do
      src = "defmodule Prog do\n  @moduledoc \"m\"\n  @doc \"d\"\n  @spec f(list(integer())) :: list(integer())\n  @example \"\"\"\n      gan> 1\n      1\n  \"\"\"\n  def f(xs), do: xs\nend"
      {v, _rc} = check(src)
      assert suggests?(v, "practice", "abstract in, concrete out")
    end

    test "repeated value-level $refs want a pyimport" do
      src = "defmodule Prog do\n  @moduledoc \"m\"\n  @doc \"d\"\n  @spec f(term()) :: term()\n  @example \"\"\"\n      gan> 1\n      1\n  \"\"\"\n  def f(x), do: [$json.dumps(x), $json.dumps(x), $json.dumps(x)]\nend"
      {v, _rc} = check(src)
      assert suggests?(v, "practice", "pyimport json")
    end

    test "host types on @spec lines never count as $ref repetition" do
      src = "defmodule Prog do\n  @moduledoc \"m\"\n\n  pyimport pandas, as: pd\n\n  @doc \"d\"\n  @spec f($pandas.DataFrame()) :: $pandas.DataFrame()\n  @example \"\"\"\n      gan> 1\n      1\n  \"\"\"\n  def f(df), do: pd.concat([df])\n\n  @doc \"d\"\n  @spec g() :: $pandas.DataFrame()\n  def g(), do: pd.DataFrame()\nend"
      {v, _rc} = check(src)
      assert Map.get(v, "suggestions") == []
    end

    test "prose examples inside @doc teach @example" do
      src = "defmodule Prog do\n  @moduledoc \"m\"\n  @doc \"\"\"\n  Does things.\n\n  Example:\n\n      factor n: 168\n  \"\"\"\n  defmacro f(x) do\n    quote do\n      unquote(x)\n    end\n  end\nend"
      {v, _rc} = check(src)
      assert suggests?(v, "practice", "lives in @example")
    end

    test "count == 0 wants empty?" do
      {v, _rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def f(xs), do: Enum.count(xs) == 0\nend")
      assert suggests?(v, "practice", "Enum.empty?")
    end

    test "filter-then-map chains fuse into a comprehension" do
      {v, _rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def f(xs), do: xs |> Enum.filter(fn x -> x end) |> Enum.map(fn x -> x end)\nend")
      assert suggests?(v, "practice", "fuses")
    end

    test "map-then-filter has no for spelling and stays a pipeline" do
      {v, _rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def f(xs), do: xs |> Enum.map(fn x -> x end) |> Enum.filter(fn x -> x end)\nend")
      refute suggests?(v, "practice", "fuses")
    end
  end

  describe "lints" do
    test "stack recursion warning arrives with the verdict" do
      {v, _rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def fact(0), do: 1\n  def fact(n), do: n * fact(n - 1)\nend")
      assert diag?(v, "GEP-0019-R007")
    end

    test "tuple literal specs teach the tuple spelling" do
      src = "defmodule Prog do\n  @moduledoc \"m\"\n  @spec f(term()) :: {:ok, float()}\n  def f(x), do: {:ok, x}\nend"
      {v, _rc} = check(src)
      assert diag?(v, "tuple(atom(), x)")
    end

    test "spec type errors teach the correction" do
      {v, _rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  @spec f(Int) :: Int\n  def f(x), do: x\nend")
      assert diag?(v, "write integer()")
    end
  end

  describe "silence" do
    test "prose never triggers code patterns" do
      src = "defmodule Prog do\n  @moduledoc \"None shall return while lambda imports self.\"\n  @doc \"d\"\n  @spec f(term()) :: term()\n  @example \"\"\"\n      gan> 1\n      1\n  \"\"\"\n  def f(x), do: x\nend"
      {v, _rc} = check(src)
      assert kind_messages(v, "migration") == []
    end

    test "comments never trigger code patterns" do
      src = "defmodule Prog do\n  @moduledoc \"m\"\n  @doc \"d\"\n  @spec f(term()) :: term()\n  # return None while lambda\n  @example \"\"\"\n      gan> 1\n      1\n  \"\"\"\n  def f(x), do: x\nend"
      {v, _rc} = check(src)
      assert kind_messages(v, "migration") == []
    end
  end

  # multi-file scratch project: [{relpath, source}] -> {verdict, exit}
  defp check_files(files) do
    dir = tempfile.mkdtemp(prefix: "gan-bdd-")
    os.makedirs(os.path.join(dir, "src"), exist_ok: true)
    pathlib.Path(os.path.join(dir, "gandora.jsonc")).write_text(@config)
    Enum.each(files, fn {rel, source} ->
      p = pathlib.Path(os.path.join(dir, rel))
      p.parent.mkdir(parents: true, exist_ok: true)
      p.write_text(source)
    end)
    link_venv(dir)
    r = subprocess.run([lsc_bin(), "check", "--root", dir],
      capture_output: true, text: true, timeout: 120, cwd: dir)
    {json.loads(r.stdout), r.returncode}
  end

  describe "trust line (GEP-0025-R005)" do
    test "a test module is exempt from coverage nags" do
      {v, rc} = check_files([
        {"src/test_prog.gan", "defmodule TestProg do\n  def test_add(), do: 1 + 1\nend"}
      ])
      assert rc == 0
      assert kind_messages(v, "practice") == []
    end

    test "rescue _e is a deliberate swallow, not a bare rescue" do
      src = "defmodule Prog do\n  @moduledoc \"m\"\n  def f() do\n    try do\n      1\n    rescue\n      _e -> nil\n    end\n  end\nend"
      {v, _rc} = check(src)
      refute suggests?(v, "practice", "bare `rescue")
    end

    test "struct type refs in specs are never member typos" do
      src = "defmodule Prog do\n  @moduledoc \"m\"\n  @spec f(App.Shop()) :: App.Shop()\n  def f(s), do: s\nend"
      {v, _rc} = check(src)
      assert kind_messages(v, "did_you_mean") == []
    end

    test "dot-call wraps are not capture candidates" do
      src = "defmodule Prog do\n  @moduledoc \"m\"\n  def f(g, xs), do: Enum.map(xs, fn x -> g.(x) end)\nend"
      {v, _rc} = check(src)
      refute suggests?(v, "practice", "wraps a single call")
    end

    test "builtins repetition is the idiom" do
      src = "defmodule Prog do\n  @moduledoc \"m\"\n  def f(x), do: {$builtins.len(x), $builtins.min(x), $builtins.max(x)}\nend"
      {v, _rc} = check(src)
      refute suggests?(v, "practice", "$builtins")
    end

    test "nested paren sigils never leak their contents" do
      src = "defmodule Prog do\n  @moduledoc \"m\"\n  def f(xs), do: ~python(next((x for x in <%= xs %>), None))\nend"
      {v, _rc} = check(src)
      refute suggests?(v, "migration", "`nil`")
    end
  end

  describe "surface and consolidation (GEP-0025-R006/R007)" do
    test "identical messages consolidate across files with the spread" do
      files = [
        {"src/a.gan", "defmodule A do\n  def f(x), do: x\nend"},
        {"src/b.gan", "defmodule B do\n  def f(x), do: x\nend"}
      ]
      {v, _rc} = check_files(files)
      hits = Enum.filter(kind_messages(v, "practice"), fn m ->
        String.contains?(m, "No @example")
      end)
      assert Enum.count(hits) == 1
      assert String.contains?(Enum.at(hits, 0), "also in 1 other file(s)")
    end

    test "suggestions carry line anchors" do
      {v, _rc} = check("defmodule Prog do\n  @moduledoc \"m\"\n  def f(x), do: x\nend")
      anchored = Map.get(v, "suggestions", [])
      |> Enum.filter(fn s -> Map.get(s, "kind") == "practice" end)
      assert Enum.any?(anchored, fn s -> Map.get(s, "line", 0) > 0 end)
    end

    test "top-level tests are advised, fixture dirs are not" do
      files = [
        {"src/prog.gan", "defmodule Prog do\n  @moduledoc \"m\"\n  @doc \"d\"\n  @spec f(term()) :: term()\n  @example \"\"\"\n      gan> 1\n      1\n  \"\"\"\n  def f(x), do: x\nend"},
        {"tests/t.gan", "defmodule TestT do\n  def test_f() do\nreturn 1\n  end\nend"},
        {"tests/fixtures/fx.gan", "defmodule Fx do\n  def f() do\nreturn 2\n  end\nend"}
      ]
      {v, _rc} = check_files(files)
      migr = Map.get(v, "suggestions", [])
      |> Enum.filter(fn s -> Map.get(s, "kind") == "migration" end)
      paths = Enum.map(migr, fn s -> to_string(Map.get(s, "path", "")) end)
      assert Enum.any?(paths, fn p -> String.ends_with?(p, "tests/t.gan") end)
      refute Enum.any?(paths, fn p -> String.contains?(p, "fixtures") end)
    end
  end

  describe "gauntlet" do
    test "pure python verdicts as JSON" do
      {v, _rc} = check("import os\n\ndef main():\n    print(os.getcwd())")
      assert is_map(v)
    end

    test "javascript errors without crashing" do
      {v, rc} = check("const x = 5;\nfunction add(a, b) { return a + b; }")
      assert rc >= 1
      refute Map.get(v, "ok", false)
    end

    test "unclosed blocks and stray ends error cleanly" do
      {v1, rc1} = check("defmodule Prog do\n  def f(x) do\n    x\nend")
      assert rc1 >= 1
      refute Map.get(v1, "ok", false)
      {v2, rc2} = check("x = 1\nend\nend")
      assert rc2 >= 1
      refute Map.get(v2, "ok", false)
    end

    test "yaml sql and markdown paste verdicts as JSON" do
      {v1, _} = check("name: test\nsteps:\n  - run: gan build\n")
      assert is_map(v1)
      {v2, rc2} = check("SELECT * FROM users;")
      assert is_map(v2)
      assert rc2 >= 1
      {v3, rc3} = check("# Title\n\nSome *bold* claims\n")
      assert is_map(v3)
      assert rc3 >= 1
    end

    test "BEAM reflexes degrade to an error not a crash" do
      {v, _rc} = check("defmodule Prog do\n  def go() do\n    receive do\n      {:msg, x} -> x\n    end\n  end\nend")
      assert is_map(v)
    end

    test "non-UTF8 bytes are a JSON error" do
      dir = tempfile.mkdtemp(prefix: "gan-bdd-")
      os.makedirs(os.path.join(dir, "src"), exist_ok: true)
      pathlib.Path(os.path.join(dir, "gandora.jsonc")).write_text(@config)
      pathlib.Path(os.path.join(dir, "src", "prog.gan")).write_bytes($builtins.bytes([0, 255, 1]))
      r = subprocess.run([lsc_bin(), "check", "--root", dir],
        capture_output: true, text: true, timeout: 120, cwd: dir)
      v = json.loads(r.stdout)
      assert is_map(v)
    end

    test "emoji and unicode survive" do
      src = "defmodule Prog do\n  @moduledoc \"m\"\n  @doc \"d\"\n  @spec f() :: string()\n  @example \"\"\"\n      gan> 1\n      1\n  \"\"\"\n  def f(), do: \"🚀→中文\"\nend"
      {_v, rc} = check(src)
      assert rc == 0
    end
  end
end
