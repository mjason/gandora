defmodule TestRetrieval do
  @moduledoc """
  GEP-0031 conformance: the atlas's shape, find/grep over the corpus
  (docs and installed sources included), BM25 ranking, and precise
  reads — exercised against this very project, run by `gan test`.
  """
  @moduledoc_trans zh_CN: "GEP-0031 conformance:地图形状、语料上的 find/grep(文档与已安装源在内)、BM25 排名、精准读取——以本项目自身为靶,gan test 运行。"

  use Test

  defp root(), do: File.cwd!()

  describe "the atlas (GEP-0031-R003)" do
    test "project modules carry paths and public heads" do
      atlas = Atlas.build(root(), "Retrieval")
      [entry] = Map.get(atlas, "project")
      assert_eq(Map.get(entry, "module"), "Retrieval")
      assert_eq(Map.get(entry, "path"), "src/retrieval.gan")
      assert_true(Enum.count(Map.get(entry, "heads")) >= 4)
    end

    test "installed packages appear with shipped sources and names" do
      atlas = Atlas.build(root(), "Enum")
      std = atlas |> Map.get("packages") |> Map.get("gandora_std")
      [entry] = Enum.filter(std, fn m -> Map.get(m, "module") == "Enum" end)
      assert_contains(Map.get(entry, "source"), "_gan/gandora_std/enum.gan")
      assert_contains(Map.get(entry, "names"), "map")
    end
  end

  describe "find and grep (GEP-0031-R004/R005)" do
    test "find matches by substring and by glob" do
      assert_contains(Map.get(Retrieval.find(root(), "atlas", false), "files"), "src/atlas.gan")
      assert_contains(Map.get(Retrieval.find(root(), "atl*.gan", false), "files"), "src/atlas.gan")
    end

    test "deps widen the corpus to installed sources" do
      lean = Retrieval.find(root(), "enum.gan", false)
      wide = Retrieval.find(root(), "enum.gan", true)
      assert_eq(Map.get(lean, "count"), 0)
      assert_true(Map.get(wide, "count") >= 1)
    end

    test "grep answers path, line, and text, and admits its caps" do
      v = Retrieval.grep(root(), "GEP-0031-R005", false)
      hit = v |> Map.get("matches") |> Enum.at(0)
      assert_contains(Map.get(hit, "path"), ".gan")
      assert_true(Map.get(hit, "line") > 0)
      assert_false(Map.get(v, "truncated"))
    end

    test "the rg path and the pure fallback agree" do
      files = ["src/retrieval.gan"] |> Enum.map(fn p -> Path.join(root(), p) end)
      rg = System.find_executable("rg")
      from_rg = Retrieval.grep(root(), "walk_annotations", false)
      # the fallback is exercised directly only when rg is absent; when
      # present, at least pin that rg found what the source contains
      assert_true(Map.get(from_rg, "count") >= 2)
      assert_false(is_nil(rg) and Map.get(from_rg, "count") == 0)
      assert_eq(Enum.count(files), 1)
    end

    test "ranked mode orders by BM25 and reaches installed docs" do
      v = Retrieval.ranked(root(), "verdict shaped read host message", true)
      top = v |> Map.get("files") |> Enum.at(0)
      assert_contains(Map.get(top, "path"), "file.gan")
      assert_true(Map.get(top, "score") > 0)
      assert_true(Enum.count(Map.get(top, "lines")) >= 1)
    end
  end

  describe "read (GEP-0031-R006)" do
    test "a line range comes back cited" do
      v = Retrieval.read(root(), "src/atlas.gan", 1, 3)
      assert_eq(Map.get(v, "from"), 1)
      assert_eq(Map.get(v, "to"), 3)
      assert_contains(Map.get(v, "text"), "defmodule Atlas")
    end

    test "a definition's block arrives with its annotations" do
      v = Retrieval.read(root(), "Retrieval.tokens", 0, 0)
      assert_contains(Map.get(v, "text"), "@doc")
      assert_contains(Map.get(v, "text"), "@example")
      assert_contains(Map.get(v, "text"), "def tokens(text)")
      assert_false(String.contains?(Map.get(v, "text"), "defp doc_len"))
    end

    test "an installed definition reads from its shipped source" do
      v = Retrieval.read(root(), "Enum.map", 0, 0)
      assert_contains(Map.get(v, "path"), "_gan/gandora_std/enum.gan")
      assert_contains(Map.get(v, "text"), "def map(xs, f)")
    end

    test "an unresolvable target is an error, not a crash" do
      v = Retrieval.read(root(), "Nowhere.nothing", 0, 0)
      assert_contains(Map.get(v, "error"), "Nowhere.nothing")
    end
  end
end
