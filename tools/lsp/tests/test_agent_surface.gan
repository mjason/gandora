defmodule TestAgentSurface do
  @moduledoc """
  GEP-0026 conformance: batch/brief doc queries, the context pack's
  shape and determinism, and the enforcement newcomers (short-sigil
  whitelist, types-are-calls) — run by `gan test`.
  """
  @moduledoc_trans zh_CN: "GEP-0026 conformance:批量/brief 查询、pack 形状与确定性,及新强制(短 sigil 白名单、类型皆调用)——gan test 运行。"

  use Test

  pyimport json
  pyimport tempfile
  pyimport sys

  defp lsc_bin() do
    sys.executable |> Path.dirname() |> Path.join("gan-lsc")
  end

  # src/prog.gan is the one file every scenario rewrites
  defp plant(dir, source) do
    File.write!(dir |> Path.join("src") |> Path.join("prog.gan"), source)
  end

  defp scratch() do
    dir = tempfile.mkdtemp(prefix: "gan-agent-surface-")
    File.mkdir_p!(Path.join(dir, "src"))
    File.write!(Path.join(dir, "gandora.jsonc"),
      "{\"source\": [\"src\"], \"outDir\": \"dist\"}")
    plant(dir, "defmodule Prog do\n  @moduledoc \"m\"\n  @doc \"d\"\n  @spec double(integer()) :: integer()\n  @example \"\"\"\n      gan> Prog.double(2)\n      4\n  \"\"\"\n  def double(x), do: x * 2\nend")
    venv = sys.executable |> Path.dirname() |> Path.dirname()
    if Path.basename(venv) == ".venv" do
      $os.symlink(venv, Path.join(dir, ".venv"))
    end
    dir
  end

  defp lsc(args, dir) do
    {out, _status} = System.cmd(lsc_bin(), args ++ ["--root", dir],
      [cd: dir, timeout: 120000])
    json.loads(out)
  end

  describe "the context pack (GEP-0026-R003)" do
    test "one call carries std, project, language, and verdict" do
      dir = scratch()
      pack = lsc(["pack"], dir)
      Enum.each(["language", "std", "project", "verdict", "next"], fn key ->
        assert Map.get(pack, key, :missing) != :missing
      end)
      assert "map" in Map.get(Map.get(pack, "std"), "Enum")
      assert Map.get(Map.get(pack, "verdict"), "ok") == true
      assert "for" in Map.get(Map.get(pack, "language"), "constructs")
    end

    test "the pack is deterministic for an unchanged project" do
      dir = scratch()
      assert lsc(["pack"], dir) == lsc(["pack"], dir)
    end

    test "naming a module adds its full docs under deep" do
      dir = scratch()
      pack = lsc(["pack", "Enum"], dir)
      docs = Map.get(Map.get(pack, "deep"), "Enum")
      assert Enum.count(docs) > 30
    end
  end

  describe "batch and brief (GEP-0026-R001/R002)" do
    test "many doc targets return one array" do
      dir = scratch()
      out = lsc(["doc", "Enum.map", "Enum.filter", "String.split"], dir)
      assert Enum.count(out) == 3
    end

    test "brief entries are label, head, summary" do
      dir = scratch()
      out = lsc(["doc", "Enum.map", "Enum.take", "--brief"], dir)
      first = Enum.at(out, 0)
      assert String.contains?(Map.get(first, "head"), "@spec")
      assert Map.get(first, "summary") != ""
    end

    test "many symbols targets return a name-keyed object" do
      dir = scratch()
      out = lsc(["symbols", "Enum", "String"], dir)
      assert Enum.count(Map.get(out, "Enum")) > 30
    end
  end

  describe "macro documentation surfaces" do
    test "a documented defmacro compiles and keeps docs separate" do
      dir = scratch()
      plant(dir, "defmodule Prog do\n  @moduledoc \"m\"\n  @doc \"Doubles at compile time.\"\n  defmacro dbl(x) do\n    quote do\n      unquote(x) * 2\n    end\n  end\n  @doc \"d\"\n  @spec f(integer()) :: integer()\n  @example \"\"\"\n      gan> Prog.f(3)\n      6\n  \"\"\"\n  def f(y), do: dbl(y)\nend")
      v = lsc(["check"], dir)
      assert Map.get(v, "ok") == true
      info = lsc(["doc", "Prog.dbl"], dir)
      assert String.contains?(Map.get(Map.get(info, "entries"), "default"), "Doubles")
    end

    test "a bare lowercase name resolves project-wide before pydoc" do
      dir = scratch()
      plant(dir, "defmodule Prog do\n  @moduledoc \"m\"\n  @doc \"The answer.\"\n  @spec answer() :: integer()\n  @example \"\"\"\n      gan> Prog.answer()\n      42\n  \"\"\"\n  def answer(), do: 42\nend")
      info = lsc(["doc", "answer"], dir)
      assert String.contains?(Map.get(info, "label"), "Prog.answer")
    end
  end

  describe "named types (GEP-0027)" do
    test "a generic alias expands in the verdict pipeline" do
      dir = scratch()
      plant(dir, "defmodule Prog do\n  @moduledoc \"m\"\n  @type result(t) :: tuple(atom(), t)\n  @doc \"d\"\n  @spec parse(string()) :: result(integer())\n  @example \"\"\"\n      gan> Prog.parse(\"1\")\n      ('ok', 1)\n  \"\"\"\n  def parse(s), do: {:ok, $builtins.int(s)}\nend")
      v = lsc(["check"], dir)
      assert Map.get(v, "ok") == true
      assert Map.get(v, "clean") == true
    end

    test "an unknown named type errors with a did-you-mean" do
      dir = scratch()
      plant(dir, "defmodule Prog do\n  @type resul(t) :: list(t)\n  @spec f(result(integer())) :: term()\n  def f(_x), do: nil\nend")
      v = lsc(["check"], dir)
      hit = Enum.find(Map.get(v, "diagnostics", []), fn d ->
        String.contains?(Map.get(d, "message"), "did you mean resul()")
      end)
      assert not is_nil(hit)
    end
  end

  describe "spelling enforcement" do
    test "short sigil names outside the whitelist error" do
      dir = scratch()
      plant(dir, "defmodule Prog do\n  def f(), do: ~q(x)\nend")
      v = lsc(["check"], dir)
      hit = Enum.find(Map.get(v, "diagnostics", []), fn d ->
        String.contains?(Map.get(d, "message"), "~w ~s ~r ~p")
      end)
      assert not is_nil(hit)
    end

    test "a bare dotted type errors with the parenthesized fix" do
      dir = scratch()
      plant(dir, "defmodule Prog do\n  @spec f($math.Pi) :: term()\n  def f(_x), do: nil\nend")
      v = lsc(["check"], dir)
      hit = Enum.find(Map.get(v, "diagnostics", []), fn d ->
        String.contains?(Map.get(d, "message"), "$math.Pi()")
      end)
      assert not is_nil(hit)
    end
  end
end
