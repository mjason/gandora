defmodule Main do
  @moduledoc """
  gan-lsp: the Gandora language server on pygls (GEP-0015 rev 2).
  pygls owns protocol machinery; this module owns language logic.
  """

  pyimport gandora_core, as: core
  pyimport lsprotocol.types, as: types

  @server $"pygls.lsp.server".LanguageServer("gan-lsp", "0.3.0",
    text_document_sync_kind: $"lsprotocol.types".TextDocumentSyncKind.Full)

  @decorate @server.feature($"lsprotocol.types".TEXT_DOCUMENT_DID_OPEN)
  def did_open(params) do
    publish(params.text_document.uri, params.text_document.text)
  end

  @decorate @server.feature($"lsprotocol.types".TEXT_DOCUMENT_DID_CHANGE)
  def did_change(params) do
    text = Enum.at($builtins.list(params.content_changes), -1).text
    publish(params.text_document.uri, text)
  end

  @decorate @server.feature($"lsprotocol.types".TEXT_DOCUMENT_DID_CLOSE)
  def did_close(params) do
    send_diagnostics(params.text_document.uri, [])
  end

  defp send_diagnostics(uri, items) do
    @server.text_document_publish_diagnostics(
      $"lsprotocol.types".PublishDiagnosticsParams(uri: uri, diagnostics: items)
    )
  end

  defp publish(uri, text) do
    path = String.replace(uri, "file://", "")
    root = @server.workspace.root_path
    diags = try do
      core.diagnostics(text, path, root)
    rescue
      _e -> []
    end
    lsp = Enum.map(diags, fn d ->
      line = Enum.max([Map.get(d, "line") - 1, 0])
      col = Enum.max([Map.get(d, "col") - 1, 0])
      pos = types.Position(line: line, character: col)
      types.Diagnostic(
        range: types.Range(pos, pos),
        message: Map.get(d, "message"),
        severity: severity(Map.get(d, "severity")),
        source: "gan"
      )
    end)
    send_diagnostics(uri, lsp)
  end

  defp severity("error"), do: $"lsprotocol.types".DiagnosticSeverity.Error
  defp severity(_), do: $"lsprotocol.types".DiagnosticSeverity.Warning

  def main() do
    @server.start_io()
  end
end
