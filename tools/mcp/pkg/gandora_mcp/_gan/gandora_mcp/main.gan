defmodule Main do
  @moduledoc """
  `gan-mcp` — the Gandora MCP server, written in Gandora (GEP-0028).

  The tool schemas are not declared twice: `@spec` becomes the Python
  signature, the signature becomes the MCP `inputSchema`, and `@doc`
  becomes the tool description. What the language already demands of
  every public function is exactly what the protocol needs.
  """
  @moduledoc_trans zh_CN: "`gan-mcp`——用 Gandora 写成的 Gandora MCP 服务器(GEP-0028)。工具 schema 不写第二遍:`@spec` 生成 Python 签名,签名生成 MCP `inputSchema`,`@doc` 成为工具描述。语言本就对每个公开函数的要求,恰是协议所需。"

  pyimport mcp.server.mcpserver, as: ms
  pyimport gandora_core, as: core

  require Toolkit

  # a tool is a bare marker on the function that implements it
  # (GEP-0008): the Toolkit.on_tool hook accumulates {name, &name/arity}
  # here, and the server registers from this one table — everything a
  # client reads comes from the @doc/@param/@spec already on the def
  defattr :tool
  defattr :tool_table, accumulate: true

  @on_definition Toolkit.on_tool

  @instructions """
  Gandora is an Elixir-flavored language compiling to readable Python.
  Call `gan_briefing` once at the start of a session. Ask `gan_example`
  when you need to know how a feature or a piece of syntax is really
  written — it answers with prose plus a module that compiled and whose
  doctests ran. Call `gan_verify` on every snippet before you hand it to
  the user, including snippets you wrote yourself: a verdict of
  `clean: true` with `doctests.passed: true` is the only evidence that
  the code works. `gan_doc` and `gan_pack` answer what a name means, and
  are the same answers as `gan lsc doc` / `gan lsc pack` if you have a
  shell. To find code before touching it: `gan_map` orients (project,
  installed packages, docs), `gan_search_files`/`gan_search_content`
  locate (the corpus includes documentation and every installed
  package's shipped .gan sources), and `gan_read` fetches exactly one
  block — a line range, a module, or `Mod.fun` with its annotations —
  instead of a whole file. If the project's AGENTS.md lacks the
  Gandora section (the `<!-- gandora:begin -->` marker), suggest
  running `gan init .` once: it tops up the agent and MCP wiring
  idempotently and never overwrites anything.
  """

  @doc """
  Compiles a Gandora module in a throwaway project and really runs its
  `@example` doctests; returns errors, practice suggestions, and the
  doctest output.
  """
  @doc_trans zh_CN: "在一次性项目里编译一个 Gandora 模块并真跑它的 `@example` doctest;返回 error、practice 建议与 doctest 输出。"
  @param source, "The Gandora source text of one module."
  @spec gan_verify(string()) :: map()
  @tool true
  def gan_verify(source), do: Sandbox.verdict(source, root())

  @doc """
  Explains one Gandora feature or piece of syntax and demonstrates it
  with a complete module — returned only once that module has compiled,
  passed the practice pass, and had its `@example` doctests really run
  (GEP-0028-R006). The prose explains; every line of code in the answer
  is code that ran.
  """
  @doc_trans zh_CN: "讲解一项 Gandora 功能或语法,并以一个完整模块示范——该模块须已编译、通过 practice 一关、并真跑过 `@example` doctest 后才返回(GEP-0028-R006)。散文负责解释;答案里每一行代码都是跑过的代码。"
  @param requirement, "The feature, syntax, or capability to demonstrate."
  # an async tool: the SDK detects the coroutine function and awaits it
  # on its own loop, so the model round-trips ride the server's loop
  # with no bridge in between
  @spec gan_example(string()) :: map()
  @tool true
  async def gan_example(requirement), do: await Composer.example(requirement, root())

  @doc """
  The documentation for one target — `Enum.map`, a bare function name,
  or a language construct such as `defmacro`.
  """
  @doc_trans zh_CN: "一个目标的文档——`Enum.map`、裸函数名,或 `defmacro` 这样的语言构造。"
  @param target, "What to look up."
  @spec gan_doc(string()) :: term()
  @tool true
  def gan_doc(target), do: Intel.doc(target, root())

  @doc """
  The one-call context pack for the current project: std function lists,
  project signatures, the construct index, and the verdict summary.
  """
  @doc_trans zh_CN: "当前项目的一次调用上下文包:std 函数清单、项目签名、构造索引与裁决摘要。"
  @param modules, "Module names whose full docs ride along; `[]` for the overview."
  @spec gan_pack(sequence(string())) :: term()
  # no default argument: `\\` compiles to `*_gan_args`, which erases the
  # signature MCP derives its inputSchema from — a tool parameter must
  # stay a named, typed parameter
  @tool true
  def gan_pack(modules), do: Intel.pack(modules, root())

  @doc "The verdict for the current project: `ok`, `clean`, and why not."
  @doc_trans zh_CN: "当前项目的裁决:`ok`、`clean`,以及为何不是。"
  @spec gan_check() :: term()
  @tool true
  def gan_check(), do: Intel.check(root())

  @doc "The session briefing: how to work in Gandora, plus this project."
  @doc_trans zh_CN: "会话简报:如何在 Gandora 中工作,以及这个项目的情况。"
  @spec gan_briefing() :: string()
  @tool true
  def gan_briefing(), do: Intel.briefing(root())

  @doc """
  The code atlas (GEP-0031): project modules with paths and doc-signed
  public heads, every installed package's modules with the `.gan`
  sources they ship (the standard library included), and the
  documentation files. With `ranked`, the query searches the atlas
  itself — every definition is a BM25 document of name, head, and
  `@doc` sentence — answering "which function does X" without knowing
  its name.
  """
  @doc_trans zh_CN: "代码地图(GEP-0031):项目模块及路径与带 @doc 摘要的公开函数头、每个已安装包的模块与其随附 .gan 源(std 在内)、以及文档文件。`ranked` 时按查询搜地图本身——每个定义是名字+函数头+@doc 首句构成的 BM25 文档,不知道名字也能答「哪个函数做 X」。"
  @param query, "A module-name fragment (\"\" for the full atlas), or — with `ranked` — the words describing what the definition should do."
  @param ranked, "Rank the atlas's definitions by BM25 instead of listing the map."
  @spec gan_map(string(), boolean()) :: term()
  @tool true
  def gan_map(query, ranked) do
    Intel.lsc(if(ranked, do: ["map", query, "--query"], else: ["map", query]), root())
  end

  @doc """
  Corpus files whose name matches `pattern` — a glob when it carries
  `*`/`?`, a substring otherwise. The corpus is project sources and
  docs; `deps` adds the `.gan` sources of every installed package
  (GEP-0031).
  """
  @doc_trans zh_CN: "文件名匹配 `pattern` 的语料文件——含 `*`/`?` 按 glob,否则按子串。语料为项目源码与文档;`deps` 加入每个已安装包随附的 .gan 源(GEP-0031)。"
  @param pattern, "The file-name pattern."
  @param deps, "Whether installed packages' sources join the search."
  @spec gan_search_files(string(), boolean()) :: term()
  @tool true
  def gan_search_files(pattern, deps) do
    Intel.lsc(["find", pattern] ++ flag(deps, "--deps"), root())
  end

  @doc """
  Content search over the corpus (GEP-0031): a regular expression by
  default, or BM25 ranking when `ranked` — use ranked mode for prose
  questions, regex for exact shapes. `deps` adds the `.gan` sources of
  every installed package, so library code and its `@doc` prose are
  searchable too. Capped output says so via `truncated`.
  """
  @doc_trans zh_CN: "语料内容检索(GEP-0031):默认正则,`ranked` 时 BM25 排名——散文式问题用排名,精确形状用正则。`deps` 加入每个已安装包随附的 .gan 源,库代码与其 @doc 散文一并可搜。输出有上限并以 `truncated` 如实相告。"
  @param pattern, "The regular expression, or the words to rank by."
  @param ranked, "BM25 ranking instead of regex matching."
  @param deps, "Whether installed packages' sources join the search."
  @spec gan_search_content(string(), boolean(), boolean()) :: term()
  @tool true
  def gan_search_content(pattern, ranked, deps) do
    Intel.lsc(["grep", pattern] ++ flag(ranked, "--ranked") ++ flag(deps, "--deps"), root())
  end

  @doc """
  One precise read (GEP-0031): a corpus path with a 1-based inclusive
  line range (0, 0 for the whole file), a module name (its whole
  source, project or installed), or `Mod.fun` (that definition's
  block, annotations included). Prefer this over paging whole files.
  """
  @doc_trans zh_CN: "一次精准读取(GEP-0031):语料路径加 1 起始闭区间行段(整文件传 0,0)、模块名(整份源码,项目或已安装)、或 Mod.fun(该定义的块,含注解)。优先用它,别整页翻文件。"
  @param target, "A corpus path, `Mod`, or `Mod.fun`."
  @param from_line, "First line, 1-based; 0 for a named or whole-file read."
  @param to_line, "Last line, inclusive; 0 for a named or whole-file read."
  @spec gan_read(string(), integer(), integer()) :: term()
  @tool true
  def gan_read(target, from_line, to_line) do
    Intel.lsc(["read", target, to_string(from_line), to_string(to_line)], root())
  end

  defp flag(on, name), do: if(on, do: [name], else: [])

  @doc """
  The tool table the hook accumulated from the `@tool` markers — the
  single source the server registers from: each entry is the
  function's own name and a capture of it.
  """
  @doc_trans zh_CN: "钩子从 `@tool` 标记累积的工具表——服务器注册的唯一来源:每条是函数本名与其捕获。"
  @spec tools() :: list(tuple())
  @example """
      gan> Enum.count(Main.tools())
      10
  """
  def tools(), do: @tool_table

  @doc """
  The project the queries run against: `$GAN_MCP_ROOT` when set,
  otherwise the nearest ancestor of the working directory holding a
  `gandora.jsonc`. A client chooses where it launches a server, and it
  may well choose a subdirectory — so the project is discovered, not
  configured.
  """
  @doc_trans zh_CN: "查询所针对的项目:设了 `$GAN_MCP_ROOT` 用它,否则从当前目录向上找最近一层带 `gandora.jsonc` 的祖先目录。服务器在哪启动由客户端决定,而它完全可能选个子目录——所以项目靠发现,而非靠配置。"
  @spec root() :: string()
  def root() do
    env = System.get_env("GAN_MCP_ROOT")
    if is_nil(env), do: discover(File.cwd!()), else: env
  end

  defp discover(dir) do
    cond do
      dir |> Path.join("gandora.jsonc") |> File.exists?() -> dir
      # the filesystem root: no project anywhere above, so answer for
      # where we were launched rather than for "/"
      Path.dirname(dir) == dir -> File.cwd!()
      true -> discover(Path.dirname(dir))
    end
  end

  @doc """
  The configured server: every table entry registered with its whole
  annotation surface wired into the protocol — the signature (from
  `@spec`) is the inputSchema, the `@doc` prose is the description,
  and each `@param` text lands on its schema property. Declared once
  on the definition, visible to every client.
  """
  @doc_trans zh_CN: "配置完毕的服务器:表中每个条目注册时把完整注解面接进协议——签名(来自 @spec)即 inputSchema,@doc 散文即 description,每条 @param 落到对应 schema 属性上。在定义上声明一次,每个客户端都看得见。"
  @spec server() :: term()
  def server() do
    s = ms.MCPServer("gandora", version: core.version(), instructions: @instructions)
    Enum.each(tools(), fn {name, f} -> register(s, name, f) end)
    s
  end

  defp register(s, name, f) do
    s.add_tool(f, name: name, description: doc_prose(f.__doc__))
    # the Tool's schema is enriched in place; get_tool is the tool
    # manager's public accessor, reached through the server's field
    annotate(s._tool_manager.get_tool(name), param_docs(f.__doc__))
  end

  defp annotate(tool, docs) do
    if not is_nil(tool) do
      props = tool.parameters |> Map.get("properties", %{})
      Enum.each(Map.to_list(docs), fn {pname, text} ->
        if Map.has_key?(props, pname) do
          _none = Map.get(props, pname).update(%{"description" => text})
          nil
        end
      end)
    end
  end

  @doc """
  The tool description from a compiled docstring: the `@doc` prose,
  with the `## Parameters` section (which rides the schema instead)
  cut off.
  """
  @doc_trans zh_CN: "编译后 docstring 里的工具描述:@doc 散文,截去改走 schema 的 `## Parameters` 段。"
  @param doc, "The function docstring; nil for an undocumented function."
  @param_trans doc, zh_CN: "函数 docstring;未写文档时为 nil。"
  @spec doc_prose(string()) :: string()
  @example """
      gan> Main.doc_prose("Does things.\\n\\n## Parameters\\n\\n  - x: The input.\\n")
      'Does things.'
  """
  def doc_prose(doc) do
    if is_nil(doc) do
      ""
    else
      doc |> String.split_on("## Parameters") |> Enum.at(0) |> String.trim()
    end
  end

  # one compiled @param: `  - name: text` (GEP-0018 codegen shape)
  @param_line ~r/^\s*- ([a-z_][A-Za-z0-9_]*): (.*)$/

  @doc """
  The `@param` texts by parameter name, parsed from the compiled
  `## Parameters` section — the exact shape our own codegen emits
  (GEP-0018), so the parse is a contract, not a guess.
  """
  @doc_trans zh_CN: "按参数名给出的 `@param` 文本,解析自编译产物的 `## Parameters` 段——正是自家 codegen 生成的形状(GEP-0018),解析是契约而非猜测。"
  @param doc, "The function docstring; nil for an undocumented function."
  @param_trans doc, zh_CN: "函数 docstring;未写文档时为 nil。"
  @spec param_docs(string()) :: map()
  @example """
      gan> Main.param_docs("D.\\n\\n## Parameters\\n\\n  - x: The input.\\n  - y: The other.\\n")
      {'x': 'The input.', 'y': 'The other.'}
  """
  def param_docs(doc) do
    parts = if is_nil(doc), do: [doc], else: String.split_on(doc, "## Parameters")
    if Enum.count(parts) < 2 do
      %{}
    else
      matches = parts
      |> Enum.at(1)
      |> String.split_on("\n")
      |> Enum.take_while(fn l -> String.trim(l) == "" or String.match?(l, @param_line) end)
      |> Enum.map(fn l -> @param_line.match(l) end)
      pairs = for m <- matches, not is_nil(m), do: {m.group(1), m.group(2)}
      Map.new(pairs)
    end
  end

  @doc "Serves the tool table over stdio until the client disconnects."
  @doc_trans zh_CN: "通过 stdio 提供工具表,直到客户端断开。"
  @spec main() :: nil
  def main(), do: server().run("stdio")
end
