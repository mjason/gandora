{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Gandora",
  "scopeName": "source.gandora",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#doc-heredoc"
    },
    {
      "include": "#sigil-python"
    },
    {
      "include": "#sigil-sql"
    },
    {
      "include": "#sigil-markdown"
    },
    {
      "include": "#sigil-html"
    },
    {
      "include": "#sigil-json"
    },
    {
      "include": "#sigil-regex"
    },
    {
      "include": "#sigil-generic"
    },
    {
      "include": "#heredoc"
    },
    {
      "include": "#string"
    },
    {
      "include": "#attribute"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#atom"
    },
    {
      "include": "#number"
    },
    {
      "include": "#module"
    },
    {
      "include": "#function-def"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#variable"
    }
  ],
  "repository": {
    "comment": {
      "match": "#(?!\\{).*$",
      "name": "comment.line.number-sign.gandora"
    },
    "splice": {
      "begin": "<%=",
      "end": "%>",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.gandora"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.gandora"
        }
      },
      "contentName": "meta.embedded.splice.gandora",
      "patterns": [
        {
          "include": "source.gandora"
        }
      ]
    },
    "interpolation": {
      "begin": "#\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.gandora"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.gandora"
        }
      },
      "contentName": "meta.embedded.interpolation.gandora",
      "patterns": [
        {
          "include": "source.gandora"
        }
      ]
    },
    "doc-heredoc": {
      "begin": "(@(?:moduledoc|doc|example|doc_trans|moduledoc_trans))\\b([^\"\\n]*)(\"\"\")",
      "end": "(^\\s*)?\"\"\"",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.attribute.gandora"
        },
        "3": {
          "name": "string.quoted.triple.gandora punctuation.definition.string.begin.gandora"
        }
      },
      "endCaptures": {
        "0": {
          "name": "string.quoted.triple.gandora punctuation.definition.string.end.gandora"
        }
      },
      "contentName": "string.quoted.triple.documentation.gandora",
      "patterns": [
        {
          "include": "#markdown-lite"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "markdown-lite": {
      "patterns": [
        {
          "match": "^\\s*(gan>|\\.\\.\\.>)\\s?(.*)$",
          "captures": {
            "1": {
              "name": "punctuation.separator.prompt.gandora keyword.operator.gandora"
            },
            "2": {
              "name": "meta.embedded.doctest.gandora",
              "patterns": [
                {
                  "include": "source.gandora"
                }
              ]
            }
          }
        },
        {
          "match": "^\\s*(#{1,6})\\s.*$",
          "name": "markup.heading.markdown",
          "captures": {
            "1": {
              "name": "punctuation.definition.heading.markdown"
            }
          }
        },
        {
          "match": "`[^`\\n]+`",
          "name": "markup.inline.raw.string.markdown"
        },
        {
          "match": "\\*\\*[^*\\n]+\\*\\*",
          "name": "markup.bold.markdown"
        },
        {
          "match": "^\\s*([-*+]|\\d+\\.)\\s",
          "captures": {
            "1": {
              "name": "punctuation.definition.list.begin.markdown"
            }
          }
        }
      ]
    },
    "sigil-python": {
      "patterns": [
        {
          "begin": "~python\"\"\"",
          "end": "(^\\s*)?\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "meta.embedded.block.python source.python",
          "patterns": [
            {
              "include": "#splice"
            },
            {
              "include": "source.python"
            }
          ]
        },
        {
          "begin": "~python\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "meta.embedded.block.python source.python",
          "patterns": [
            {
              "include": "#splice"
            },
            {
              "include": "#paren-nest-python"
            },
            {
              "include": "source.python"
            }
          ]
        }
      ]
    },
    "paren-nest-python": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#splice"
        },
        {
          "include": "#paren-nest-python"
        },
        {
          "include": "source.python"
        }
      ]
    },
    "sigil-sql": {
      "patterns": [
        {
          "begin": "~sql\"\"\"",
          "end": "(^\\s*)?\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "meta.embedded.block.sql source.sql",
          "patterns": [
            {
              "include": "#splice"
            },
            {
              "include": "source.sql"
            }
          ]
        },
        {
          "begin": "~sql\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "meta.embedded.block.sql source.sql",
          "patterns": [
            {
              "include": "#splice"
            },
            {
              "include": "#paren-nest-sql"
            },
            {
              "include": "source.sql"
            }
          ]
        }
      ]
    },
    "paren-nest-sql": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#splice"
        },
        {
          "include": "#paren-nest-sql"
        },
        {
          "include": "source.sql"
        }
      ]
    },
    "sigil-markdown": {
      "patterns": [
        {
          "begin": "~markdown\"\"\"",
          "end": "(^\\s*)?\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "meta.embedded.block.markdown string.unquoted.sigil.gandora",
          "patterns": [
            {
              "include": "#splice"
            },
            {
              "include": "#markdown-lite"
            }
          ]
        },
        {
          "begin": "~markdown\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "meta.embedded.block.markdown string.unquoted.sigil.gandora",
          "patterns": [
            {
              "include": "#splice"
            },
            {
              "include": "#nest-paren"
            },
            {
              "include": "#markdown-lite"
            }
          ]
        }
      ]
    },
    "sigil-html": {
      "patterns": [
        {
          "begin": "~html\"\"\"",
          "end": "(^\\s*)?\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "meta.embedded.block.html text.html.basic",
          "patterns": [
            {
              "include": "#splice"
            },
            {
              "include": "text.html.basic"
            }
          ]
        },
        {
          "begin": "~html\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "meta.embedded.block.html text.html.basic",
          "patterns": [
            {
              "include": "#splice"
            },
            {
              "include": "#nest-paren"
            },
            {
              "include": "text.html.basic"
            }
          ]
        }
      ]
    },
    "sigil-json": {
      "patterns": [
        {
          "begin": "~json\"\"\"",
          "end": "(^\\s*)?\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "meta.embedded.block.json source.json",
          "patterns": [
            {
              "include": "#splice"
            },
            {
              "include": "source.json"
            }
          ]
        },
        {
          "begin": "~json\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "meta.embedded.block.json source.json",
          "patterns": [
            {
              "include": "#splice"
            },
            {
              "include": "#nest-paren"
            },
            {
              "include": "source.json"
            }
          ]
        }
      ]
    },
    "sigil-regex": {
      "patterns": [
        {
          "begin": "~r\"\"\"",
          "end": "(^\\s*)?\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "string.regexp.gandora",
          "patterns": [
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "begin": "~r/",
          "end": "/",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "string.regexp.gandora",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.gandora"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "begin": "~r\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "string.regexp.gandora",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.gandora"
            },
            {
              "include": "#nest-paren-regexp"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "begin": "~r\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "string.regexp.gandora",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.gandora"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "nest-paren-regexp": {
      "begin": "\\(",
      "end": "\\)",
      "name": "string.regexp.gandora",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.gandora"
        },
        {
          "include": "#nest-paren-regexp"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "sigil-generic": {
      "patterns": [
        {
          "begin": "~[a-zA-Z]+\"\"\"",
          "end": "(^\\s*)?\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "string.unquoted.sigil.gandora",
          "patterns": [
            {
              "include": "#splice"
            }
          ]
        },
        {
          "begin": "~[a-zA-Z]+\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "string.unquoted.sigil.gandora",
          "patterns": [
            {
              "include": "#splice"
            },
            {
              "include": "#nest-paren"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "begin": "~[a-zA-Z]+\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "string.unquoted.sigil.gandora",
          "patterns": [
            {
              "include": "#splice"
            },
            {
              "include": "#nest-bracket"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "begin": "~[a-zA-Z]+\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "string.unquoted.sigil.gandora",
          "patterns": [
            {
              "include": "#splice"
            },
            {
              "include": "#nest-brace"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "begin": "~[a-zA-Z]+/",
          "end": "/",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "string.unquoted.sigil.gandora",
          "patterns": [
            {
              "include": "#splice"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "begin": "~[a-zA-Z]+\\|",
          "end": "\\|",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "string.unquoted.sigil.gandora",
          "patterns": [
            {
              "include": "#splice"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "begin": "~[a-zA-Z]+\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.sigil.gandora"
            }
          },
          "contentName": "string.unquoted.sigil.gandora",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.gandora"
            },
            {
              "include": "#splice"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "nest-paren": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#splice"
        },
        {
          "include": "#nest-paren"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "nest-bracket": {
      "begin": "\\[",
      "end": "\\]",
      "patterns": [
        {
          "include": "#splice"
        },
        {
          "include": "#nest-bracket"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "nest-brace": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#splice"
        },
        {
          "include": "#nest-brace"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "heredoc": {
      "begin": "\"\"\"",
      "end": "(^\\s*)?\"\"\"",
      "name": "string.quoted.triple.gandora",
      "patterns": [
        {
          "include": "#interpolation"
        }
      ]
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.gandora",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.gandora"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "attribute": {
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*",
      "name": "keyword.control.attribute.gandora"
    },
    "keyword": {
      "match": "\\b(defmodule|defmacro|defstruct|defattr|defp|def|do|end|fn|if|else|unless|case|cond|with|try|rescue|after|loop|recur|break|quote|unquote_splicing|unquote|var!|when|and|or|not|in|use|import|alias|require|pyimport|true|false|nil)\\b",
      "name": "keyword.control.gandora"
    },
    "atom": {
      "patterns": [
        {
          "match": ":\"[^\"]*\"",
          "name": "constant.other.symbol.quoted.gandora"
        },
        {
          "match": ":[a-zA-Z_][a-zA-Z0-9_]*[?!]?",
          "name": "constant.other.symbol.gandora"
        },
        {
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=:\\s)",
          "name": "constant.other.keyword-key.gandora"
        }
      ]
    },
    "number": {
      "match": "\\b\\d[\\d_]*(\\.\\d+)?([eE][+-]?\\d+)?\\b",
      "name": "constant.numeric.gandora"
    },
    "module": {
      "match": "\\b[A-Z][a-zA-Z0-9_]*(\\.[A-Z][a-zA-Z0-9_]*)*\\b",
      "name": "entity.name.type.module.gandora"
    },
    "function-def": {
      "match": "(?<=\\b(?:def|defp|defmacro)\\s)([a-z_][a-zA-Z0-9_]*[?!]?)",
      "name": "entity.name.function.gandora"
    },
    "operator": {
      "match": "\\|>|\\+\\+|<>|<%=|%>|\\\\\\\\|->|<-|=>|==|!=|<=|>=|//|\\.\\.|=|\\+|-|\\*|/|<|>|\\^|&|\\|",
      "name": "keyword.operator.gandora"
    },
    "variable": {
      "match": "\\b[a-z_][a-zA-Z0-9_]*[?!]?\\b",
      "name": "variable.other.gandora"
    }
  }
}