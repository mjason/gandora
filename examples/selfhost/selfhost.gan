defmodule Selfhost do
  @moduledoc "Gandora analyzing Gandora: the compiler as a library (GEP-0012)."

  pyimport gandora_core, as: core

  def function_names(source) do
    case core.parse(source) do
      {"__block__", _, stmts} -> Enum.flat_map(stmts, fn s -> walk_top(s) end)
      other -> walk_top(other)
    end
  end

  defp walk_top(node) do
    case node do
      {"defmodule", _, args} -> args |> module_body() |> Enum.flat_map(fn s -> walk_top(s) end)
      {"def", _, [{name, _, _} | _]} -> [name]
      {"defp", _, [{name, _, _} | _]} -> [name]
      _ -> []
    end
  end

  defp module_body(args) do
    case Enum.find(args, fn a -> is_do_pair(a) end) do
      {_, {"__block__", _, stmts}} -> stmts
      {_, single} -> [single]
      _ -> []
    end
  end

  defp is_do_pair(a) do
    case a do
      {"do", _} -> true
      _ -> false
    end
  end

  def main() do
    source = """
    defmodule Demo do
      def hello(name), do: name
      def add(a, b), do: a + b
      defp secret(), do: :hidden
    end
    """
    IO.puts("core version : #{core.version()}")
    IO.puts("functions    : #{inspect(function_names(source))}")
    IO.puts("diagnostics  : #{inspect(core.diagnostics("defmodule B do\ndef f(x) do receive(x) end\nend"))}")
    code = core.compile_snippet("[1, 2, 3] |> Enum.map(fn x -> x * x end)", ".")
    ns = %{}
    :builtins.exec(code, ns)
    IO.puts("snippet _    : #{inspect(Map.get(ns, "_"))}")
  end
end
