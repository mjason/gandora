defmodule App.Cli do
  @moduledoc "Cross-module calls, required macros, and destructuring in action."

  require App.Macros
  alias App.Mathy

  @doc "Destructuring in a function head: swaps a pair."
  @spec swap(tuple(term(), term())) :: tuple(term(), term())
  @example """
      gan> swap({1, 2})
      (2, 1)
  """
  def swap({a, b}), do: {b, a}

  @doc "Runs the chapter."
  @spec main() :: nil
  def main() do
    IO.puts("fact(10) = #{Mathy.fact(10)}")
    IO.puts("classify(-3) = #{Mathy.classify(-3)}")
    IO.puts("norm([3, 4]) = #{Mathy.norm([3, 4])}")
    picked = App.Macros.unless_nil(nil, :fallback)
    IO.puts("unless_nil(nil, :fallback) = #{picked}")
    {a, b} = swap({2, 1})
    [h | t] = [10, 20, 30]
    IO.puts("destructured: #{a} #{b} #{h} #{inspect(t)}")
    IO.puts("json: #{$json.dumps(%{lang: "gandora"}, indent: 0)}")
    IO.puts("sum_all([1, 2, 3, 4]) = #{App.Macros.sum_all([1, 2, 3, 4])}")
    App.Macros.with_timer("fact(200)", Mathy.fact(200))
    IO.puts("timer_result has #{$builtins.len(to_string(timer_result))} digits")
  end
end
