defmodule App.Mathy do
  @moduledoc "Math helpers showing patterns, interop, and documented examples."
  @moduledoc_trans zh_CN: "展示模式匹配、互操作与文档示例的数学工具。"

  @doc since: "0.1.0"
  @doc """
  Factorial via multi-clause dispatch. Prose lives in @doc and is
  translated; runnable examples live in @example, tested by `gan test`
  and shared by every locale.
  """
  @doc_trans zh_CN: """
  多子句分派实现的阶乘。散文写在 @doc 里并可翻译；可运行的示例写在
  @example 里，由 `gan test` 测试，并在所有语言中共享。
  """
  @example """
  ## Examples

      gan> fact(0)
      1
      gan> fact(10)
      3628800
  """
  @spec fact(integer()) :: integer()
  @allow :stack_recursion
  def fact(0), do: 1
  def fact(n) when n > 0, do: n * fact(n - 1)

  @doc "Sign of a number as an atom."
  @doc_trans zh_CN: "以原子返回数字的符号。"
  @example """
      gan> classify(-3)
      'negative'
      gan> [classify(0), classify(9)]
      ['zero', 'positive']
  """
  @spec classify(number()) :: atom()
  def classify(x) do
    cond do
      x < 0 -> :negative
      x == 0 -> :zero
      true -> :positive
    end
  end

  @doc deprecated: "Use norm/1 instead.", since: "0.1.0"
  @doc "Same as norm/1; kept for early adopters."
  @doc_trans zh_CN: "与 norm/1 相同；为早期用户保留。"
  @spec old_norm(list(number())) :: float()
  def old_norm(xs), do: norm(xs)

  @doc since: "0.1.0"
  @doc "Euclidean norm through a pipeline."
  @example """
      gan> norm([3, 4])
      5.0
  """
  @spec norm(list(number())) :: float()
  def norm(xs) do
    xs
    |> sum_squares()
    |> then_sqrt()
  end

  defp sum_squares(xs) do
    total = $functools.reduce(fn acc, x -> acc + x * x end, xs, 0)
    total
  end

  defp then_sqrt(x), do: $math.sqrt(x)
end
