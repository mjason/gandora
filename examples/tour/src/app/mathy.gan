defmodule App.Mathy do
  @moduledoc "Math helpers showing patterns, interop, and documented examples."
  @moduledoc_trans zh_CN: "展示模式匹配、互操作与文档示例的数学工具。"

  @doc """
  Factorial via multi-clause dispatch. Docs are Markdown; the shared
  `@example` block below is tested by `gan test` and shown in every
  locale — translations stay prose-only.
  """
  @doc_trans zh_CN: """
  多子句分派实现的阶乘。文档是 Markdown；下方共享的 `@example` 块由
  `gan test` 测试，并在所有语言中展示——翻译只需要写散文。
  """
  @example """
  ## Examples

      gan> fact(0)
      1
      gan> fact(10)
      3628800
  """
  def fact(0), do: 1
  def fact(n) when n > 0, do: n * fact(n - 1)

  @doc "Sign of a number as an atom."
  @doc_trans zh_CN: "以原子返回数字的符号。"
  @example """
      gan> classify(-3)
      'negative'
      gan> [classify(0), classify(9)]
      ['zero', 'positive']
  """
  def classify(x) do
    cond do
      x < 0 -> :negative
      x == 0 -> :zero
      true -> :positive
    end
  end

  @doc "Euclidean norm through a pipeline."
  @example """
      gan> norm([3, 4])
      5.0
  """
  def norm(xs) do
    xs
    |> sum_squares()
    |> then_sqrt()
  end

  defp sum_squares(xs) do
    total = :functools.reduce(fn acc, x -> acc + x * x end, xs, 0)
    total
  end

  defp then_sqrt(x), do: :math.sqrt(x)
end
