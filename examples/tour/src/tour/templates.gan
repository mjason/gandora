defmodule Tour.Templates do
  @moduledoc """
  GEP-0009: the ~<lang> embedded-language family with EEx-style
  <%= expr %> splices. Any sigil name is a language tag; bodies are raw
  (no \#{} — it collides with target-language syntax). Splices insert
  runtime values in every language, and compiled code in ~python.
  """

  @doc "A SQL query with a runtime value spliced in — ~sql is just a tag."
  @param min_units, "The cutoff spliced into the WHERE clause."
  @spec sales_query(number()) :: string()
  def sales_query(min_units) do
    ~sql"""
    SELECT product, SUM(units) AS total
    FROM sales
    WHERE units >= <%= min_units %>
    GROUP BY product
    """
  end

  @doc "A Markdown report — splices run any Gandora expression, pipes included."
  @param name, "The report owner, upcased in the heading."
  @param xs, "The sales figures."
  @spec report(string(), sequence(number())) :: string()
  def report(name, xs) do
    ~markdown"""
    # Sales report for <%= name.upper() %>

    | metric | value |
    | --- | --- |
    | count | <%= $builtins.len(xs) %> |
    | total | <%= xs |> $builtins.sum() %> |
    | best  | <%= $builtins.max(xs) %> |
    """
  end

  @doc "The evens of `xs`, at most `limit` of them — built by a ~python splice."
  @param xs, "The candidate numbers."
  @param limit, "How many evens to keep."
  @spec evens_capped(sequence(integer()), integer()) :: list(integer())
  @example """
      gan> evens_capped([1, 2, 3, 4, 5, 6, 7, 8], 3)
      [2, 4, 6]
  """
  def evens_capped(xs, limit) do
    # ~python splices are CODE: the compiled expression lands inside
    # the comprehension — Python-only syntax, Gandora bindings
    $python([x for x in <%= xs %> if x % 2 == 0][:<%= limit %>])
  end

  @doc "`<%%=` escapes the splice marker, so templates can document templates."
  @spec eex_docs() :: string()
  def eex_docs() do
    # <%%= escapes a literal marker, so templates can document templates
    ~markdown(Use <%%= expr %> to splice a value; this line shows it literally.)
  end

  @doc "Runs the chapter."
  @spec main() :: nil
  def main() do
    IO.puts(sales_query(10))
    IO.puts(report("gandora", [12, 30, 7, 45]))
    IO.puts("evens_capped = #{inspect(evens_capped([1, 2, 3, 4, 5, 6, 7, 8], 3))}")
    IO.puts(eex_docs())
  end
end
