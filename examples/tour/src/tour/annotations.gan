defmodule Tour.Annotations do
  @moduledoc """
  Wrapping a native Python decorator as an Elixir-style attribute — the
  same mechanism @doc itself uses (GEP-0008). `@cache 64` before a def
  applies functools.lru_cache(maxsize: 64); functions without the
  attribute pass through untouched.
  """

  defattr :cache

  defmacro on_def(kind, head, attrs, body) do
    case attrs do
      [{:cache, maxsize}] ->
        quote do
          @decorate $functools.lru_cache(maxsize: unquote(maxsize))
          def unquote(head) do
            unquote(body)
          end
        end
      [] ->
        quote do
          def unquote(head) do
            unquote(body)
          end
        end
    end
  end

  @on_definition Tour.Annotations.on_def

  @doc "Fibonacci — @cache 128 wraps it in functools.lru_cache via the hook."
  @param n, "Which Fibonacci number to compute."
  @spec fib(integer()) :: integer()
  @example """
      gan> fib(10)
      55
  """
  @cache 128
  @allow :stack_recursion
  def fib(n) do
    if n < 2 do
      n
    else
      fib(n - 1) + fib(n - 2)
    end
  end

  @doc "No annotation: the on_definition hook leaves it untouched."
  @param x, "Any number."
  @spec plain(number()) :: number()
  def plain(x), do: x + 1

  @doc "Runs the chapter."
  @spec main() :: nil
  def main() do
    IO.puts("fib(60) = #{fib(60)}")
    IO.puts("cache   = #{fib.cache_info()}")
    IO.puts("plain has no cache_info: #{inspect($builtins.hasattr(plain, "cache_info"))}")
  end
end
