defmodule Tour.Dsl do
  @moduledoc """
  GEP-0008 metaprogramming: declaration macros generate defs, `use`
  injects an API, and defattr + @on_definition build a route table —
  an annotation system in userland, the way @doc itself works.
  """

  defmacro __using__() do
    # a generated def can carry annotations too — they travel in the quote
    quote do
      @doc "Injected by `use Tour.Dsl` — proof the quote landed."
      @spec injected_greeting() :: string()
      def injected_greeting(), do: "hello from __using__"
    end
  end

  defmacro define_getter(name, value) do
    quote do
      def unquote(name)(), do: unquote(value)
    end
  end

  defattr :route, accumulate: true

  defmacro on_def(kind, head, attrs, body) do
    quote do
      def unquote(head) do
        unquote(body)
      end
    end
  end

  @on_definition Tour.Dsl.on_def

  use Tour.Dsl
  define_getter(:answer, 42)
  define_getter(:language, :gandora)

  @doc "The GET handler — its @route lands in the accumulated table."
  @spec list_users() :: list(atom())
  @example """
      gan> list_users()
      ['alice', 'bob']
  """
  @route {:get, "/users"}
  def list_users(), do: [:alice, :bob]

  @doc "The POST handler — same userland annotation, second entry."
  @spec create_user() :: atom()
  @route {:post, "/users"}
  def create_user(), do: :created

  @doc "Everything the userland annotation collected."
  @spec routes() :: list()
  def routes(), do: @route

  @doc "Runs the chapter."
  @spec main() :: nil
  def main() do
    IO.puts(injected_greeting())
    IO.puts("answer = #{answer()}, language = #{language()}")
    IO.puts("routes = #{inspect(routes())}")
    IO.puts("handlers = #{inspect([list_users(), create_user()])}")
  end
end
