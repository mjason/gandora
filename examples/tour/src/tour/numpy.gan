defmodule Tour.Numpy do
  @moduledoc """
  numpy: arrays, broadcasting through plain operators, and |> .method chains.
  Needs `uv sync` first, then: gan run src/tour/numpy.gan
  """

  pyimport numpy, as: np

  @doc "Euclidean norm of a vector — numpy scalars unwrap with $builtins.float."
  @param xs, "The vector components."
  @spec norm(sequence(number())) :: float()
  @example """
      gan> norm([3.0, 4.0])
      5.0
  """
  def norm(xs), do: $builtins.float(np.linalg.norm(np.array(xs)))

  @doc "numpy without wrappers: arrays, broadcasting, reductions."
  @spec demo() :: nil
  def demo() do
    a = np.array([1.0, 2.0, 3.0, 4.0])
    IO.puts("a            = #{a}")
    IO.puts("a * 10 + 1   = #{a * 10.0 + 1.0}")

    m =
      np.arange(12)
      |> .reshape(3, 4)
    IO.puts("reshape(3,4) =\n#{m}")
    IO.puts("row sums     = #{m.sum(axis: 1)}")
    IO.puts("col means    = #{m.mean(axis: 0)}")

    IO.puts("norm([3,4])  = #{norm([3.0, 4.0])}")

    # boolean indexing has no Gandora spelling; ~python says it directly
    evens = ~python(lambda arr: arr[arr % 2 == 0]).(m)
    IO.puts("evens        = #{evens}")

    stats =
      m
      |> .astype("float64")
      |> .std()
      |> .round(3)
    IO.puts("std          = #{stats}")
  end

  @doc "Runs the chapter."
  @spec main() :: nil
  def main(), do: demo()
end
