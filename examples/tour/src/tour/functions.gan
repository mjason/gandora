defmodule Tour.Functions do
  @moduledoc "Anonymous functions, captures, and data-first pipelines."

  # data-first wrappers make Python's function-first APIs pipe-friendly
  defp map_list(xs, f), do: :builtins.list(:builtins.map(f, xs))
  defp keep(xs, f), do: :builtins.list(:builtins.filter(f, xs))

  def demo() do
    double = fn x -> x * 2 end

    # fn with multiple clauses and a guard
    classify = fn
      0 -> :zero
      n when n > 0 -> :pos
      _ -> :neg
    end

    add = &(&1 + &2)        # capture with placeholders
    sqrt = &:math.sqrt/1    # capture a Python function by name/arity

    IO.puts("double.(21)  = #{double.(21)}")
    IO.puts("classify     = #{inspect([classify.(0), classify.(5), classify.(-5)])}")
    IO.puts("add.(40, 2)  = #{add.(40, 2)}")
    IO.puts("sqrt.(81.0)  = #{sqrt.(81.0)}")

    result =
      1..10
      |> :builtins.list()
      |> map_list(fn x -> x * x end)
      |> keep(fn x -> rem(x, 2) == 0 end)
      |> :builtins.sum()
    IO.puts("1..10 squared, evens only, summed = #{result}")
  end
end
