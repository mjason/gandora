defmodule String do
  @moduledoc """
  Data-first string functions over Python str (GEP-0010).

  Number formatting is Python's own format mini-language, called as a
  method on a string literal: `"{:.2f}".format(3.14159)` gives '3.14',
  `"{:>8}".format(x)` pads — no wrapper needed.
  """
  @moduledoc_trans zh_CN: "基于 Python str 的数据优先字符串函数(GEP-0010)。数字格式化直接用 Python 的 format 迷你语言:\"{:.2f}\".format(3.14159) 得 '3.14'。"

  @doc "Uppercases the string."
  @doc_trans zh_CN: "转为大写。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @spec upcase(string()) :: string()
  @example """
      gan> String.upcase("abc")
      'ABC'
  """
  def upcase(s), do: s.upper()

  @doc "Lowercases the string."
  @doc_trans zh_CN: "转为小写。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @spec downcase(string()) :: string()
  @example """
      gan> String.downcase("AbC")
      'abc'
  """
  def downcase(s), do: s.lower()

  @doc "Uppercases the first character, lowercases the rest."
  @doc_trans zh_CN: "首字符大写，其余小写。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @spec capitalize(string()) :: string()
  @example """
      gan> String.capitalize("heLLo")
      'Hello'
  """
  def capitalize(s), do: s.capitalize()

  @doc "Splits on whitespace runs, dropping empty parts (Elixir semantics)."
  @doc_trans zh_CN: "按连续空白切分并丢弃空段（Elixir 语义）。"
  @example """
      gan> String.split("  a  b c ")
      ['a', 'b', 'c']
  """
  @param s, "Split on runs of whitespace."
  @param_trans s, zh_CN: "按连续空白切分的字符串。"
  @spec split(string()) :: list(string())
  def split(s), do: s.split()

  @doc "Splits on the separator `sep`."
  @doc_trans zh_CN: "按分隔符 `sep` 切分。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @param sep, "The separator to split on."
  @param_trans sep, zh_CN: "切分用的分隔串。"
  @spec split_on(string(), string()) :: list(string())
  @example """
      gan> String.split_on("a,b,c", ",")
      ['a', 'b', 'c']
  """
  def split_on(s, sep), do: s.split(sep)

  @doc "Removes leading and trailing whitespace."
  @doc_trans zh_CN: "去除首尾空白。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @spec trim(string()) :: string()
  @example """
      gan> String.trim("  x  ")
      'x'
  """
  def trim(s), do: s.strip()

  @doc "Replaces every occurrence of `pattern` with `replacement`."
  @doc_trans zh_CN: "将每处 `pattern` 替换为 `replacement`。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @param pattern, "The substring to find."
  @param_trans pattern, zh_CN: "要查找的子串。"
  @param replacement, "Substituted for every occurrence."
  @param_trans replacement, zh_CN: "替换每处出现的内容。"
  @spec replace(string(), string(), string()) :: string()
  @example """
      gan> String.replace("a-b-a", "a", "x")
      'x-b-x'
  """
  def replace(s, pattern, replacement), do: s.replace(pattern, replacement)

  @doc "Whether the string contains `part`."
  @doc_trans zh_CN: "是否包含子串 `part`。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @param part, "The substring to look for."
  @param_trans part, zh_CN: "要查找的子串。"
  @spec contains?(string(), string()) :: boolean()
  @example """
      gan> String.contains?("hello", "ell")
      True
  """
  def contains?(s, part), do: $python(<%= part %> in <%= s %>)

  @doc "Whether the string starts with `prefix`."
  @doc_trans zh_CN: "是否以 `prefix` 开头。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @param prefix, "The candidate prefix."
  @param_trans prefix, zh_CN: "候选前缀。"
  @spec starts_with?(string(), string()) :: boolean()
  @example """
      gan> String.starts_with?("file.gan", "file")
      True
  """
  def starts_with?(s, prefix), do: s.startswith(prefix)

  @doc "Whether the string ends with `suffix`."
  @doc_trans zh_CN: "是否以 `suffix` 结尾。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @param suffix, "The candidate suffix."
  @param_trans suffix, zh_CN: "候选后缀。"
  @spec ends_with?(string(), string()) :: boolean()
  @example """
      gan> String.ends_with?("file.gan", ".gan")
      True
  """
  def ends_with?(s, suffix), do: s.endswith(suffix)

  @doc "The number of characters (Unicode code points, Python `len`)."
  @doc_trans zh_CN: "字符数（Unicode 码点，即 Python 的 `len`）。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @spec length(string()) :: integer()
  @example """
      gan> String.length("héllo")
      5
  """
  def length(s), do: $builtins.len(s)

  @doc "The substring of `len` characters starting at `start` (negative start counts from the end)."
  @doc_trans zh_CN: "自 `start` 起、长 `len` 的子串（负的 start 从尾部数起）。"
  @example """
      gan> String.slice("gandora", 3, 4)
      'dora'
  """
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @param start, "Zero-based start position."
  @param_trans start, zh_CN: "起始下标（从 0 起）。"
  @param len, "Maximum number of characters."
  @param_trans len, zh_CN: "最多取出的字符数。"
  @spec slice(string(), integer(), integer()) :: string()
  def slice(s, start, len), do: $python(<%= s %>[<%= start %>:] [:<%= len %>])

  @doc "Pads on the left with spaces to `width`."
  @doc_trans zh_CN: "左侧以空格填充至 `width`。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @param width, "The minimum total width."
  @param_trans width, zh_CN: "目标最小总宽度。"
  @spec pad_leading(string(), integer()) :: string()
  @example """
      gan> String.pad_leading("5", 3)
      '  5'
  """
  def pad_leading(s, width), do: s.rjust(width)

  @doc "Pads on the right with spaces to `width`."
  @doc_trans zh_CN: "右侧以空格填充至 `width`。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @param width, "The minimum total width."
  @param_trans width, zh_CN: "目标最小总宽度。"
  @spec pad_trailing(string(), integer()) :: string()
  @example """
      gan> String.pad_trailing("5", 3)
      '5  '
  """
  def pad_trailing(s, width), do: s.ljust(width)

  @doc "Parses an integer; raises Python ValueError on bad input."
  @doc_trans zh_CN: "解析整数；非法输入抛 Python ValueError。"
  @param s, "The decimal digits to parse."
  @param_trans s, zh_CN: "要解析的十进制数字串。"
  @spec to_integer(string()) :: integer()
  @example """
      gan> String.to_integer("42")
      42
  """
  def to_integer(s), do: $builtins.int(s)

  @doc "Parses a float; raises Python ValueError on bad input."
  @doc_trans zh_CN: "解析浮点数；非法输入抛 Python ValueError。"
  @param s, "The number literal to parse."
  @param_trans s, zh_CN: "要解析的数字字面串。"
  @spec to_float(string()) :: float()
  @example """
      gan> String.to_float("2.5")
      2.5
  """
  def to_float(s), do: $builtins.float(s)
  @doc "The character at `index` (negative counts from the end), or nil."
  @doc_trans zh_CN: "位于 `index` 的字符（负数从尾部数起），越界为 nil。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @param index, "Zero-based; negative counts from the end."
  @param_trans index, zh_CN: "从 0 开始；负数自末尾计。"
  @spec at(string(), integer()) :: string() | nil
  @example """
      gan> String.at("abc", 1)
      'b'
  """
  def at(s, index) do
    if index < $builtins.len(s) and index >= -$builtins.len(s) do
      $python(<%= s %>[<%= index %>])
    else
      nil
    end
  end

  @doc "The first character, or nil for the empty string."
  @doc_trans zh_CN: "第一个字符;空串为 nil。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @spec first(string()) :: string() | nil
  @example """
      gan> String.first("ant")
      'a'
      gan> String.first("")
  """
  def first(s), do: at(s, 0)

  @doc "The last character, or nil for the empty string."
  @doc_trans zh_CN: "最后一个字符;空串为 nil。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @spec last(string()) :: string() | nil
  @example """
      gan> String.last("ant")
      't'
  """
  def last(s), do: at(s, -1)

  @doc "The string reversed."
  @doc_trans zh_CN: "反转后的字符串。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @spec reverse(string()) :: string()
  @example """
      gan> String.reverse("abc")
      'cba'
  """
  def reverse(s), do: $python(<%= s %>[::-1])

  @doc "The string repeated `n` times."
  @doc_trans zh_CN: "重复 `n` 次的字符串。"
  @param s, "The string to repeat."
  @param_trans s, zh_CN: "要重复的字符串。"
  @param n, "How many times."
  @param_trans n, zh_CN: "重复次数。"
  @spec duplicate(string(), integer()) :: string()
  @example """
      gan> String.duplicate("ab", 2)
      'abab'
  """
  def duplicate(s, n), do: $python(<%= s %> * <%= n %>)

  @doc "Removes leading whitespace."
  @doc_trans zh_CN: "去除首部空白。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @spec trim_leading(string()) :: string()
  @example """
      gan> String.trim_leading("  x")
      'x'
  """
  def trim_leading(s), do: s.lstrip()

  @doc "Removes trailing whitespace."
  @doc_trans zh_CN: "去除尾部空白。"
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @spec trim_trailing(string()) :: string()
  @example """
      gan> String.trim_trailing("x  ")
      'x'
  """
  def trim_trailing(s), do: s.rstrip()

  @doc "The characters as a list of one-character strings."
  @doc_trans zh_CN: "以单字符字符串列表表示的全部字符。"
  @example """
      gan> String.codepoints("héllo") |> Enum.take(2)
      ['h', 'é']
  """
  @param s, "The string."
  @param_trans s, zh_CN: "字符串。"
  @spec codepoints(string()) :: list(string())
  def codepoints(s), do: $builtins.list(s)

  @doc "Whether the compiled regex (`~r/.../`) matches anywhere in the string."
  @doc_trans zh_CN: "编译后的正则（`~r/.../`）是否在字符串中命中。"
  @example """
      gan> String.match?("gandora-2026", ~r/\\d+/)
      True
  """
  @param s, "The string to test."
  @param_trans s, zh_CN: "被检验的字符串。"
  @param regex, "A compiled pattern, e.g. from ~r//."
  @param_trans regex, zh_CN: "编译后的正则，如 ~r// 的结果。"
  @spec match?(string(), $re.Pattern) :: boolean()
  def match?(s, regex), do: not is_nil(regex.search(s))
end
