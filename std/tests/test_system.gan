defmodule TestSystem do
  @moduledoc "System, exhaustively: cmd verdicts and options, environment, executables."
  @moduledoc_trans zh_CN: "System 全函数测试:cmd 裁决与选项、环境变量、可执行文件查找。"

  import Test

  def test_cmd_captures_stdout(), do: Test.assert_eq(System.cmd("echo", ["hi"]), {"hi\n", 0})
  def test_cmd_exit_status(), do: Test.assert_eq(elem(System.cmd("sh", ["-c", "exit 3"]), 1), 3)
  def test_cmd_cd(), do: Test.assert_eq(System.cmd("pwd", [], [cd: "/"]), {"/\n", 0})

  def test_cmd_stderr_separate_by_default() do
    {out, status} = System.cmd("sh", ["-c", "echo visible; echo hidden 1>&2"], [stderr_to_stdout: false])
    Test.assert_eq({out, status}, {"visible\n", 0})
  end

  def test_cmd_stderr_merged() do
    {out, _status} = System.cmd("sh", ["-c", "echo oops 1>&2"], [stderr_to_stdout: true])
    Test.assert_eq(out, "oops\n")
  end

  def test_cmd_timeout_raises() do
    msg = Test.assert_raise($subprocess.TimeoutExpired, fn ->
      System.cmd("sleep", ["5"], [timeout: 100])
    end)
    Test.assert_contains(msg, "sleep")
  end

  def test_get_env_set(), do: Test.assert_false(is_nil(System.get_env("PATH")))
  def test_get_env_unset_is_nil(), do: Test.assert_true(is_nil(System.get_env("GAN_STD_SURELY_UNSET")))
  def test_get_env_default(), do: Test.assert_eq(System.get_env("GAN_STD_SURELY_UNSET", "d"), "d")
  def test_find_executable(), do: Test.assert_true(String.contains?(System.find_executable("sh"), "sh"))
  def test_find_executable_missing(), do: Test.assert_true(is_nil(System.find_executable("gan-no-such-tool")))
  def test_argv_is_list(), do: Test.assert_true(is_list(System.argv()))
end
