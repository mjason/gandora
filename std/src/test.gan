defmodule Test do
  @moduledoc """
  The official test assertions (GEP-0024): write `tests/*.gan` modules
  whose `test_*` functions call these — `gan test` compiles them and
  runs pytest underneath. A failure raises; pytest reports it.
  """

  @doc "Fails unless `got == want`, naming both sides."
  @doc_trans zh_CN: "断言相等,失败时同时报出期望值与实际值。"
  @param got, "The actual value."
  @param_trans got, zh_CN: "实际值。"
  @param want, "The expected value."
  @param_trans want, zh_CN: "期望值。"
  @spec assert_eq(term(), term()) :: nil
  @example """
      gan> Test.assert_eq(1 + 1, 2)
  """
  def assert_eq(got, want) do
    if got != want do
      raise "expected #{inspect(want)}, got #{inspect(got)}"
    end
    nil
  end

  @doc "Fails unless the value is exactly `true`."
  @doc_trans zh_CN: "断言值恰为 true。"
  @param value, "The boolean under test."
  @param_trans value, zh_CN: "被检验的布尔值。"
  @spec assert_true(term()) :: nil
  @example """
      gan> Test.assert_true(2 > 1)
  """
  def assert_true(value) do
    assert_eq(value, true)
  end

  @doc "Fails unless the value is exactly `false`."
  @doc_trans zh_CN: "断言值恰为 false。"
  @param value, "The boolean under test."
  @param_trans value, zh_CN: "被检验的布尔值。"
  @spec assert_false(term()) :: nil
  @example """
      gan> Test.assert_false(1 > 2)
  """
  def assert_false(value) do
    assert_eq(value, false)
  end

  @doc "Fails unless the value is `nil`."
  @doc_trans zh_CN: "断言值为 nil。"
  @param value, "The value under test."
  @param_trans value, zh_CN: "被检验的值。"
  @spec assert_nil(term()) :: nil
  @example """
      gan> Test.assert_nil(Map.get(%{}, "missing"))
  """
  def assert_nil(value) do
    if not is_nil(value) do
      raise "expected nil, got #{inspect(value)}"
    end
    nil
  end

  @doc "Runs `f` and fails unless it raises; returns the message."
  @doc_trans zh_CN: "断言零元函数会抛异常,返回异常消息。"
  @param f, "A zero-arity function expected to raise."
  @param_trans f, zh_CN: "预期抛异常的零元函数。"
  @spec assert_raises(fun()) :: string()
  def assert_raises(f) do
    outcome = try do
      f.()
      :no_raise
    rescue
      e in $builtins.Exception -> {:raised, to_string(e)}
    end
    case outcome do
      :no_raise -> raise "expected a raise, got none"
      {:raised, msg} -> msg
    end
  end

  @doc "Fails unless `haystack` contains `needle` (string or list)."
  @doc_trans zh_CN: "断言字符串或列表包含给定元素。"
  @param haystack, "The string or list searched."
  @param_trans haystack, zh_CN: "被搜索的字符串或列表。"
  @param needle, "What must be present."
  @param_trans needle, zh_CN: "必须存在的内容。"
  @spec assert_contains(term(), term()) :: nil
  @example """
      gan> Test.assert_contains([1, 2, 3], 2)
  """
  def assert_contains(haystack, needle) do
    found = if is_binary(haystack) do
      String.contains?(haystack, needle)
    else
      Enum.member?(haystack, needle)
    end
    if not found do
      raise "expected #{inspect(haystack)} to contain #{inspect(needle)}"
    end
    nil
  end

  # ---- ExUnit-style surface (GEP-0024 rev 2) -------------------------------

  defmacro __using__() do
    quote do
      require Test
      import Test
    end
  end

  # `test "name" do ... end` — defines `test_<slug>` for pytest discovery, the ExUnit spelling.
  defmacro test(name, body) do
    fname = to_atom("test_" <> slug(name))
    quote do
      def unquote(fname)(), unquote(body)
    end
  end

  # `describe "prefix" do ... end` — prefixes every inner `test` name, ExUnit-style grouping.
  defmacro describe(prefix, body) do
    {:"do", block} = body
    stmts = case block do
      {:__block__, _meta, inner} -> inner
      single -> [single]
    end
    rewritten = prefix_tests(stmts, prefix)
    quote do
      unquote_splicing(rewritten)
    end
  end

  defmacro prefix_tests(stmts, prefix) do
    case stmts do
      [] -> []
      [{:test, _m, [n, b]} | rest] ->
        renamed = prefix <> ": " <> n
        one = quote do
          test(unquote(renamed), unquote(b))
        end
        [one] ++ prefix_tests(rest, prefix)
      [other | rest] ->
        [other] ++ prefix_tests(rest, prefix)
    end
  end

  # `assert expr` — on comparison expressions the failure names both sides (`assert a == b` reports left and right); anything else is a truthiness assertion.
  defmacro assert(expr) do
    case expr do
      {:"==", _m, [l, r]} -> quote do
        Test.assert_op("==", unquote(l), unquote(r))
      end
      {:"!=", _m, [l, r]} -> quote do
        Test.assert_op("!=", unquote(l), unquote(r))
      end
      {:"<", _m, [l, r]} -> quote do
        Test.assert_op("<", unquote(l), unquote(r))
      end
      {:">", _m, [l, r]} -> quote do
        Test.assert_op(">", unquote(l), unquote(r))
      end
      {:"<=", _m, [l, r]} -> quote do
        Test.assert_op("<=", unquote(l), unquote(r))
      end
      {:">=", _m, [l, r]} -> quote do
        Test.assert_op(">=", unquote(l), unquote(r))
      end
      {:in, _m, [l, r]} -> quote do
        Test.assert_op("in", unquote(l), unquote(r))
      end
      _other -> quote do
        Test.assert_truthy(unquote(expr))
      end
    end
  end

  @doc "`refute expr` — the assertion that the expression is falsy."
  defmacro refute(expr) do
    case expr do
      {:"==", _m, [l, r]} -> quote do
        Test.assert_op("!=", unquote(l), unquote(r))
      end
      {:in, _m, [l, r]} -> quote do
        Test.refute_in(unquote(l), unquote(r))
      end
      _other -> quote do
        Test.refute_truthy(unquote(expr))
      end
    end
  end

  # ---- runtime backing for the macros (hidden from docs) -------------------

  @doc false
  @spec assert_op(string(), term(), term()) :: nil
  def assert_op(op, l, r) do
    held = case op do
      "==" -> l == r
      "!=" -> l != r
      "<" -> l < r
      ">" -> l > r
      "<=" -> l <= r
      ">=" -> l >= r
      "in" -> Enum.member?(r, l)
      _ -> raise "unknown assert op #{op}"
    end
    if not held do
      raise "Assertion failed: left #{op} right\nleft:  #{inspect(l)}\nright: #{inspect(r)}"
    end
    nil
  end

  @doc false
  @spec assert_truthy(term()) :: nil
  def assert_truthy(value) do
    if not value do
      raise "Assertion failed: expected truthy, got #{inspect(value)}"
    end
    nil
  end

  @doc false
  @spec refute_truthy(term()) :: nil
  def refute_truthy(value) do
    if value do
      raise "Refute failed: expected falsy, got #{inspect(value)}"
    end
    nil
  end

  @doc false
  @spec refute_in(term(), term()) :: nil
  def refute_in(l, r) do
    if Enum.member?(r, l) do
      raise "Refute failed: #{inspect(l)} is in #{inspect(r)}"
    end
    nil
  end

  @doc "Fails unless `f` raises an instance of `type` (ExUnit assert_raise/2)."
  @param type, "The exception class, e.g. $builtins.ValueError."
  @param f, "A zero-arity function expected to raise it."
  @spec assert_raise(term(), fun()) :: string()
  def assert_raise(type, f) do
    outcome = try do
      f.()
      :no_raise
    rescue
      e ->
        if $builtins.isinstance(e, type) do
          {:raised, to_string(e)}
        else
          {:wrong, $builtins.type(e).__name__}
        end
    end
    case outcome do
      :no_raise -> raise "expected #{inspect(type)} to be raised, got none"
      {:wrong, got} -> raise "expected #{inspect(type)}, got #{got}"
      {:raised, msg} -> msg
    end
  end

  @doc "Fails unless `abs(a - b) <= delta` (ExUnit assert_in_delta/3)."
  @param a, "One value."
  @param b, "The other value."
  @param delta, "The allowed absolute difference."
  @spec assert_in_delta(number(), number(), number()) :: nil
  @example """
      gan> Test.assert_in_delta(3.14159, 3.14, 0.01)
  """
  def assert_in_delta(a, b, delta) do
    if $builtins.abs(a - b) > delta do
      raise "expected #{inspect(a)} and #{inspect(b)} to be within #{inspect(delta)}"
    end
    nil
  end

  @doc "Fails immediately with the given message (ExUnit flunk/1)."
  @param message, "Why the test fails."
  @spec flunk(string()) :: nil
  def flunk(message) do
    raise message
  end
end
